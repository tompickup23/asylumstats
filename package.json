{
  "name": "asylumstats",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/build/sync-live.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "precheck": "node scripts/build/sync-live.mjs",
    "check": "astro check",
    "fetch:lancashirecc": "node scripts/fetch/fetch-lancashire-cc.mjs",
    "transform:lancashirecc": "node scripts/transform/transform-lancashire-cc.mjs",
    "ingest:lancashirecc": "npm run fetch:lancashirecc && npm run transform:lancashirecc",
    "fetch:routes": "node scripts/fetch/fetch-routes.mjs",
    "transform:routes": "node scripts/transform/transform-routes.mjs",
    "ingest:routes": "npm run fetch:routes && npm run transform:routes",
    "fetch:tribunals": "node scripts/fetch/fetch-tribunals.mjs",
    "transform:tribunals": "node scripts/transform/transform-tribunals.mjs",
    "ingest:tribunals": "npm run fetch:tribunals && npm run transform:tribunals",
    "fetch:smallboats": "node scripts/fetch/fetch-small-boats.mjs",
    "transform:smallboats": "node scripts/transform/transform-small-boats.mjs",
    "ingest:smallboats": "npm run fetch:smallboats && npm run transform:smallboats",
    "fetch:annualreport": "node scripts/fetch/fetch-annual-report.mjs",
    "ingest:annualreport": "npm run fetch:annualreport",
    "fetch:bordersecurity": "node scripts/fetch/fetch-border-security.mjs",
    "transform:bordersecurity": "node scripts/transform/transform-border-security.mjs",
    "ingest:bordersecurity": "npm run fetch:bordersecurity && npm run transform:bordersecurity",
    "transform:asylumfinance": "node scripts/transform/transform-asylum-finance.mjs",
    "transform:asylumfinance:check": "node scripts/transform/transform-asylum-finance.mjs --check",
    "fetch:regionalsources": "node scripts/fetch/fetch-regional-sources.mjs",
    "transform:regionalsources": "node scripts/transform/transform-regional-sources.mjs",
    "ingest:regionalsources": "npm run fetch:regionalsources && npm run transform:regionalsources",
    "fetch:hotels": "node scripts/fetch/fetch-hotel-archive-leads.mjs",
    "transform:hotels": "node scripts/transform/transform-hotel-entities.mjs",
    "ingest:hotels": "npm run fetch:hotels && npm run transform:hotels",
    "transform:money": "node scripts/transform/transform-money-ledger.mjs",
    "fetch:hospend": "node scripts/fetch/fetch-ho-spend.mjs",
    "transform:hospend": "node scripts/transform/transform-ho-spend.mjs",
    "transform:hospend:check": "node scripts/transform/transform-ho-spend.mjs --check",
    "ingest:hospend": "npm run fetch:hospend && npm run transform:hospend",
    "audit:coverage": "node scripts/audit/area-coverage.mjs",
    "audit:coverage:check": "node scripts/audit/area-coverage.mjs --check",
    "audit:freshness": "node scripts/audit/source-freshness.mjs",
    "audit:links": "node scripts/audit/source-links.mjs",
    "audit:links:strict": "node scripts/audit/source-links.mjs --strict",
    "audit:model-io": "node scripts/audit/model-io-graph.mjs",
    "sync:live": "node scripts/build/sync-live.mjs",
    "sync:live:check": "node scripts/build/sync-live.mjs --check",
    "ingest:money": "npm run transform:money",
    "pretest": "node scripts/build/sync-live.mjs",
    "test": "vitest run",
    "test:mobile": "playwright test tests/mobile-layout.spec.ts --project=mobile-chromium",
    "test:desktop": "playwright test tests/desktop-layout.spec.ts --project=desktop-chromium",
    "test:watch": "vitest",
    "audit:projections": "node scripts/audit/projection-integrity.mjs",
    "audit:projections:check": "node scripts/audit/projection-integrity.mjs --check"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^7.1.1",
    "satori": "^0.26.0",
    "sharp": "^0.34.5",
    "svgo": "^4.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.3.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
