---
interface Props {
  updated: string;
  nextUpdate?: string;
  source: string;
  sourceUrl?: string;
  /** Set false on a page where the corrections link would be redundant, e.g. /corrections/. */
  showCorrections?: boolean;
}

const { updated, nextUpdate, source, sourceUrl, showCorrections = true } = Astro.props;

function formatDate(iso: string): string {
  const d = new Date(iso);
  return d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
}

function daysAgo(iso: string): number {
  return Math.floor((Date.now() - new Date(iso).getTime()) / 86400000);
}

const age = daysAgo(updated);
const freshness = age <= 30 ? "fresh" : age <= 90 ? "recent" : age <= 180 ? "aging" : "stale";
---

<span class={`freshness-badge freshness-${freshness}`}>
  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
  <span>Updated {formatDate(updated)}</span>
  {nextUpdate && <span class="freshness-next"> · Next: {formatDate(nextUpdate)}</span>}
  <span class="freshness-sep"> · </span>
  {sourceUrl ? (
    <a href={sourceUrl} target="_blank" rel="noopener" class="freshness-source">{source}</a>
  ) : (
    <span class="freshness-source">{source}</span>
  )}
  {/*
    The corrections log belongs next to the freshness claim, not only in the footer.
    Migration Observatory and the Commons Library rank on institutional trust; a public
    record of every figure this site has had to correct is the nearest thing an
    independent publisher has to that, and it was reachable only from the footer and the
    methodology page. Putting it where the data provenance is asserted is the point.
  */}
  {showCorrections && (
    <>
      <span class="freshness-sep"> · </span>
      <a href="/corrections/" class="freshness-source freshness-corrections">Corrections log</a>
    </>
  )}
</span>

<style>
  .freshness-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    color: var(--text-muted);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-subtle);
    white-space: nowrap;
    flex-wrap: wrap;
  }
  .freshness-fresh { border-color: color-mix(in srgb, var(--positive) 30%, transparent); color: var(--positive); }
  .freshness-fresh svg { stroke: var(--positive); }
  .freshness-recent { border-color: color-mix(in srgb, var(--accent) 30%, transparent); color: var(--accent); }
  .freshness-recent svg { stroke: var(--accent); }
  .freshness-aging { border-color: color-mix(in srgb, var(--warning) 30%, transparent); color: var(--warning); }
  .freshness-aging svg { stroke: var(--warning); }
  .freshness-stale { border-color: color-mix(in srgb, var(--critical) 30%, transparent); color: var(--critical); }
  .freshness-stale svg { stroke: var(--critical); }
  .freshness-next { opacity: 0.7; }
  .freshness-sep { opacity: 0.4; }
  .freshness-source {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 30%, transparent);
    text-underline-offset: 2px;
  }
  a.freshness-source:hover { color: var(--text); }
  @media (max-width: 640px) {
    .freshness-badge { font-size: 0.78rem; }
    .freshness-next { display: none; }
  }
</style>
