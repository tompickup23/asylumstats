---
/**
 * The questions a page answers, each as a heading with its answer directly beneath.
 *
 * This is the structure a featured snippet is extracted from, and content that wins
 * featured snippets is markedly more likely to be cited in an AI Overview, so it is one
 * piece of work for two channels. There is deliberately no FAQPage markup: Google
 * restricted FAQ rich results to government and health sites in August 2023 and stopped
 * showing them entirely on 7 May 2026. The county pages still carry the markup they had,
 * which is harmless and still parsed for understanding, but it displays nothing and there
 * is no reason to add more. The gain is the wording and the shape of the page.
 *
 * Each question is an h2 so it stands as its own topic rather than as a subsection of a
 * "common questions" block, and each answer leads with the answer in its first sentence.
 * Keep answers to roughly 40-60 words: long enough to stand alone when lifted out of the
 * page, short enough to be lifted whole.
 */
interface Props {
  items: Array<{ question: string; answer: string }>;
  /** Screen-reader label for the region, since the questions are the visible headings. */
  label: string;
  /** Anchor id, so the section can be linked from a page's contents nav. */
  id?: string;
}

const { items, label, id } = Astro.props;
---

{items.length > 0 && (
  <section id={id} class="section shell asked section-anchor" aria-label={label}>
    {items.map((item) => (
      <article class="asked-item">
        <h2 class="asked-q">{item.question}</h2>
        <p class="asked-a">{item.answer}</p>
      </article>
    ))}
  </section>
)}

<style>
  .asked {
    display: grid;
    gap: 1.5rem;
  }

  .asked-item {
    border-top: 1px solid var(--rule, rgba(0, 0, 0, 0.1));
    padding-top: 1.1rem;
  }

  .asked-q {
    font-size: clamp(1.05rem, 2.4vw, 1.3rem);
    line-height: 1.3;
    margin: 0 0 0.5rem;
  }

  .asked-a {
    margin: 0;
    max-width: 62ch;
    line-height: 1.6;
  }
</style>
