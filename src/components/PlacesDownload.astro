---
// The CSV download block on /places/, with its source and licence line.
import { ROUTES_RELEASE_DATE } from "../lib/data-releases";
import { HOME_OFFICE_LOCAL_AUTHORITY_SOURCE, LOCAL_AUTHORITY_CSV_PATH } from "../lib/datasets";
import { formatFindingDate } from "../lib/finding-dates";

interface Props {
  snapshotLabel: string;
}
const { snapshotLabel } = Astro.props;
const datasetReleaseLabel = ROUTES_RELEASE_DATE ? formatFindingDate(ROUTES_RELEASE_DATE) : null;
---

<section id="download" class="section section-anchor places-download">
  <div class="section-head">
    <div>
      <h2>Download the data</h2>
    </div>
    <a class="places-button" href={LOCAL_AUTHORITY_CSV_PATH} download>Download CSV</a>
  </div>
  <p class="lede">
    People on asylum support in every local authority at {snapshotLabel}: one row per
    authority, with the type of accommodation, population and a rate per 10,000 residents.
  </p>
  <p class="tiny">
    Source: Home Office,{" "}
    <a href={HOME_OFFICE_LOCAL_AUTHORITY_SOURCE.url} rel="noreferrer">{HOME_OFFICE_LOCAL_AUTHORITY_SOURCE.name}</a>
    {datasetReleaseLabel && <>, published {datasetReleaseLabel}</>}. Contains public sector information
    licensed under the{" "}
    <a href="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/" rel="noreferrer">Open Government Licence v3.0</a>.
    The rate is calculated here from the two published columns.
  </p>
</section>

<style>
  .places-button {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 1.1rem;
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--accent);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
  }

  .places-button:hover,
  .places-button:focus-visible {
    background: var(--accent-wash);
  }

  .places-download .lede {
    max-width: 65ch;
  }
</style>
