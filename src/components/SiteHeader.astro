---
type NavItem = { href: string; label: string; desc: string };
type NavGroup = { label: string; items: NavItem[] };

// No True Cost figure here any more. This description sits on every page, and it used
// to read "£8.1B True Cost breakdown", which was both a fifth conflicting figure and a
// promise /spending/ does not keep: that page is an 11-row starter ledger with no True
// Cost content. The breakdown is the finding, and the homepage tile links to it.
const NAV_GROUPS: NavGroup[] = [
  {
    label: "Explore",
    items: [
      { href: "/places", label: "Places", desc: "Every UK local authority" },
      { href: "/national", label: "National", desc: "UK-wide totals" },
      { href: "/regional", label: "Regional", desc: "9 English regions + nations" },
      // /councils is not linked here on purpose. It is noIndex research infrastructure
      // that describes itself as "context only", and its headline £3.6bn is Lancashire
      // County Council's entire spend corpus rather than asylum spend. Putting it in the
      // primary nav pointed all 478 pages at it and invited that figure to be read as an
      // asylum number. The page still resolves at its URL for anyone working with it.
    ],
  },
  {
    label: "Money Trail",
    items: [
      { href: "/spending", label: "Spending", desc: "Contracts, suppliers, public money rows" },
      { href: "/entities", label: "Entities", desc: "Suppliers & contractors" },
      { href: "/routes", label: "Routes", desc: "Small-boat & resettlement" },
      { href: "/compare", label: "Compare", desc: "Side-by-side any place" },
    ],
  },
  {
    label: "Research",
    items: [
      { href: "/findings", label: "Findings", desc: "Published investigations" },
      { href: "/releases", label: "Releases", desc: "Version history" },
    ],
  },
  {
    label: "About",
    items: [
      { href: "/methodology", label: "Methodology", desc: "How we follow the money" },
      { href: "/sources", label: "Sources", desc: "Data provenance" },
      { href: "/glossary", label: "Glossary", desc: "Terms & definitions" },
    ],
  },
];

const pathname = Astro.url.pathname;

function isActiveItem(href: string): boolean {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(`${href}/`);
}
function isActiveGroup(group: NavGroup): boolean {
  return group.items.some((item) => isActiveItem(item.href));
}
---

<header class="site-header">
  <div class="site-header-inner shell">
  <a class="brand" href="/">
    {/*
      Two columns, one taller. The estate mark, drawn on the same 64 unit grid as the
      other four sites. It replaces a radar scanner whose own brand guide called it
      "actively monitoring data points" with "orange blips = alerts": a surveillance and
      alarm metaphor on a site publishing official statistics about people seeking
      asylum, which is the one place that reading costs the most. Two columns say only
      that one number is bigger than another.
    */}
    <span class="brand-mark">
      <svg viewBox="0 0 64 64" width="30" height="30" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="17" y="14" width="13" height="36" rx="2" fill="var(--accent)"/>
        <rect x="34" y="27" width="13" height="23" rx="2" fill="var(--accent-bright)"/>
      </svg>
    </span>
    <span class="brand-copy">
      <span>asylumstats</span>
      <small>Follow the money</small>
    </span>
  </a>

  <div class="site-tools">
    <nav class="site-nav-mega desktop-nav" aria-label="Primary">
      {NAV_GROUPS.map((group) => (
        <details class="mega-group" data-active={isActiveGroup(group) ? "true" : "false"}>
          <summary class="mega-trigger">
            <span>{group.label}</span>
            <span class="mega-caret" aria-hidden="true">
              <svg viewBox="0 0 10 6" width="10" height="6" fill="none">
                <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </summary>
          <div class="mega-panel" role="menu">
            {group.items.map((item) => (
              <a
                href={item.href}
                class="mega-item"
                role="menuitem"
                aria-current={isActiveItem(item.href) ? "page" : undefined}
              >
                <span class="mega-item-label">{item.label}</span>
                <span class="mega-item-desc">{item.desc}</span>
              </a>
            ))}
          </div>
        </details>
      ))}
    </nav>

    <button
      class="search-launch"
      type="button"
      data-site-search-open
      aria-haspopup="dialog"
      aria-controls="site-search-panel"
    >
      <span>Search</span>
      <span class="search-shortcut">/</span>
    </button>

    <button class="mobile-menu-btn" type="button" data-mobile-menu-toggle aria-label="Open menu" aria-expanded="false">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </div>
  </div>
</header>

<div class="mobile-drawer" data-mobile-drawer hidden>
  <div class="mobile-drawer-backdrop" data-mobile-drawer-close></div>
  <nav class="mobile-drawer-panel" aria-label="Mobile navigation">
    <div class="mobile-drawer-head">
      <span class="mobile-drawer-title">Menu</span>
      <button type="button" class="mobile-drawer-close" data-mobile-drawer-close aria-label="Close menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="mobile-drawer-body">
      <a href="/" class={"mobile-drawer-home" + (pathname === "/" ? " active" : "")}>Home</a>
      {NAV_GROUPS.map((group) => (
        <details class="mobile-group" open={isActiveGroup(group)}>
          <summary class="mobile-group-trigger">
            <span>{group.label}</span>
            <span class="mobile-group-caret" aria-hidden="true">
              <svg viewBox="0 0 10 6" width="10" height="6" fill="none">
                <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </summary>
          <div class="mobile-group-items">
            {group.items.map((item) => (
              <a
                href={item.href}
                class="mobile-group-item"
                aria-current={isActiveItem(item.href) ? "page" : undefined}
              >
                <span class="mobile-item-label">{item.label}</span>
                <span class="mobile-item-desc">{item.desc}</span>
              </a>
            ))}
          </div>
        </details>
      ))}
    </div>
  </nav>
</div>

<script>
  const groups = Array.from(document.querySelectorAll<HTMLDetailsElement>(".site-nav-mega .mega-group"));

  groups.forEach((g) => {
    g.addEventListener("toggle", () => {
      if (g.open) {
        groups.forEach((other) => {
          if (other !== g) other.open = false;
        });
      }
    });
  });

  document.addEventListener("click", (e) => {
    const target = e.target as Node;
    if (!groups.some((g) => g.contains(target))) {
      groups.forEach((g) => (g.open = false));
    }
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") groups.forEach((g) => (g.open = false));
  });

  const toggle = document.querySelector<HTMLButtonElement>("[data-mobile-menu-toggle]");
  const drawer = document.querySelector<HTMLDivElement>("[data-mobile-drawer]");
  const closers = document.querySelectorAll<HTMLElement>("[data-mobile-drawer-close]");

  function openDrawer() {
    if (!drawer) return;
    drawer.removeAttribute("hidden");
    toggle?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  }
  function closeDrawer() {
    if (!drawer) return;
    drawer.setAttribute("hidden", "");
    toggle?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  }

  toggle?.addEventListener("click", openDrawer);
  closers.forEach((c) => c.addEventListener("click", closeDrawer));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && drawer && !drawer.hasAttribute("hidden")) closeDrawer();
  });
</script>

<!-- Site search (existing) -->
<div class="site-search-shell" data-site-search hidden inert aria-hidden="true">
  <div class="site-search-backdrop" data-site-search-close></div>
  <section
    id="site-search-panel"
    class="site-search-panel"
    data-site-search-panel
    role="dialog"
    aria-modal="true"
    aria-labelledby="site-search-title"
  >
    <div class="site-search-head">
      <div>
        <span class="tiny">Search the publication</span>
        <h2 id="site-search-title">Pages, regions, and place profiles</h2>
      </div>
      <button class="source-pill" type="button" data-site-search-close>Close</button>
    </div>

    <form class="site-search-form" role="search">
      <label class="filter-field">
        <span class="tiny">Search</span>
        <input
          type="search"
          name="site_search"
          placeholder="Try Birmingham, Burnley, North West, or an area code"
          autocomplete="off"
          spellcheck="false"
          data-site-search-input
        />
      </label>
    </form>

    <div class="site-search-meta">
      <span class="tiny" data-site-search-status>Loading search index...</span>
      <span class="tiny">Shortcut: <span data-site-search-hint>Ctrl+K</span></span>
    </div>

    <div class="site-search-results" data-site-search-results></div>
  </section>

  <script>
    import { initSiteSearch } from "../scripts/site-search";
    initSiteSearch();
  </script>
</div>

<style>
  .site-nav-mega {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
  }

  .mega-group { position: relative; }
  .mega-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.85rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-muted);
    border-radius: 8px;
    cursor: pointer;
    list-style: none;
    transition: color 180ms, background 180ms;
    user-select: none;
  }
  .mega-trigger::-webkit-details-marker { display: none; }
  .mega-trigger::marker { content: ""; }
  .mega-trigger:hover { color: var(--text); background: var(--bg-subtle); }
  .mega-group[open] .mega-trigger { color: var(--text); background: var(--bg-subtle); }
  .mega-group[data-active="true"] .mega-trigger { color: var(--text); }
  .mega-group[data-active="true"] .mega-trigger::after {
    content: "";
    position: absolute;
    bottom: -3px;
    left: 0.85rem;
    right: 0.85rem;
    height: 2px;
    border-radius: 1px;
    background: var(--accent);
  }
  .mega-caret { display: inline-flex; transition: transform 180ms; opacity: 0.7; }
  .mega-group[open] .mega-caret { transform: rotate(180deg); }

  .mega-panel {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    min-width: 340px;
    max-width: 420px;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.55rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: var(--shadow);
    z-index: 60;
    animation: megaFadeIn 180ms ease-out;
  }
  .mega-group:last-of-type .mega-panel { left: auto; right: 0; }

  @keyframes megaFadeIn {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .mega-item {
    display: block;
    padding: 0.7rem 0.85rem;
    border-radius: 10px;
    text-decoration: none;
    transition: background 180ms;
  }
  .mega-item:hover { background: var(--bg-subtle); }
  .mega-item[aria-current="page"] {
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }
  .mega-item-label {
    display: block;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.2;
  }
  .mega-item[aria-current="page"] .mega-item-label { color: var(--accent); }
  .mega-item-desc {
    display: block;
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.4;
    margin-top: 0.2rem;
  }

  .mobile-menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: none;
    background: none;
    color: var(--text);
    cursor: pointer;
    border-radius: 10px;
    transition: background 180ms;
  }
  .mobile-menu-btn:hover { background: var(--bg-subtle); }

  @media (max-width: 900px) {
    .desktop-nav { display: none; }
    .mobile-menu-btn { display: inline-flex; }
  }

  /* Mobile drawer */
  .mobile-drawer { position: fixed; inset: 0; z-index: 1000; }
  .mobile-drawer[hidden] { display: none; }
  .mobile-drawer-backdrop {
    position: absolute;
    inset: 0;
    background: var(--bg-subtle);
    backdrop-filter: blur(4px);
    animation: drawerFadeIn 200ms ease-out;
  }
  .mobile-drawer-panel {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: min(92vw, 380px);
    background: var(--bg-subtle);
    border-left: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    padding: 1rem;
    overflow-y: auto;
    animation: drawerSlideIn 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes drawerFadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes drawerSlideIn { from { transform: translateX(100%); } to { transform: translateX(0); } }
  .mobile-drawer-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }
  .mobile-drawer-title {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .mobile-drawer-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    background: none;
    color: var(--text);
    cursor: pointer;
    border-radius: 8px;
  }
  .mobile-drawer-close:hover { background: var(--bg-subtle); }
  .mobile-drawer-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .mobile-drawer-home {
    padding: 0.85rem 0.25rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
  }
  .mobile-drawer-home.active { color: var(--accent); }
  .mobile-group { border-bottom: 1px solid var(--border); }
  .mobile-group:last-of-type { border-bottom: none; }
  .mobile-group-trigger {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 0.25rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    cursor: pointer;
    list-style: none;
  }
  .mobile-group-trigger::-webkit-details-marker { display: none; }
  .mobile-group-caret { transition: transform 180ms; opacity: 0.6; }
  .mobile-group[open] .mobile-group-caret { transform: rotate(180deg); }
  .mobile-group-items {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0 0 0.5rem;
  }
  .mobile-group-item {
    display: block;
    padding: 0.6rem 0.75rem;
    border-radius: 8px;
    text-decoration: none;
    color: var(--text);
  }
  .mobile-group-item:hover { background: var(--bg-subtle); }
  .mobile-group-item[aria-current="page"] {
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--accent);
  }
  .mobile-item-label {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .mobile-item-desc {
    display: block;
    font-size: 0.76rem;
    color: var(--text-muted);
    line-height: 1.35;
    margin-top: 0.15rem;
  }
</style>
