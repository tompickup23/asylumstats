---
import { getAreaCost, AREA_COST_SOURCES as sources, AREA_COST_NOTES as notes,
  formatAreaCost, formatAreaCostCompact, formatCostDate } from "../lib/area-cost";
import CostDataDrawer from "./CostDataDrawer.astro";
interface Props { areaCode: string }
const cost = getAreaCost(Astro.props.areaCode);
---

<section class="cost-calc" aria-label={`Asylum cost comparison for ${cost.areaName}`}>
  <h3>What can be priced in {cost.areaName}</h3>
  <p class="cost-value">About {formatAreaCostCompact(cost.m2.pricedSubtotal)} a year</p>
  <p><strong>Partial subtotal, paid by the Home Office.</strong> Based on the local accommodation mix, holding the count constant for a year. Grants and any separate accommodated allowance are excluded.</p>
  {cost.m2.unpricedNote && <p class="unpriced"><strong>{cost.m2.unpricedNote}</strong></p>}
  {cost.m2.contingencyNote && <p>{cost.m2.contingencyNote}</p>}
  <p>{notes.hypothetical}</p>
  <dl class="cost-grid">
    <div><dt>Per income taxpayer (nearest £10)</dt><dd>{formatAreaCost(cost.m3.perTaxpayer)}</dd>
      {cost.m3.perTaxpayerNote && <p class="tiny">{cost.m3.perTaxpayerNote}</p>}</div>
    <div><dt>Per chargeable dwelling</dt><dd>{formatAreaCost(cost.m3.perDwelling)}</dd>
      {cost.m3.dwellingNote && <p class="tiny">{cost.m3.dwellingNote}</p>}</div>
    <div><dt>Per resident</dt><dd>{formatAreaCost(cost.m3.perResident)}</dd>
      {cost.m3.residentNote && <p class="tiny">{cost.m3.residentNote}</p>}</div>
  </dl>
  <p class="tiny"> <a href={sources.counts.source_url}>Count: {formatCostDate(cost.dates.count)}</a>. <a href={sources.rates.dispersal2026.url}>Nightly rates: {cost.dates.rate}</a>. <a href={sources.taxpayers.landingPage}>Taxpayers: {cost.dates.taxpayers}</a>. <a href={sources.dwellings.url}>Dwellings: {formatCostDate(cost.dates.dwellings)}</a>. <a href={sources.population.sourceUrl}>Population: {formatCostDate(cost.dates.population)}</a>. </p>
  <p class="tiny">The separate <a href={cost.m4.costSource.finding}>national system estimate</a> is {formatAreaCost(cost.m4.perTaxpayer)} per UK income taxpayer for {cost.m4.year}, using <a href={cost.m4.source.url}>HMRC's matching-year projection</a>. {cost.m4.note}</p>
  <CostDataDrawer cost={cost} />
</section>

<style>
  .cost-calc { min-width: 0; border: 1px solid var(--border); border-radius: 10px; padding: 1.25rem; margin-top: 1.25rem; }
  .cost-calc h3 { font-size: 1.2rem; }
  .cost-value { font-size: 1.7rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .cost-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; margin: 1rem 0; }
  .cost-grid div { min-width: 0; padding: .75rem; background: var(--bg-subtle); border-radius: 6px; }
  dt { font-size: .85rem; } dd { font-size: 1.4rem; margin: .25rem 0; font-weight: 600; }
  .unpriced { padding: .75rem; border-left: 3px solid var(--warning); }
  p { margin: .75rem 0; }
</style>
