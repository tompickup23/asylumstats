---
/**
 * Local asylum cost calculator.
 * Estimates what asylum support costs in this area based on:
 * - National hotel spend: £5.77M/day, ie £2.1bn in 2024/25
 *   (House of Commons Library, CDP-2025-0184, not the NAO: the NAO publishes no per-day figure)
 * - National subsistence: £49.18/week per person
 * - Local authority grant: ~£1,200/year per dispersed person
 * - Local supported asylum seekers count
 * - Area households (for per-household figure)
 */
import { loadLocalRouteLatest } from "../lib/route-data";

interface Props {
  areaName: string;
  supportedAsylum: number;
  totalHouseholds?: number;
  hotelSites?: number;
}

const { areaName, supportedAsylum, totalHouseholds, hotelSites = 0 } = Astro.props;

// National figures. The per-day hotel figure comes from the House of Commons Library
// debate pack CDP-2025-0184: "In 2024/25, the Home Office spent £4bn on asylum support.
// This includes £2.1bn on hotel accommodation for asylum seekers, which is equivalent to
// £5.77m per day." It is NOT an NAO figure; the NAO publishes no per-day rate, and
// crediting it there was a real defect until 21 Aug 2026.
const NATIONAL_HOTEL_DAILY = 5_770_000; // £5.77M/day, 2024/25 (Commons Library CDP-2025-0184)
// Derived from the same snapshot the area's own count comes from, never written down.
//
// This was hardcoded at 107,003, an undated figure roughly nine months behind the data on
// the rest of the site, which publishes 97,519 at 31 March 2026. Every place page was
// therefore telling the reader its area was a smaller share of the country than the site's
// own homepage implied, and because the share also scales the local hotel estimate, every
// one of those estimates was about nine per cent low.
//
// Summing the areas gives exactly the published national quarter figure, so the two cannot
// drift apart: if the snapshot moves, both move together.
const localRouteLatest = loadLocalRouteLatest();
const NATIONAL_SUPPORTED_TOTAL = localRouteLatest.areas.reduce(
  (total, area) => total + (area.supportedAsylum ?? 0),
  0
);
const NATIONAL_SNAPSHOT_LABEL = new Date(`${localRouteLatest.snapshotDate}T00:00:00Z`)
  .toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
const SUBSISTENCE_WEEKLY = 49.18; // Per person per week
const LA_GRANT_ANNUAL = 1_200; // Per dispersed person per year

// Local estimates
const localSharePct = supportedAsylum / NATIONAL_SUPPORTED_TOTAL;
const localHotelDailyCost = Math.round(NATIONAL_HOTEL_DAILY * localSharePct);
const localHotelAnnualCost = localHotelDailyCost * 365;
const localSubsistenceAnnual = Math.round(supportedAsylum * SUBSISTENCE_WEEKLY * 52);
const localGrant = Math.round(supportedAsylum * LA_GRANT_ANNUAL);
const localTotalAnnual = localHotelAnnualCost + localSubsistenceAnnual;
const localPerHousehold = totalHouseholds && totalHouseholds > 0
  ? Math.round(localTotalAnnual / totalHouseholds)
  : null;


function fmt(n: number): string {
  if (n >= 1_000_000) return `£${(n / 1_000_000).toFixed(1)}M`;
  if (n >= 1_000) return `£${(n / 1_000).toFixed(0)}K`;
  return `£${n.toLocaleString()}`;
}
---

{supportedAsylum > 0 && (
  <div class="cost-calc">
    <h3>What asylum costs {areaName}</h3>
    <div class="cost-grid">
      <div class="cost-item">
        <span class="cost-value">{fmt(localHotelAnnualCost)}</span>
        <span class="cost-label">estimated hotel costs/year</span>
      </div>
      <div class="cost-item">
        <span class="cost-value">{fmt(localSubsistenceAnnual)}</span>
        <span class="cost-label">subsistence payments/year</span>
      </div>
      <div class="cost-item">
        <span class="cost-value">{fmt(localGrant)}</span>
        <span class="cost-label">LA dispersal grant/year</span>
      </div>
      {localPerHousehold !== null && (
        <div class="cost-item cost-highlight">
          <span class="cost-value">£{localPerHousehold}</span>
          <span class="cost-label">per household/year</span>
        </div>
      )}
    </div>
    <p class="cost-note tiny">
      Estimates based on {supportedAsylum.toLocaleString()} people on asylum support in {areaName}
      ({(localSharePct * 100).toFixed(2)}% of {NATIONAL_SUPPORTED_TOTAL.toLocaleString()} nationally
      at {NATIONAL_SNAPSHOT_LABEL}).
      Hotel costs pro-rated from £5.77M/day national spend in 2024/25 (House of Commons Library, CDP-2025-0184).
      Subsistence: £{SUBSISTENCE_WEEKLY}/week per person.
      {hotelSites > 0 ? ` ${hotelSites} known hotel sites in this area.` : ""}
    </p>
  </div>
)}

<style>
  .cost-calc {
    background: color-mix(in srgb, var(--warning) 4%, transparent);
    border: 1px solid color-mix(in srgb, var(--warning) 15%, transparent);
    border-radius: 10px;
    padding: 1.25rem;
    margin-top: 1.25rem;
  }
  .cost-calc h3 { font-size: 1rem; margin-bottom: 0.75rem; }
  .cost-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 0.75rem;
  }
  .cost-item {
    text-align: center;
    padding: 0.5rem;
    background: var(--bg-subtle);
    border-radius: 6px;
  }
  .cost-value {
    display: block;
    font-size: 1.4rem;
    font-weight: 600;
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--warning);
  }
  .cost-label {
    display: block;
    font-size: 0.72rem;
    color: var(--text-muted);
    margin-top: 0.15rem;
  }
  .cost-highlight {
    background: color-mix(in srgb, var(--warning) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--warning) 20%, transparent);
  }
  .cost-highlight .cost-value { color: var(--critical); font-size: 1.6rem; }
  .cost-note { margin-top: 0.75rem; opacity: 0.5; }
</style>
