---
/**
 * One finding, article or news piece on the research page. "hero" is the wide card for
 * featured investigations; "card" is the grid card. Every card shows its date, because a
 * research page whose pieces carry no date cannot be trusted to be current.
 */
import type { CollectionEntry } from "astro:content";
import { formatFindingDate, findingDisplayDate, findingIsRevised } from "../lib/finding-dates";

interface Props {
  finding: CollectionEntry<"findings">;
  variant?: "hero" | "card";
}

const { finding, variant = "card" } = Astro.props;
const { data } = finding;
const href = `/findings/${finding.id.replace(/\.md$/, "")}/`;

const verdictColor: Record<string, string> = {
  alert: "var(--warning)",
  critical: "var(--critical)",
  resolved: "var(--positive)",
  info: "var(--accent)"
};
const verdictLabel: Record<string, string> = {
  alert: "Finding",
  critical: "Investigation",
  resolved: "Resolved",
  info: "Analysis"
};
const typeLabel =
  data.content_type === "news" ? "Latest" : data.content_type === "article" ? "Article" : verdictLabel[data.verdict];
const categoryLabel: Record<string, string> = {
  spending: "Spending",
  routes: "Routes",
  demographics: "Demographics",
  backlog: "Backlog",
  accountability: "Accountability",
  crime: "Crime",
  "pressure-index": "Pressure",
  "social-care": "Social care",
  send: "Schools"
};
---

<a href={href} class:list={["finding-card", { "finding-card--hero": variant === "hero" }]}>
  <span class="fc-meta">
    <span class="fc-type" style={`color: ${verdictColor[data.verdict]}`}>{typeLabel}</span>
    <span class="fc-category">{categoryLabel[data.category] ?? data.category}</span>
    <span class="fc-date">
      {findingIsRevised(data) ? "Updated " : ""}{formatFindingDate(findingDisplayDate(data))}
    </span>
  </span>
  <span class="fc-headline">{data.headline}</span>
  <span class="fc-stat-row">
    <span class="fc-stat" style={`color: ${verdictColor[data.verdict]}`}>{data.stat_value}</span>
    <span class="fc-stat-label">{data.stat_label}</span>
  </span>
  <span class="fc-summary">{data.summary}</span>
  <span class="fc-cta">Read more &rarr;</span>
</a>

<style>
  .finding-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 1.4rem;
    text-decoration: none;
    color: var(--text);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: border-color 180ms, transform 120ms;
  }
  .finding-card:hover,
  .finding-card:focus-visible {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .finding-card--hero {
    border-left: 3px solid var(--critical);
    padding: 1.75rem;
  }
  .fc-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }
  .fc-type,
  .fc-category {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .fc-category {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
  }
  .fc-date {
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .fc-headline {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .finding-card--hero .fc-headline {
    font-size: clamp(1.25rem, 2.6vw, 1.6rem);
    line-height: 1.2;
  }
  .fc-stat-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .fc-stat {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1;
  }
  .finding-card--hero .fc-stat {
    font-size: 2rem;
  }
  .fc-stat-label {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .fc-summary {
    font-size: 0.86rem;
    color: var(--text-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .fc-cta {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent);
    margin-top: auto;
  }
</style>
