---
import type { PlaceDirectoryRegion } from "../lib/place-directory";

interface Props {
  id?: string;
  region: PlaceDirectoryRegion;
  snapshotDate: string;
}

type ScopeMeta = {
  scopeId: string;
  scopeKind: "region" | "place";
  eyebrow: string;
  title: string;
  note: string;
};

const { id, region, snapshotDate } = Astro.props;

const scopeMeta: Record<string, ScopeMeta> = {
  [region.regionName]: {
    scopeId: region.regionName,
    scopeKind: "region",
    eyebrow: `${region.countryName} region`,
    title: region.regionName,
    note: "Pick one authority on the map."
  }
};

const payload = JSON.stringify({
  boundariesUrl: "/place-boundaries.json",
  regionName: region.regionName,
  scopeMeta: {
    ...scopeMeta,
    ...Object.fromEntries(
      region.areas.map((row) => [
        row.area.areaCode,
        {
          scopeId: row.area.areaCode,
          scopeKind: "place",
          eyebrow: `${region.regionName} local page`,
          title: row.area.areaName,
          note: "Local preview."
        }
      ])
    )
  },
  areas: region.areas.map((row) => ({
    areaCode: row.area.areaCode,
    areaName: row.area.areaName,
    supportedAsylum: row.area.supportedAsylum,
    supportedAsylumRate: row.area.supportedAsylumRate,
    contingencyAccommodation: row.area.contingencyAccommodation,
    hotelSignalValue: row.hotelSignal === "named" ? 2 : row.hotelSignal === "unnamed" ? 1 : 0,
    hotelSignalLabel:
      row.hotelSignal === "named"
        ? `${row.namedCurrentSiteCount} named current hotel site${row.namedCurrentSiteCount === 1 ? "" : "s"}`
        : row.hotelSignal === "unnamed"
          ? `${row.unnamedSiteCount} unnamed acknowledged hotel site${row.unnamedSiteCount === 1 ? "" : "s"}`
          : "No named current hotel site visible"
  }))
});
---

<section class="home-map-stage region-authority-stage" data-region-authority-stage data-home-map-depth="region" id={id}>
  <script type="application/json" data-region-authority-data set:html={payload} is:inline></script>

  <div class="home-map-intro">
    <div class="home-map-topline">
      <div class="chip-row home-map-path">
        <span class="chip accent" data-region-authority-path-root>{region.regionName}</span>
        <span class="chip teal" data-region-authority-path-area hidden></span>
      </div>
      <div class="home-map-nav">
        <button
          type="button"
          class="chip"
          data-region-authority-back
          disabled
          aria-label="Zoom out to the previous regional map view"
        >
          Zoom out
        </button>
        <button
          type="button"
          class="chip"
          data-region-authority-forward
          disabled
          aria-label="Zoom in to the next regional map view"
        >
          Zoom in
        </button>
        <span class="chip warm home-map-depth-chip" data-region-authority-depth-chip>Regional lens</span>
      </div>
    </div>
    <div class="home-map-copy">
      <span class="kicker" data-region-authority-eyebrow>{region.countryName} region</span>
      <h1 data-region-authority-title>{region.regionName}</h1>
      <p data-region-authority-note>Pick one authority on the map.</p>
    </div>
    <div class="chip-row home-map-meta">
      <span class="chip">{snapshotDate} local snapshot</span>
      <span class="chip teal">{region.publicPlaceCount.toLocaleString()} public place pages</span>
      <span class="chip accent">{region.supportedAsylum.toLocaleString()} on support</span>
    </div>
  </div>

  <section class="home-authority-stage">
    <article class="region-map-legend is-overlay home-authority-legend" data-region-authority-legend>
      <div class="region-map-legend-top">
        <div class="chip-row">
          <span class="chip accent">Authority map</span>
        </div>
        <div class="region-map-controls" role="toolbar" aria-label="Regional authority map metric">
          <button type="button" class="chip accent is-active" data-region-authority-view="total">
            Total
          </button>
          <button type="button" class="chip" data-region-authority-view="rate">
            Rate
          </button>
          <button type="button" class="chip" data-region-authority-view="hotel">
            Hotel visibility
          </button>
        </div>
      </div>
      <div class="region-map-legend-swatch" data-region-authority-swatch data-tone="accent">
        <span>Lower</span>
        <span>Higher</span>
      </div>
      <div class="region-map-legend-copy">
        <strong data-region-authority-legend-title>Scale first</strong>
        <p class="tiny" data-region-authority-legend-body>
          Use total to see where the largest supported-asylum stock sits before you narrow into one authority.
        </p>
      </div>
    </article>

    <div class="home-authority-canvas">
      <svg
        class="region-map home-authority-map"
        data-region-authority-svg
        viewBox="0 0 620 760"
        preserveAspectRatio="xMidYMid meet"
        role="img"
        aria-label={`${region.regionName} authority map`}
      ></svg>
      <figcaption class="tiny region-map-caption home-authority-caption" data-region-authority-caption>
        Select one authority to update the right-hand deck without leaving the region page.
      </figcaption>
    </div>

    <section class="home-map-signal-band" data-region-authority-signal-band>
      <article class="home-map-signal-card">
        <span class="tiny" data-region-authority-signal-label-1>Authorities</span>
        <strong data-region-authority-signal-value-1>{region.publicPlaceCount.toLocaleString()}</strong>
        <p data-region-authority-signal-meta-1>public pages in this region</p>
      </article>
      <article class="home-map-signal-card">
        <span class="tiny" data-region-authority-signal-label-2>Support</span>
        <strong data-region-authority-signal-value-2>{region.supportedAsylum.toLocaleString()}</strong>
        <p data-region-authority-signal-meta-2>people on support</p>
      </article>
      <article class="home-map-signal-card">
        <span class="tiny" data-region-authority-signal-label-3>Contingency</span>
        <strong data-region-authority-signal-value-3>{region.contingencyAccommodation.toLocaleString()}</strong>
        <p data-region-authority-signal-meta-3>people in contingency accommodation</p>
      </article>
    </section>

    <section class="home-map-quick-panel" data-region-authority-quick-panel>
      <div class="home-map-quick-head">
        <span class="tiny">Quick picks</span>
        <strong data-region-authority-quick-title>Open the authorities driving this region</strong>
      </div>
      <div class="home-map-quick-grid" data-region-authority-quick-grid></div>
    </section>

    <aside class="home-map-focus-card" data-region-authority-focus>
      <p class="tiny home-map-focus-kicker" data-region-authority-focus-kicker>{region.countryName} region</p>
      <strong data-region-authority-focus-title>{region.regionName}</strong>
      <p data-region-authority-focus-body>
        Use the authority map to narrow inside {region.regionName} before opening any full local page.
      </p>
      <div class="chip-row home-map-focus-meta">
        <span class="chip" data-region-authority-focus-primary>{region.publicPlaceCount.toLocaleString()} authorities</span>
        <span class="chip accent" data-region-authority-focus-secondary>
          {region.supportedAsylum.toLocaleString()} on support
        </span>
        <a class="chip accent" data-region-authority-focus-link hidden></a>
      </div>
    </aside>
  </section>
</section>

<script>
  type ScopeMeta = {
    scopeId: string;
    scopeKind: "region" | "place";
    eyebrow: string;
    title: string;
    note: string;
  };

  type AreaPayload = {
    areaCode: string;
    areaName: string;
    supportedAsylum: number;
    supportedAsylumRate: number | null;
    contingencyAccommodation: number;
    hotelSignalValue: number;
    hotelSignalLabel: string;
  };

  type RegionAuthorityPayload = {
    boundariesUrl: string;
    regionName: string;
    scopeMeta: Record<string, ScopeMeta>;
    areas: AreaPayload[];
  };

  type BoundaryArea = {
    areaCode: string;
    areaName: string;
    path: string;
    labelX: number;
    labelY: number;
  };

  type BoundaryPayload = {
    width: number;
    height: number;
    regions: Record<string, { countryName: string; areaCount: number; areas: BoundaryArea[] }>;
  };

  type AuthorityMetricId = "total" | "rate" | "hotel";

  const windowWithRegionAuthorityFlag = window as Window & { __asylumstatsRegionAuthorityInit?: boolean };

  if (!windowWithRegionAuthorityFlag.__asylumstatsRegionAuthorityInit) {
    windowWithRegionAuthorityFlag.__asylumstatsRegionAuthorityInit = true;

    const SVG_NS = "http://www.w3.org/2000/svg";
    const metricConfig: Record<
      AuthorityMetricId,
      { tone: "accent" | "teal" | "warm"; body: string; title: string }
    > = {
      total: {
        tone: "accent",
        title: "Scale first",
        body: "Use total to see where the largest supported-asylum stock sits before you narrow into one authority."
      },
      rate: {
        tone: "teal",
        title: "Intensity first",
        body: "Use rate to find where supported asylum is biting harder relative to the resident population."
      },
      hotel: {
        tone: "warm",
        title: "Visibility first",
        body: "Use hotel visibility to find where named or acknowledged hotel evidence is already on the public record."
      }
    };

    const formatInteger = (value: number) => value.toLocaleString("en-GB");
    const formatNumber = (value: number) =>
      new Intl.NumberFormat("en-GB", {
        minimumFractionDigits: Number.isInteger(value) ? 0 : 2,
        maximumFractionDigits: Number.isInteger(value) ? 0 : 2
      }).format(value);

    const clampOpacity = (ratio: number) => Math.max(0.18, Math.min(0.84, 0.18 + ratio * 0.58));
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const authorityViewBoxAnimations = new WeakMap<SVGSVGElement, number>();

    type ViewBox = {
      x: number;
      y: number;
      width: number;
      height: number;
    };

    const clampNumber = (value: number, minimum: number, maximum: number) =>
      Math.max(minimum, Math.min(maximum, value));

    const parseViewBox = (raw: string): ViewBox => {
      const parts = raw.split(" ").map((value) => Number.parseFloat(value));

      return {
        x: Number.isFinite(parts[0] ?? NaN) ? parts[0] : 0,
        y: Number.isFinite(parts[1] ?? NaN) ? parts[1] : 0,
        width: Number.isFinite(parts[2] ?? NaN) ? parts[2] : 0,
        height: Number.isFinite(parts[3] ?? NaN) ? parts[3] : 0
      };
    };

    const getCurrentAuthorityViewBox = (svg: SVGSVGElement): ViewBox => {
      const viewBox = svg.viewBox.baseVal;

      if (viewBox && viewBox.width > 0 && viewBox.height > 0) {
        return {
          x: viewBox.x,
          y: viewBox.y,
          width: viewBox.width,
          height: viewBox.height
        };
      }

      return parseViewBox(svg.getAttribute("viewBox") ?? "0 0 620 760");
    };

    const setAuthorityViewBox = (svg: SVGSVGElement, target: ViewBox, durationMs = 0) => {
      if (durationMs <= 0 || prefersReducedMotion) {
        svg.setAttribute("viewBox", `${target.x} ${target.y} ${target.width} ${target.height}`);
        return;
      }

      const activeFrame = authorityViewBoxAnimations.get(svg);

      if (activeFrame !== undefined) {
        window.cancelAnimationFrame(activeFrame);
      }

      const start = getCurrentAuthorityViewBox(svg);
      const deltaX = target.x - start.x;
      const deltaY = target.y - start.y;
      const deltaWidth = target.width - start.width;
      const deltaHeight = target.height - start.height;
      const startTime = performance.now();

      const easeOutCubic = (value: number) => 1 - Math.pow(1 - value, 3);

      const step = (time: number) => {
        const progress = Math.min(1, (time - startTime) / durationMs);
        const eased = easeOutCubic(progress);
        const x = start.x + deltaX * eased;
        const y = start.y + deltaY * eased;
        const width = start.width + deltaWidth * eased;
        const height = start.height + deltaHeight * eased;

        svg.setAttribute("viewBox", `${x} ${y} ${width} ${height}`);

        if (progress < 1) {
          const nextFrame = window.requestAnimationFrame(step);
          authorityViewBoxAnimations.set(svg, nextFrame);
          return;
        }

        authorityViewBoxAnimations.delete(svg);
      };

      const firstFrame = window.requestAnimationFrame(step);
      authorityViewBoxAnimations.set(svg, firstFrame);
    };

    const formatRateText = (value: number | null) =>
      value === null ? "Rate not published" : `${formatNumber(value)} per 10,000`;

    type AuthorityFocusProfile = {
      biasX?: number;
      biasY?: number;
      maxSpanRatio?: number;
      minSpanRatio?: number;
      paddingMax?: number;
      paddingMin?: number;
      paddingScale?: number;
    };

    const regionalAuthorityFocusProfiles: Record<string, AuthorityFocusProfile> = {
      "East Midlands": { minSpanRatio: 0.14, paddingScale: 0.24 },
      "East of England": { biasX: 0.04, minSpanRatio: 0.15, paddingScale: 0.24 },
      London: { minSpanRatio: 0.1, paddingScale: 0.2 },
      "North East": { biasY: -0.03, minSpanRatio: 0.14, paddingScale: 0.22 },
      "North West": { biasY: -0.04, minSpanRatio: 0.15, paddingScale: 0.26 },
      "Northern Ireland": { minSpanRatio: 0.12, paddingScale: 0.2 },
      Scotland: { biasY: -0.08, minSpanRatio: 0.14, paddingScale: 0.22 },
      "South East": { biasX: 0.02, minSpanRatio: 0.14, paddingScale: 0.23 },
      "South West": { biasX: -0.06, biasY: -0.02, minSpanRatio: 0.16, paddingScale: 0.24 },
      Wales: { biasX: -0.04, minSpanRatio: 0.14, paddingScale: 0.24 },
      "West Midlands": { minSpanRatio: 0.12, paddingScale: 0.22 },
      "Yorkshire and The Humber": { minSpanRatio: 0.15, paddingScale: 0.25 }
    };

    const authorityFocusProfiles: Record<string, AuthorityFocusProfile> = {
      E06000063: { biasY: -0.03, minSpanRatio: 0.17, paddingScale: 0.2 },
      E06000064: { biasY: -0.04, minSpanRatio: 0.17, paddingScale: 0.2 },
      E06000065: { biasY: -0.06, minSpanRatio: 0.18, paddingScale: 0.18 },
      E07000117: { biasY: -0.03, minSpanRatio: 0.12, paddingScale: 0.22 },
      E08000003: { minSpanRatio: 0.12, paddingScale: 0.2 },
      E08000012: { biasX: -0.02, minSpanRatio: 0.14, paddingScale: 0.2 },
      E08000025: { minSpanRatio: 0.12, paddingScale: 0.2 },
      N09000003: { minSpanRatio: 0.11, paddingScale: 0.18 }
    };

    const getAuthorityFocusProfile = (regionName: string, areaCode: string | null): AuthorityFocusProfile => ({
      ...(regionalAuthorityFocusProfiles[regionName] ?? {}),
      ...(areaCode ? authorityFocusProfiles[areaCode] ?? {} : {})
    });

    const buildAuthorityViewBox = (
      bounds: DOMRect,
      payloadWidth: number,
      payloadHeight: number,
      focusProfile: AuthorityFocusProfile = {}
    ): ViewBox => {
      const width = Math.max(payloadWidth, 1);
      const height = Math.max(payloadHeight, 1);
      const mapAspect = width / height;

      const minimumFocusWidth = width * (focusProfile.minSpanRatio ?? 0.18);
      const minimumFocusHeight = height * (focusProfile.minSpanRatio ?? 0.18);
      const basePadding = clampNumber(
        Math.min(bounds.width, bounds.height) * (focusProfile.paddingScale ?? 0.32),
        focusProfile.paddingMin ?? 10,
        focusProfile.paddingMax ?? 34
      );
      let focusWidth = Math.max(bounds.width + basePadding * 2, minimumFocusWidth);
      let focusHeight = Math.max(bounds.height + basePadding * 2, minimumFocusHeight);

      if (focusWidth / focusHeight > mapAspect) {
        focusHeight = focusWidth / mapAspect;
      } else {
        focusWidth = focusHeight * mapAspect;
      }

      focusWidth = clampNumber(focusWidth, minimumFocusWidth, width * (focusProfile.maxSpanRatio ?? 0.98));
      focusHeight = clampNumber(focusHeight, minimumFocusHeight, height * (focusProfile.maxSpanRatio ?? 0.98));

      if (focusWidth / focusHeight > mapAspect) {
        focusWidth = focusHeight * mapAspect;
      } else {
        focusHeight = focusWidth / mapAspect;
      }

      const centerX = bounds.x + bounds.width / 2 + bounds.width * (focusProfile.biasX ?? 0);
      const centerY = bounds.y + bounds.height / 2 + bounds.height * (focusProfile.biasY ?? 0);
      const viewX = clampNumber(centerX - focusWidth / 2, 0, Math.max(0, width - focusWidth));
      const viewY = clampNumber(centerY - focusHeight / 2, 0, Math.max(0, height - focusHeight));

      return { x: viewX, y: viewY, width: focusWidth, height: focusHeight };
    };

    const getFill = (value: number, minValue: number, maxValue: number, tone: "accent" | "teal" | "warm") => {
      const range = Math.max(maxValue - minValue, 1);
      const ratio = (value - minValue) / range;
      const alpha = clampOpacity(ratio);

      if (tone === "teal") {
        return `rgba(78, 228, 195, ${alpha})`;
      }

      if (tone === "warm") {
        return `rgba(255, 139, 97, ${alpha})`;
      }

      return `rgba(125, 211, 252, ${alpha})`;
    };

    const buildAreaHref = (areaCode: string) => `/places/${areaCode}/`;

    const loadBoundaryPayload = (() => {
      let promise: Promise<BoundaryPayload> | null = null;

      return (url: string) => {
        if (!promise) {
          promise = fetch(url, { headers: { accept: "application/json" } }).then((response) => {
            if (!response.ok) {
              throw new Error(`Boundary payload failed with ${response.status}`);
            }

            return response.json() as Promise<BoundaryPayload>;
          });
        }

        return promise;
      };
    })();

    for (const root of document.querySelectorAll<HTMLElement>("[data-region-authority-stage]")) {
      if (root.dataset.regionAuthorityReady === "true") {
        continue;
      }

      root.dataset.regionAuthorityReady = "true";
      const dataNode = root.querySelector<HTMLScriptElement>("[data-region-authority-data]");

      if (!dataNode?.textContent) {
        continue;
      }

      const payload = JSON.parse(dataNode.textContent) as RegionAuthorityPayload;
      const authoritySvg = root.querySelector<SVGSVGElement>("[data-region-authority-svg]");
      const eyebrow = root.querySelector<HTMLElement>("[data-region-authority-eyebrow]");
      const title = root.querySelector<HTMLElement>("[data-region-authority-title]");
      const note = root.querySelector<HTMLElement>("[data-region-authority-note]");
      const legendTitle = root.querySelector<HTMLElement>("[data-region-authority-legend-title]");
      const legendBody = root.querySelector<HTMLElement>("[data-region-authority-legend-body]");
      const legendSwatch = root.querySelector<HTMLElement>("[data-region-authority-swatch]");
      const caption = root.querySelector<HTMLElement>("[data-region-authority-caption]");
      const pathArea = root.querySelector<HTMLElement>("[data-region-authority-path-area]");
      const backButton = root.querySelector<HTMLButtonElement>("[data-region-authority-back]");
      const forwardButton = root.querySelector<HTMLButtonElement>("[data-region-authority-forward]");
      const depthChip = root.querySelector<HTMLElement>("[data-region-authority-depth-chip]");
      const focusCard = root.querySelector<HTMLElement>("[data-region-authority-focus]");
      const focusKicker = root.querySelector<HTMLElement>("[data-region-authority-focus-kicker]");
      const focusTitle = root.querySelector<HTMLElement>("[data-region-authority-focus-title]");
      const focusBody = root.querySelector<HTMLElement>("[data-region-authority-focus-body]");
      const focusPrimary = root.querySelector<HTMLElement>("[data-region-authority-focus-primary]");
      const focusSecondary = root.querySelector<HTMLElement>("[data-region-authority-focus-secondary]");
      const focusLink = root.querySelector<HTMLAnchorElement>("[data-region-authority-focus-link]");
      const signalLabelOne = root.querySelector<HTMLElement>("[data-region-authority-signal-label-1]");
      const signalValueOne = root.querySelector<HTMLElement>("[data-region-authority-signal-value-1]");
      const signalMetaOne = root.querySelector<HTMLElement>("[data-region-authority-signal-meta-1]");
      const signalLabelTwo = root.querySelector<HTMLElement>("[data-region-authority-signal-label-2]");
      const signalValueTwo = root.querySelector<HTMLElement>("[data-region-authority-signal-value-2]");
      const signalMetaTwo = root.querySelector<HTMLElement>("[data-region-authority-signal-meta-2]");
      const signalLabelThree = root.querySelector<HTMLElement>("[data-region-authority-signal-label-3]");
      const signalValueThree = root.querySelector<HTMLElement>("[data-region-authority-signal-value-3]");
      const signalMetaThree = root.querySelector<HTMLElement>("[data-region-authority-signal-meta-3]");
      const quickTitle = root.querySelector<HTMLElement>("[data-region-authority-quick-title]");
      const quickGrid = root.querySelector<HTMLElement>("[data-region-authority-quick-grid]");

      if (
        !authoritySvg ||
        !eyebrow ||
        !title ||
        !note ||
        !legendTitle ||
        !legendBody ||
        !legendSwatch ||
        !caption ||
        !pathArea ||
        !backButton ||
        !forwardButton ||
        !depthChip ||
        !focusCard ||
        !focusKicker ||
        !focusTitle ||
        !focusBody ||
        !focusPrimary ||
        !focusSecondary ||
        !focusLink ||
        !signalLabelOne ||
        !signalValueOne ||
        !signalMetaOne ||
        !signalLabelTwo ||
        !signalValueTwo ||
        !signalMetaTwo ||
        !signalLabelThree ||
        !signalValueThree ||
        !signalMetaThree ||
        !quickTitle ||
        !quickGrid
      ) {
        continue;
      }

      let currentMetric: AuthorityMetricId = "total";
      let currentAreaCode: string | null = null;
      let renderSequence = 0;
      let scopeHistory = [payload.regionName];
      let historyIndex = 0;

      const setChip = (node: HTMLElement, text: string | null, tone?: "accent" | "teal" | "warm") => {
        if (!text) {
          node.hidden = true;
          node.textContent = "";
          node.className = "chip";
          return;
        }

        node.hidden = false;
        node.textContent = text;
        node.className = tone ? `chip ${tone}` : "chip";
      };

      const setSignalCard = (
        labelNode: HTMLElement,
        valueNode: HTMLElement,
        metaNode: HTMLElement,
        labelText: string,
        valueText: string,
        metaText: string
      ) => {
        labelNode.textContent = labelText;
        valueNode.textContent = valueText;
        metaNode.textContent = metaText;
      };

      const updateMapNav = () => {
        const previousScopeId = scopeHistory[historyIndex - 1];
        const nextScopeId = scopeHistory[historyIndex + 1];
        backButton.disabled = !previousScopeId;
        forwardButton.disabled = !nextScopeId;
        backButton.title = previousScopeId
          ? `Zoom out to ${payload.scopeMeta[previousScopeId]?.title ?? "the previous view"}`
          : "No broader saved view";
        forwardButton.title = nextScopeId
          ? `Zoom in to ${payload.scopeMeta[nextScopeId]?.title ?? "the next view"}`
          : "No deeper saved view";
      };

      const rememberScope = (scopeId: string) => {
        if (scopeHistory[historyIndex] === scopeId) {
          updateMapNav();
          return;
        }

        scopeHistory = scopeHistory.slice(0, historyIndex + 1);
        scopeHistory.push(scopeId);
        historyIndex = scopeHistory.length - 1;
        updateMapNav();
      };

      const updateCopy = (scopeId: string) => {
        const meta = payload.scopeMeta[scopeId] ?? payload.scopeMeta[payload.regionName];
        eyebrow.textContent = meta.eyebrow;
        title.textContent = meta.title;
        note.textContent = meta.note;
        depthChip.textContent = meta.scopeKind === "place" ? "Authority lens" : "Regional lens";
        root.dataset.homeMapDepth = meta.scopeKind === "place" ? "place" : "region";
        setChip(pathArea, meta.scopeKind === "place" ? meta.title : null, "teal");
      };

      const buildAreaMetricChip = (area: AreaPayload) => {
        if (currentMetric === "rate") {
          return {
            text: area.supportedAsylumRate === null ? "Rate n/a" : `${formatNumber(area.supportedAsylumRate)} / 10k`,
            tone: "teal" as const
          };
        }

        if (currentMetric === "hotel") {
          return {
            text:
              area.hotelSignalValue === 2
                ? "Named hotel site"
                : area.hotelSignalValue === 1
                  ? "Unnamed hotel evidence"
                  : "No named hotel site",
            tone: "warm" as const
          };
        }

        return {
          text: `${formatInteger(area.supportedAsylum)} on support`,
          tone: "accent" as const
        };
      };

      const getMetricValue = (area: AreaPayload) => {
        if (currentMetric === "rate") {
          return area.supportedAsylumRate ?? -1;
        }

        if (currentMetric === "hotel") {
          return area.hotelSignalValue;
        }

        return area.supportedAsylum;
      };

      const formatMetricValue = (area: AreaPayload) => {
        if (currentMetric === "rate") {
          return area.supportedAsylumRate === null ? "n/a" : formatNumber(area.supportedAsylumRate);
        }

        if (currentMetric === "hotel") {
          return area.hotelSignalValue === 2 ? "Named" : area.hotelSignalValue === 1 ? "Flagged" : "None";
        }

        return formatInteger(area.supportedAsylum);
      };

      const formatMetricMeta = (area: AreaPayload) => {
        if (currentMetric === "rate") {
          return "supported asylum per 10,000";
        }

        if (currentMetric === "hotel") {
          return area.hotelSignalLabel;
        }

        return "on support";
      };

      const renderQuickPicks = (selectedAreaCode: string | null) => {
        quickGrid.innerHTML = "";
        quickTitle.textContent =
          selectedAreaCode && payload.scopeMeta[selectedAreaCode]
            ? `Compare ${payload.scopeMeta[selectedAreaCode].title} with the regional leaders`
            : `Jump straight into ${payload.regionName}`;

        const rankedAreas = [...payload.areas]
          .sort(
            (left, right) =>
              getMetricValue(right) - getMetricValue(left) ||
              right.supportedAsylum - left.supportedAsylum ||
              left.areaName.localeCompare(right.areaName)
          )
          .slice(0, 3);

        for (const area of rankedAreas) {
          const button = document.createElement("button");
          const selected = area.areaCode === selectedAreaCode;
          button.type = "button";
          button.className = `home-map-quick-button${selected ? " is-active" : ""}`;
          button.setAttribute("aria-pressed", selected ? "true" : "false");

          const label = document.createElement("strong");
          label.textContent = area.areaName;

          const value = document.createElement("span");
          value.className = "tiny";
          value.textContent = `${formatMetricValue(area)} ${currentMetric === "rate" ? "/ 10k" : ""}`;

          const meta = document.createElement("p");
          meta.textContent = formatMetricMeta(area);

          button.append(label, value, meta);
          button.addEventListener("click", () => {
            currentAreaCode = area.areaCode;
            updateCopy(area.areaCode);

            root.dispatchEvent(
              new CustomEvent("region-map-scope", {
                bubbles: true,
                detail: {
                  scopeId: area.areaCode,
                  trigger: "quick-pick"
                }
              })
            );

            void renderMap(area.areaCode);
          });

          quickGrid.append(button);
        }
      };

      const updateSignalBand = (selectedAreaCode: string | null) => {
        if (!selectedAreaCode) {
          const metricLeader = payload.areas.reduce<AreaPayload | null>(
            (best, candidate) => (!best || getMetricValue(candidate) > getMetricValue(best) ? candidate : best),
            null
          );

          setSignalCard(
            signalLabelOne,
            signalValueOne,
            signalMetaOne,
            "Lead authority",
            metricLeader?.areaName ?? "n/a",
            metricLeader ? formatMetricMeta(metricLeader) : "no leader available"
          );
          setSignalCard(
            signalLabelTwo,
            signalValueTwo,
            signalMetaTwo,
            "Support",
            formatInteger(payload.areas.reduce((sum, area) => sum + area.supportedAsylum, 0)),
            "people on support"
          );
          setSignalCard(
            signalLabelThree,
            signalValueThree,
            signalMetaThree,
            "Authorities",
            formatInteger(payload.areas.length),
            "available for drilldown"
          );
          return;
        }

        const area = payload.areas.find((entry) => entry.areaCode === selectedAreaCode);

        if (!area) {
          updateSignalBand(null);
          return;
        }

        setSignalCard(signalLabelOne, signalValueOne, signalMetaOne, "Selected authority", area.areaName, payload.regionName);
        setSignalCard(
          signalLabelTwo,
          signalValueTwo,
          signalMetaTwo,
          "Support",
          formatInteger(area.supportedAsylum),
          "people on support"
        );
        setSignalCard(
          signalLabelThree,
          signalValueThree,
          signalMetaThree,
          currentMetric === "hotel" ? "Hotel signal" : "Pressure",
          currentMetric === "hotel"
            ? area.hotelSignalValue === 2
              ? "Named"
              : area.hotelSignalValue === 1
                ? "Flagged"
                : "None"
            : area.supportedAsylumRate === null
              ? "n/a"
              : formatNumber(area.supportedAsylumRate),
          currentMetric === "hotel" ? area.hotelSignalLabel : "per 10,000 residents"
        );
      };

      const updateFocusCard = (selectedAreaCode: string | null) => {
        if (!selectedAreaCode) {
          focusCard.hidden = true;
          return;
        }

        const area = payload.areas.find((entry) => entry.areaCode === selectedAreaCode);

        if (!area) {
          focusCard.hidden = true;
          return;
        }

        const primaryMetric = buildAreaMetricChip(area);
        focusCard.hidden = false;
        focusCard.dataset.scopeKind = "place";
        focusKicker.textContent = `${payload.regionName} authority`;
        focusTitle.textContent = area.areaName;
        focusBody.textContent = `${formatInteger(area.supportedAsylum)} on support. ${formatRateText(area.supportedAsylumRate)}. ${area.hotelSignalLabel}.`;
        setChip(focusPrimary, primaryMetric.text, primaryMetric.tone);
        setChip(focusSecondary, `${formatInteger(area.contingencyAccommodation)} contingency`);
        focusLink.hidden = false;
        focusLink.href = buildAreaHref(area.areaCode);
        focusLink.textContent = "Open place page";
      };

      const renderMap = async (selectedAreaCode: string | null) => {
        const renderId = ++renderSequence;
        const boundaryPayload = await loadBoundaryPayload(payload.boundariesUrl);

        if (renderId !== renderSequence) {
          return;
        }

        const boundaryRegion = boundaryPayload.regions[payload.regionName];

        if (!boundaryRegion) {
          return;
        }

        const metric = metricConfig[currentMetric];
        const areaMetaByCode = new Map(payload.areas.map((area) => [area.areaCode, area]));
        const values = payload.areas.map((area) => {
          if (currentMetric === "rate") {
            return area.supportedAsylumRate ?? 0;
          }

          if (currentMetric === "hotel") {
            return area.hotelSignalValue;
          }

          return area.supportedAsylum;
        });
        const minValue = Math.min(...values, 0);
        const maxValue = Math.max(...values, 1);
        const baseViewBox = `0 0 ${boundaryPayload.width} ${boundaryPayload.height}`;

        authoritySvg.innerHTML = "";
        authoritySvg.setAttribute("viewBox", baseViewBox);
        authoritySvg.setAttribute("aria-label", `${payload.regionName} authority map`);

        const baseGroup = document.createElementNS(SVG_NS, "g");
        baseGroup.setAttribute("class", "region-map-base");

        let selectedAreaPath: SVGPathElement | null = null;

        for (const area of boundaryRegion.areas) {
          const path = document.createElementNS(SVG_NS, "path");
          path.setAttribute("class", "region-map-base-region");
          path.setAttribute("d", area.path);
          baseGroup.append(path);
        }

        authoritySvg.append(baseGroup);

        for (const boundaryArea of boundaryRegion.areas) {
          const areaMeta = areaMetaByCode.get(boundaryArea.areaCode);

          if (!areaMeta) {
            continue;
          }

          const metricValue =
            currentMetric === "rate"
              ? areaMeta.supportedAsylumRate ?? 0
              : currentMetric === "hotel"
                ? areaMeta.hotelSignalValue
                : areaMeta.supportedAsylum;
          const selected = boundaryArea.areaCode === selectedAreaCode;
          const link = document.createElementNS(SVG_NS, "a");
          const path = document.createElementNS(SVG_NS, "path");
          const titleNode = document.createElementNS(SVG_NS, "title");
          const valueLabel =
            currentMetric === "rate"
              ? `${formatNumber(metricValue)} per 10,000`
              : currentMetric === "hotel"
                ? areaMeta.hotelSignalLabel
                : `${formatInteger(metricValue)} on support`;

          link.setAttribute("href", buildAreaHref(boundaryArea.areaCode));
          link.setAttribute("class", `region-map-link ${selected ? "is-selected" : ""}`);
          link.dataset.homeAuthorityScope = boundaryArea.areaCode;
          link.dataset.homeAuthorityRegion = payload.regionName;
          link.dataset.homeAuthorityLabel = boundaryArea.areaName;
          link.setAttribute("aria-label", `${boundaryArea.areaName}: ${valueLabel}. Select this authority.`);

          path.setAttribute("class", `home-authority-region ${selected ? "is-selected" : ""}`);
          path.setAttribute("d", boundaryArea.path);
          path.setAttribute("fill", getFill(metricValue, minValue, maxValue, metric.tone));
          path.setAttribute("stroke", selected ? "#F5F7FB" : "rgba(255,255,255,0.16)");
          path.setAttribute("stroke-width", selected ? "3.2" : "1.2");

          titleNode.textContent = `${boundaryArea.areaName}: ${valueLabel}`;
          link.append(titleNode, path);

          if (selected) {
            selectedAreaPath = path;
          }

          if (selected) {
            const label = document.createElementNS(SVG_NS, "text");
            label.setAttribute("x", String(boundaryArea.labelX));
            label.setAttribute("y", String(boundaryArea.labelY));
            label.setAttribute("text-anchor", "middle");
            label.setAttribute("class", "region-map-label is-active home-authority-label");
            label.textContent = boundaryArea.areaName;
            link.append(label);
          }

          link.addEventListener("click", (event) => {
            event.preventDefault();
            currentAreaCode = boundaryArea.areaCode;
            updateCopy(boundaryArea.areaCode);

            root.dispatchEvent(
              new CustomEvent("region-map-scope", {
                bubbles: true,
                detail: {
                  scopeId: boundaryArea.areaCode,
                  trigger: "click"
                }
              })
            );

            void renderMap(boundaryArea.areaCode);
          });

          authoritySvg.append(link);
        }

        if (selectedAreaCode && selectedAreaPath) {
          const selectedBounds = selectedAreaPath.getBBox();
          setAuthorityViewBox(
            authoritySvg,
            buildAuthorityViewBox(
              selectedBounds,
              boundaryPayload.width,
              boundaryPayload.height,
              getAuthorityFocusProfile(payload.regionName, selectedAreaCode)
            ),
            520
          );
        } else {
          setAuthorityViewBox(authoritySvg, parseViewBox(baseViewBox), currentAreaCode ? 420 : 0);
        }

        caption.textContent =
          selectedAreaCode && areaMetaByCode.get(selectedAreaCode)
            ? `${areaMetaByCode.get(selectedAreaCode)?.areaName} is selected on the ${payload.regionName} map.`
            : `Select one authority inside ${payload.regionName} to update the right-hand deck without leaving the region page.`;
        updateFocusCard(selectedAreaCode);
        updateSignalBand(selectedAreaCode);
        renderQuickPicks(selectedAreaCode);
      };

      const setMetric = (metricId: AuthorityMetricId) => {
        currentMetric = metricId;

        for (const button of root.querySelectorAll<HTMLButtonElement>("[data-region-authority-view]")) {
          const active = button.dataset.regionAuthorityView === metricId;
          button.classList.toggle("is-active", active);
          button.setAttribute("aria-pressed", active ? "true" : "false");
        }

        const config = metricConfig[metricId];
        legendTitle.textContent = config.title;
        legendBody.textContent = config.body;
        legendSwatch.dataset.tone = config.tone;
        root.dataset.regionAuthorityMetric = metricId;
        void renderMap(currentAreaCode);
      };

      const applyScope = async (scopeId: string, remember = true) => {
        if (!scopeId || scopeId === payload.regionName) {
          if (remember) {
            rememberScope(payload.regionName);
          } else {
            updateMapNav();
          }

          currentAreaCode = null;
          updateCopy(payload.regionName);
          await renderMap(null);
          return;
        }

        if (!payload.scopeMeta[scopeId]) {
          return;
        }

        if (remember) {
          rememberScope(scopeId);
        } else {
          updateMapNav();
        }

        currentAreaCode = scopeId;
        updateCopy(scopeId);
        await renderMap(scopeId);
      };

      root.addEventListener("home-map-set-scope", (event) => {
        const scopeId = (event as CustomEvent<{ scopeId?: string }>).detail?.scopeId;
        void applyScope(scopeId ?? payload.regionName);
      });

      backButton.addEventListener("click", () => {
        if (historyIndex === 0) {
          return;
        }

        historyIndex -= 1;
        void applyScope(scopeHistory[historyIndex] ?? payload.regionName, false);
      });

      forwardButton.addEventListener("click", () => {
        if (historyIndex >= scopeHistory.length - 1) {
          return;
        }

        historyIndex += 1;
        void applyScope(scopeHistory[historyIndex] ?? payload.regionName, false);
      });

      for (const button of root.querySelectorAll<HTMLButtonElement>("[data-region-authority-view]")) {
        button.addEventListener("click", () => {
          const metricId = button.dataset.regionAuthorityView;

          if (metricId === "rate" || metricId === "hotel") {
            setMetric(metricId);
            return;
          }

          setMetric("total");
        });
      }

      const syncResponsiveMapFit = () => {
        const preserveAspectRatio = window.matchMedia("(max-width: 560px)").matches ? "xMidYMin meet" : "xMidYMid meet";

        for (const svg of root.querySelectorAll<SVGSVGElement>("[data-region-authority-svg]")) {
          svg.setAttribute("preserveAspectRatio", preserveAspectRatio);
        }
      };

      updateCopy(payload.regionName);
      setMetric("total");
      updateMapNav();
      syncResponsiveMapFit();
      window.addEventListener("resize", syncResponsiveMapFit, { passive: true });

      const warmup = () => {
        void loadBoundaryPayload(payload.boundariesUrl).catch(() => {
          /* noop */
        });
      };

      if ("requestIdleCallback" in window) {
        (window as Window & { requestIdleCallback: (callback: () => void) => number }).requestIdleCallback(warmup);
      } else {
        globalThis.setTimeout(warmup, 800);
      }
    }
  }
</script>
