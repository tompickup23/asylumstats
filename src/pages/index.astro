---
import BaseLayout from "../layouts/BaseLayout.astro";
import DataDrawer from "../components/DataDrawer.astro";
import LocalEvidenceTimeline from "../components/LocalEvidenceTimeline.astro";
import RegionMapExplorer from "../components/RegionMapExplorer.astro";
import releases from "../data/mock/releases.json";
import { getFeaturedLocalEvidenceTimeline } from "../lib/local-evidence";
import { getPlaceDirectory } from "../lib/place-directory";
import { buildPlaceRegionMapViews } from "../lib/region-map-explorer";
import { getRegionPressureSummaries } from "../lib/route-analytics";
import { loadLocalRouteLatest, loadRouteDashboard } from "../lib/route-data";

const routeDashboard = loadRouteDashboard();
const localRouteLatest = loadLocalRouteLatest();
const placeDirectory = getPlaceDirectory();
const regionalPressure = getRegionPressureSummaries(localRouteLatest.areas);
const leadRegion = regionalPressure[0];
const rateLeader = [...regionalPressure].sort((left, right) => right.supportedAsylumRate - left.supportedAsylumRate)[0];
const leadRegionPage = placeDirectory.regions.find((region) => region.regionName === leadRegion.regionName) ?? placeDirectory.regions[0];
const hotelLeaderRegion =
  [...placeDirectory.regions].sort(
    (left, right) =>
      right.hotelLinkedPlaceCount - left.hotelLinkedPlaceCount ||
      right.namedCurrentSiteCount - left.namedCurrentSiteCount ||
      right.supportedAsylum - left.supportedAsylum
  )[0] ?? placeDirectory.regions[0];
const previewRegions = placeDirectory.regions.slice(0, 4);
const featuredPlaces = placeDirectory.featuredAreas.slice(0, 4);
const featuredLocalEvidenceTimeline = getFeaturedLocalEvidenceTimeline(4);
const homepageRegionMapViews = buildPlaceRegionMapViews(placeDirectory, regionalPressure);
const homepageStockFlowCards = routeDashboard.nationalSystemDynamics.stockFlowCards;
const homepagePostDecisionPath = routeDashboard.nationalSystemDynamics.postDecisionPath;
const frontDoorSignals = [
  {
    label: "Regional leader by total",
    value: leadRegion.regionName,
    detail: `${leadRegion.supportedAsylum.toLocaleString()} people on supported asylum across the latest published regional slice.`
  },
  {
    label: "Regional leader by rate",
    value: rateLeader.regionName,
    detail: `${rateLeader.supportedAsylumRate} per 10,000 residents. The sharpest regional load is not always the biggest raw total.`
  },
  {
    label: "Named current hotel sites in the place layer",
    value: placeDirectory.namedCurrentSiteCount.toLocaleString(),
    detail: `${hotelLeaderRegion.regionName} currently has the widest named local hotel footprint visible through public place pages.`
  }
];
const mapJourneyCards = [
  {
    kicker: "1. Read Britain first",
    title: "Use the regional map to decide where to open next",
    body: "Start with total for scale, switch to rate for intensity, and use hotel visibility only as a publication footprint of what the place layer already carries.",
    href: "#homepage-region-map",
    cta: "Use the map"
  },
  {
    kicker: "2. Open one region, then one place",
    title: "Let the region narrow the field before you read a local authority",
    body: `${leadRegionPage?.regionName ?? "The lead region"} is the first region to open, and ${leadRegionPage?.leadArea?.area.areaName ?? "its lead place"} is the first authority to read inside it.`,
    href: leadRegionPage?.regionPath ?? "/places/",
    cta: leadRegionPage ? `Open ${leadRegionPage.regionName}` : "Browse regions"
  },
  {
    kicker: "3. Keep system logic separate",
    title: "Local place pages are about stock and visibility, not throughput",
    body: routeDashboard.nationalSystemDynamics.readingNotes[0],
    href: "/routes#route-findings",
    cta: "Open system logic"
  }
];
const guidedPaths = [
  {
    kicker: "System",
    title: "Keep claims, backlog, support, appeals, and returns separate",
    body: "Use the system page when the question shifts from place pressure to national flow, churn, decisions, or post-decision outcomes.",
    href: "/routes",
    cta: "Open system"
  },
  {
    kicker: "Compare",
    title: "Use advanced filters only after the geography is clear",
    body: "The compare explorer is useful for saved filtered views and wider place sets, but it should come after the map and region pages.",
    href: "/compare",
    cta: "Open compare"
  },
  {
    kicker: "Sources",
    title: "Check what is in scope before drawing conclusions",
    body: "Use the sources page to see which regional workbook families, archived hotel inputs, and traced local tables are actually feeding the site.",
    href: "/sources",
    cta: "Open sources"
  },
  {
    kicker: "Method",
    title: "Use the publishing rules when the data looks deceptively simple",
    body: "The methodology page states the stock-vs-flow rules, evidence boundaries, and why flat local lines can still hide churn underneath.",
    href: "/methodology",
    cta: "Open methodology"
  }
];
const advancedSurfaces = [
  {
    title: "Hotels notebook",
    body: "Raw hotel watchlists, unresolved chains, and archive-led leads.",
    href: "/hotels/",
    cta: "Open hotels"
  },
  {
    title: "Money notebook",
    body: "Contract and supplier ledger when the place reading points toward public spending.",
    href: "/spending/",
    cta: "Open money"
  },
  {
    title: "Actors notebook",
    body: "Provider and owner profiles once the local place context is already clear.",
    href: "/entities/",
    cta: "Open actors"
  }
];
const systemLogicCards = [
  {
    title: "Support is quarter-end stock, not throughput",
    body: routeDashboard.nationalSystemDynamics.readingNotes[0]
  },
  {
    title: "Flat local lines can still hide churn",
    body:
      "A local line hovering around the same level does not tell you whether the same people stayed or whether inflows and exits offset each other underneath the stock count."
  },
  {
    title: "Backlog and support overlap without matching",
    body: routeDashboard.nationalSystemDynamics.readingNotes[1]
  },
  {
    title: "Appeals lag and returns are broader",
    body: `Appeals are asylum-specific but the latest machine-readable quarter is ${homepagePostDecisionPath.appeals.dataCompleteThroughLabel ?? "older"}. Returns are current to ${homepagePostDecisionPath.returns.latestQuarterLabel ?? "the latest quarter"}, but they cover all returns, not just asylum exits.`
  }
];
---

<BaseLayout
  title="asylumstats | UK asylum accountability"
  description="Place-led UK asylum accountability covering Britain by region, local authority place pages, visible hotel evidence inside places, and asylum-system logic with source-linked evidence."
>
  <section class="hero hero-single">
    <div class="hero-copy hero-frontdoor">
      <span class="kicker">Place-led asylum accountability</span>
      <h1>Start with Britain, then open one region, then one place.</h1>
      <p>
        The front door is now the Britain map. Read the regional pattern first, open a region page to narrow the
        field, then open a place page to keep count, rate, contingency accommodation, and any public hotel evidence on
        one reading surface.
      </p>
      <div class="hero-actions">
        <a class="chip accent" href="#read-this-first">Open the Britain map</a>
        <a class="chip teal" href={leadRegionPage?.regionPath ?? "/places/"}>Open top region</a>
        <a class="chip" href="/places/">Browse all regions</a>
        <a class="chip" href="/routes#route-findings">Check system logic</a>
      </div>
      <div class="chip-row">
        <span class="chip">{localRouteLatest.snapshotDate} local snapshot</span>
        <span class="chip teal">{placeDirectory.publicPlaceCount.toLocaleString()} public place pages</span>
        <span class="chip accent">{placeDirectory.hotelLinkedPlaceCount.toLocaleString()} place pages with hotel evidence</span>
      </div>
      <div class="stat-strip front-door-strip">
        {frontDoorSignals.map((item) => (
          <article class="stat-tile">
            <span class="tiny">{item.label}</span>
            <strong>{item.value}</strong>
            <p class="tiny">{item.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-anchor priority-section" id="read-this-first">
    <div class="section-head">
      <div>
        <h2>The Britain map is the front door</h2>
        <p class="lede">
          Stop guessing from one headline number. Switch between regional total, regional rate, and visible hotel
          footprint, then open the region that actually matches the question you are asking.
        </p>
      </div>
      <a class="chip accent" href={leadRegionPage?.regionPath ?? "/places/"}>Open {leadRegionPage?.regionName ?? "the lead region"}</a>
    </div>
    <RegionMapExplorer
      id="homepage-region-map"
      title="Read Britain by the right mode"
      intro="Total shows scale, rate shows intensity, and hotel visibility shows where the published place layer already carries named or unnamed hotel evidence. The selected region panel gives the next places worth opening."
      views={homepageRegionMapViews}
    />
    <div class="guide-grid">
      {mapJourneyCards.map((card) => (
        <article class="guide-card">
          <span class="chip accent">{card.kicker}</span>
          <h3>{card.title}</h3>
          <p>{card.body}</p>
          <p class="tiny">
            <a class="source-pill" href={card.href}>{card.cta}</a>
          </p>
        </article>
      ))}
    </div>
  </section>

  <section id="regional-preview" class="section section-anchor">
    <div class="section-head">
      <div>
        <h2>Regions worth opening next</h2>
        <p class="lede">
          These region pages are the cleanest next step after the Britain map. Each one narrows the field before you
          jump into an individual authority.
        </p>
      </div>
      <a class="chip accent" href="/places#regional-directory">Open the full region directory</a>
    </div>
    <div class="feature-grid">
      {previewRegions.map((region) => (
        <article class="feature-card">
          <div class="chip-row">
            <span class="chip accent">{region.regionName}</span>
            <span class="chip teal">{region.countryName}</span>
          </div>
          <h3>
            <a href={region.regionPath}>{region.regionName}</a>
          </h3>
          <p class="lede">
            {region.supportedAsylum.toLocaleString()} people on supported asylum, {region.supportedAsylumRate} per
            10,000 residents, and {region.hotelLinkedPlaceCount.toLocaleString()} place pages already carrying hotel
            evidence.
          </p>
          <div class="data-list">
            <div class="data-row">
              <span>Open this place first</span>
              <span class="data-row-value">{region.leadArea?.area.areaName ?? "No public place page yet"}</span>
            </div>
            <div class="data-row">
              <span>Named current sites visible</span>
              <span class="data-row-value">{region.namedCurrentSiteCount.toLocaleString()}</span>
            </div>
          </div>
          <p class="tiny">
            <a class="source-pill" href={region.regionPath}>Open {region.regionName}</a>
          </p>
        </article>
      ))}
    </div>
  </section>

  <section id="featured-places" class="section section-anchor">
    <div class="section-head">
      <div>
        <h2>Open a place page when the region is clear</h2>
        <p class="lede">
          A place page is where the local count, the rate, the contingency position, the stock-vs-flow warning, and any
          public hotel evidence stay together.
        </p>
      </div>
      <a class="chip accent" href="/places#featured-places">Open more place pages</a>
    </div>
    <div class="place-grid">
      {featuredPlaces.map((row) => (
        <article class="place-card">
          <div class="chip-row">
            <span class="chip">{row.area.regionName}</span>
            <span class="chip teal">UK rank {row.nationalRank.toLocaleString()}</span>
            {row.hotelSignal !== "none" && (
              <span class:list={["chip", row.hotelSignal === "named" ? "accent" : "warm"]}>
                {row.hotelSignal === "named" ? "Named hotel evidence" : "Unnamed hotel evidence"}
              </span>
            )}
          </div>
          <h3>
            <a href={`/places/${row.area.areaCode}/`}>{row.area.areaName}</a>
          </h3>
          <p class="lede">
            {row.area.supportedAsylum.toLocaleString()} people on asylum support at quarter end, with{" "}
            {row.area.contingencyAccommodation.toLocaleString()} in contingency accommodation.
          </p>
          <p class="tiny">
            Rate {row.area.supportedAsylumRate ?? "n/a"} per 10,000 residents. Hotels: {row.hotelSummary}.
          </p>
        </article>
      ))}
    </div>
  </section>

  {featuredLocalEvidenceTimeline.length > 0 && (
    <section id="local-evidence" class="section section-anchor">
      <div class="section-head">
        <div>
          <h2>Named local evidence over time</h2>
          <p class="lede">
            This is the honest lower-level layer: dated named public hotel evidence. It is not a complete town map and
            it does not claim site-level coverage outside these evidence-backed rows.
          </p>
        </div>
        <span class="chip accent">Named public sites only</span>
      </div>
      <LocalEvidenceTimeline items={featuredLocalEvidenceTimeline} showRegionChip={true} />
    </section>
  )}

  <section class="section section-anchor" id="system-logic">
    <div class="section-head">
      <div>
        <h2>Keep the system logic alongside the place layer</h2>
        <p class="lede">
          Place pages are local stock and visibility surfaces. Use the system page when the question shifts to claims,
          backlog, decisions, appeals, or returns.
        </p>
      </div>
      <a class="chip accent" href="/routes#post-decision-path">Open the stock-flow model</a>
    </div>
    <div class="stat-strip">
      {homepageStockFlowCards.map((item) => (
        <article class="stat-tile">
          <span class="tiny">{item.label}</span>
          <strong>{item.valueSuffix ? `${item.value}${item.valueSuffix}` : item.value.toLocaleString()}</strong>
          <p class="tiny">{item.period}</p>
        </article>
      ))}
    </div>
    <div class="story-grid" style="margin-top: 1rem;">
      {systemLogicCards.map((card) => (
        <article class="story-card">
          <h3>{card.title}</h3>
          <p class="lede">{card.body}</p>
        </article>
      ))}
    </div>
  </section>

  <DataDrawer
    id="home-background"
    label="Beyond the map"
    title="Open the wider system and deeper notebooks"
    summary="The map, the region page, and the place page should answer most first questions. Use this section when you need system logic, source scope, or the raw notebooks behind the place layer."
  >
    <section class="section">
      <div class="section-head">
        <div>
          <h2>If the Britain map is not enough</h2>
          <p class="lede">These pages explain the system or the data scope without taking over the front door.</p>
        </div>
      </div>
      <div class="guide-grid">
        {guidedPaths.map((path) => (
          <article class="guide-card">
            <div class="chip-row">
              <span class="chip accent">{path.kicker}</span>
            </div>
            <h3>{path.title}</h3>
            <p>{path.body}</p>
            <p class="tiny">
              <a class="source-pill" href={path.href}>{path.cta}</a>
            </p>
          </article>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <div>
          <h2>Raw notebooks</h2>
          <p class="lede">These are still useful, but they now sit behind the place-led journey rather than in front of it.</p>
        </div>
      </div>
      <div class="guide-grid">
        {advancedSurfaces.map((surface) => (
          <article class="guide-card">
            <h3>{surface.title}</h3>
            <p>{surface.body}</p>
            <p class="tiny">
              <a class="source-pill" href={surface.href}>{surface.cta}</a>
            </p>
          </article>
        ))}
      </div>
    </section>

    <section class="section">
      <h2>Release diary</h2>
      <div class="story-grid">
        {releases.map((release) => (
          <article class="story-card">
            <div class="chip-row">
              <span class="chip">{release.date}</span>
            </div>
            <h3>{release.title}</h3>
            <p class="lede">{release.summary}</p>
            <p class="tiny">
              <a class="source-pill" href={release.sourceUrl}>Source</a>
            </p>
          </article>
        ))}
      </div>
    </section>
  </DataDrawer>
</BaseLayout>
