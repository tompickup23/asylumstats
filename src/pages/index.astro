---
import BaseLayout from "../layouts/BaseLayout.astro";
import DataDrawer from "../components/DataDrawer.astro";
import PageGuide from "../components/PageGuide.astro";
import RegionTileMap from "../components/RegionTileMap.astro";
import releases from "../data/mock/releases.json";
import { getPlaceDirectory } from "../lib/place-directory";
import { getRegionPressureSummaries } from "../lib/route-analytics";
import { loadLocalRouteLatest, loadRouteDashboard } from "../lib/route-data";

const routeDashboard = loadRouteDashboard();
const localRouteLatest = loadLocalRouteLatest();
const placeDirectory = getPlaceDirectory();
const regionalPressure = getRegionPressureSummaries(localRouteLatest.areas);
const leadRegion = regionalPressure[0];
const rateLeader = [...regionalPressure].sort((left, right) => right.supportedAsylumRate - left.supportedAsylumRate)[0];
const leadRegionPage = placeDirectory.regions.find((region) => region.regionName === leadRegion.regionName) ?? placeDirectory.regions[0];
const rateLeaderPage = placeDirectory.regions.find((region) => region.regionName === rateLeader.regionName) ?? null;
const previewRegions = placeDirectory.regions.slice(0, 4);
const featuredPlaces = placeDirectory.featuredAreas.slice(0, 6);
const homepageStockFlowCards = routeDashboard.nationalSystemDynamics.stockFlowCards;
const homepagePostDecisionPath = routeDashboard.nationalSystemDynamics.postDecisionPath;
const heroStats = [
  {
    label: "Public place pages",
    value: placeDirectory.publicPlaceCount.toLocaleString(),
    detail: `Local-authority pages in the ${localRouteLatest.snapshotDate} snapshot.`
  },
  {
    label: "Regions covered",
    value: placeDirectory.regions.length.toLocaleString(),
    detail: "Grouped first as regions, then opened as place pages."
  },
  {
    label: "Place pages with hotel evidence",
    value: placeDirectory.hotelLinkedPlaceCount.toLocaleString(),
    detail: "Named or unnamed hotel evidence folded into the local page."
  },
  {
    label: "Named current hotel sites",
    value: placeDirectory.namedCurrentSiteCount.toLocaleString(),
    detail: "Visible through the place layer instead of the homepage."
  }
];
const homepagePriorityCards = [
  {
    kicker: "Regional view",
    title: `${leadRegion.regionName} is the first region to open`,
    body: `${leadRegion.supportedAsylum.toLocaleString()} people are on supported asylum across the region, with ${leadRegion.contingencyAccommodation.toLocaleString()} in contingency accommodation.`,
    detail:
      previewRegions[0]?.leadArea
        ? `${previewRegions[0].leadArea.area.areaName} is the clearest current place page to open first inside that regional field.`
        : "Regional totals should come before a single local headline.",
    href: leadRegionPage?.regionPath ?? "/places/",
    cta: leadRegionPage ? `Open ${leadRegionPage.regionName}` : "Browse regions"
  },
  {
    kicker: "Local reading",
    title: "Place pages now carry the main local accountability load",
    body: `${placeDirectory.hotelLinkedPlaceCount.toLocaleString()} public place pages already carry hotel evidence, and ${placeDirectory.unnamedOnlyPlaceCount.toLocaleString()} still sit in unnamed-only hotel visibility gaps.`,
    detail: "Open a place page to keep count, rate, contingency use, and hotel visibility on one surface.",
    href: leadRegionPage?.regionPath ?? "/places/",
    cta: "Open place leaders"
  },
  {
    kicker: "System logic",
    title: "Claims, backlog, support, appeals, and returns stay separate",
    body: routeDashboard.nationalSystemDynamics.readingNotes[0],
    detail: `Appeals are only complete through ${homepagePostDecisionPath.appeals.dataCompleteThroughLabel ?? "the latest available quarter"}, while returns remain broader than asylum exits alone.`,
    href: "/routes#route-findings",
    cta: "Open system"
  }
];
const homepageGuideItems = [
  {
    eyebrow: "Map first",
    title: "Start with the regional map",
    body: "Use the region totals and rates to see where pressure sits before you decide which authority to open.",
    href: "#place-map",
    cta: "Open the map"
  },
  {
    eyebrow: "Then go local",
    title: "Open a place page, not a side notebook",
    body: "The place page is now the main route for local accountability because it holds the local claim, the stock logic, and the hotel line together.",
    href: "#featured-places",
    cta: "Open place leaders"
  },
  {
    eyebrow: "Keep it honest",
    title: "Use the system page when you need flow, churn, or backlog context",
    body: "The place layer is about local stock and visibility. Use the system page when the question shifts to claims, decisions, appeals, or returns.",
    href: "#system-logic",
    cta: "Open system logic"
  }
];
const guidedPaths = [
  {
    kicker: "Place map",
    title: "Browse regions and places",
    body: "The new front door is geographic: map first, region cards second, and place pages third.",
    href: "/places",
    cta: "Open places"
  },
  {
    kicker: "System",
    title: "Keep stock and flow separate",
    body: "Use the system page for claims, backlog, support, appeals, and returns once the geography is clear.",
    href: "/routes",
    cta: "Open system"
  },
  {
    kicker: "Sources",
    title: "Check source scope and regional feeds",
    body: "Use the source ledger to see where the place data comes from and which regional workbook families are in scope.",
    href: "/sources",
    cta: "Open sources"
  },
  {
    kicker: "Method",
    title: "Check the publishing rules",
    body: "Use the methodology page when you need the boundary between stock, visibility, route specificity, and publishable evidence.",
    href: "/methodology",
    cta: "Open methodology"
  }
];
const systemLogicCards = [
  {
    title: "Support is quarter-end stock, not throughput",
    body: routeDashboard.nationalSystemDynamics.readingNotes[0]
  },
  {
    title: "Flat local lines can still hide churn",
    body:
      "A local line hovering around the same level does not tell you whether the same people stayed or whether inflows and exits offset each other underneath the stock count."
  },
  {
    title: "Backlog and support overlap without matching",
    body: routeDashboard.nationalSystemDynamics.readingNotes[1]
  },
  {
    title: "Appeals lag and returns are broader",
    body: `Appeals are asylum-specific but the latest machine-readable quarter is ${homepagePostDecisionPath.appeals.dataCompleteThroughLabel ?? "older"}. Returns are current to ${homepagePostDecisionPath.returns.latestQuarterLabel ?? "the latest quarter"}, but they cover all returns, not just asylum exits.`
  }
];
const advancedSurfaces = [
  {
    title: "Compare",
    body: "Advanced filtered place explorer for query-state views once the map and directory are already clear.",
    href: "/compare/",
    cta: "Open compare"
  },
  {
    title: "Hotels",
    body: "Raw hotel notebook for unresolved chains, archive-led leads, and the wider named-site ledger.",
    href: "/hotels/",
    cta: "Open hotels"
  },
  {
    title: "Money",
    body: "Contract and supplier notebook for disclosed spending rows and linked site trails.",
    href: "/spending/",
    cta: "Open money"
  },
  {
    title: "Actors",
    body: "Provider and owner profile notebook for named-actor chains and entity timelines.",
    href: "/entities/",
    cta: "Open actors"
  }
];
---

<BaseLayout
  title="asylumstats | UK asylum accountability"
  description="Place-led UK asylum accountability covering regions, local authorities, hotel visibility inside place pages, and asylum-system logic with source-linked evidence."
>
  <section class="hero">
    <div class="hero-copy">
      <span class="kicker">Place-led asylum accountability</span>
      <h1>Start with the map, then the place.</h1>
      <p>
        The front door is now geographic. Start with the regional map, open a place page to read local pressure
        properly, and only then drop into the deeper hotel, money, or actor notebooks if the place layer no longer
        answers the question.
      </p>
      <div class="hero-actions">
        <a class="chip accent" href="/places#place-map">Browse the map</a>
        <a class="chip teal" href={leadRegionPage?.regionPath ?? "/places/"}>Open top region</a>
        <a class="chip" href="/routes#route-findings">Check the system</a>
        <a class="chip" href="/sources">Check the sources</a>
      </div>
      <div class="chip-row">
        <span class="chip">{localRouteLatest.snapshotDate} local snapshot</span>
        <span class="chip teal">{placeDirectory.publicPlaceCount.toLocaleString()} public place pages</span>
        <span class="chip accent">{placeDirectory.hotelLinkedPlaceCount.toLocaleString()} place pages with hotel evidence</span>
      </div>
    </div>

    <aside class="hero-panel">
      <div class="hero-panel-header">
        <div>
          <span class="tiny">New front door</span>
          <span class="hero-panel-title">Regions first, place pages second, system logic alongside.</span>
        </div>
        <span class="chip">{localRouteLatest.snapshotDate}</span>
      </div>

      <div class="hero-stat-grid">
        {heroStats.map((item) => (
          <article class="hero-stat">
            <span class="tiny">{item.label}</span>
            <strong>{item.value}</strong>
            <p class="tiny">{item.detail}</p>
          </article>
        ))}
      </div>

      <article class="hero-callout">
        <span class="tiny">Regional total leader</span>
        <strong>{leadRegion.regionName}</strong>
        <p class="lede">
          {leadRegion.supportedAsylum.toLocaleString()} people on supported asylum, with{" "}
          {leadRegion.contingencyAccommodation.toLocaleString()} in contingency accommodation.
        </p>
        {leadRegionPage && (
          <p class="tiny">
            <a class="source-pill" href={leadRegionPage.regionPath}>Open {leadRegionPage.regionName}</a>
          </p>
        )}
      </article>

      <article class="hero-callout accent">
        <span class="tiny">Regional rate leader</span>
        <strong>{rateLeader.regionName}</strong>
        <p class="lede">{rateLeader.supportedAsylumRate} per 10,000 residents in the latest weighted regional view.</p>
        {rateLeaderPage && (
          <p class="tiny">
            <a class="source-pill" href={rateLeaderPage.regionPath}>Open {rateLeaderPage.regionName}</a>
          </p>
        )}
      </article>
    </aside>
  </section>

  <section class="section section-anchor priority-section" id="read-this-first">
    <div class="section-head">
      <div>
        <h2>Read this first</h2>
        <p class="lede">
          The homepage now starts with geography and reading rules. Hotel, money, and actor notebooks still exist, but
          they no longer sit in front of the place layer.
        </p>
      </div>
      <a class="chip accent" href="/places">Open the place-led front door</a>
    </div>
    <div class="feature-grid">
      {homepagePriorityCards.map((card, index) => (
        <article class="feature-card priority-card accent">
          <span class="priority-rank">{String(index + 1).padStart(2, "0")}</span>
          <div class="chip-row">
            <span class="chip accent">{card.kicker}</span>
          </div>
          <h3>{card.title}</h3>
          <p class="lede">{card.body}</p>
          <p class="tiny">{card.detail}</p>
          <p class="tiny">
            <a class="source-pill" href={card.href}>{card.cta}</a>
          </p>
        </article>
      ))}
    </div>
  </section>

  <PageGuide
    id="start-here"
    title="Use the site in three moves"
    intro="A good session now starts broad, then goes local, then reaches for the system page when you need to interpret churn, backlog, appeals, or returns."
    items={homepageGuideItems}
  />

  <section id="place-map" class="section section-anchor">
    <div class="section-head">
      <div>
        <h2>Start with the regional map</h2>
        <p class="lede">
          This is now a clickable map of Britain with the published UK regions. Use total and rate together, then open a
          region directly from the map before narrowing into one authority.
        </p>
      </div>
      <a class="chip accent" href={leadRegionPage?.regionPath ?? "/places/"}>Open the lead region</a>
    </div>
    <div class="viz-grid">
      <RegionTileMap
        items={regionalPressure.map((region) => ({ regionName: region.regionName, value: region.supportedAsylum }))}
        title="Supported asylum by region"
        description={`${leadRegion.regionName} currently has the largest regional supported-asylum total in the live local-authority snapshot.`}
        valueLabel="supported asylum total"
        highlightRegion={leadRegion.regionName}
      />
      <RegionTileMap
        items={regionalPressure.map((region) => ({ regionName: region.regionName, value: region.supportedAsylumRate }))}
        title="Supported asylum rate by region"
        description={`${rateLeader.regionName} currently has the highest weighted regional rate per 10,000 residents.`}
        valueLabel="rate per 10,000"
        highlightRegion={rateLeader.regionName}
        tone="teal"
      />
    </div>
  </section>

  <section id="regional-preview" class="section section-anchor">
    <div class="section-head">
      <div>
        <h2>Then open a region</h2>
        <p class="lede">
          These are the first region cards to open if you want the strongest current public place pages without dropping
          straight into every notebook.
        </p>
      </div>
      <a class="chip accent" href="/places#regional-directory">Open all regions</a>
    </div>
    <div class="feature-grid">
      {previewRegions.map((region) => (
        <article class="feature-card">
          <div class="chip-row">
            <span class="chip accent">{region.regionName}</span>
            <span class="chip teal">{region.countryName}</span>
            <span class="chip">{region.publicPlaceCount.toLocaleString()} place pages</span>
          </div>
          <h3>
            <a href={region.regionPath}>{region.regionName}</a>
          </h3>
          <p class="lede">
            {region.supportedAsylum.toLocaleString()} people on supported asylum across the region, at {region.supportedAsylumRate} per 10,000 residents.
          </p>
          <div class="data-list">
            <div class="data-row">
              <span>Lead place to open first</span>
              <span class="data-row-value">{region.leadArea?.area.areaName ?? "No public place page yet"}</span>
            </div>
            <div class="data-row">
              <span>Place pages with hotel evidence</span>
              <span class="data-row-value">{region.hotelLinkedPlaceCount.toLocaleString()}</span>
            </div>
          </div>
          <div class="chip-row">
            {region.areas.slice(0, 3).map((row) => (
              <a class="source-pill" href={`/places/${row.area.areaCode}/`}>{row.area.areaName}</a>
            ))}
          </div>
          <p class="tiny">
            <a class="source-pill" href={region.regionPath}>Open {region.regionName}</a>
          </p>
        </article>
      ))}
    </div>
  </section>

  <section id="featured-places" class="section section-anchor">
    <div class="section-head">
      <div>
        <h2>Featured place pages</h2>
        <p class="lede">
          Open a place page when you need the local finding, the stock logic, and any public hotel evidence in one place.
        </p>
      </div>
      <a class="chip accent" href="/places#featured-places">Open more place pages</a>
    </div>
    <div class="place-grid">
      {featuredPlaces.map((row) => (
        <article class="place-card">
          <div class="chip-row">
            <span class="chip">{row.area.regionName}</span>
            <span class="chip teal">UK rank {row.nationalRank.toLocaleString()}</span>
            {row.hotelSignal !== "none" && (
              <span class:list={["chip", row.hotelSignal === "named" ? "accent" : "warm"]}>
                {row.hotelSignal === "named" ? "Named hotel evidence" : "Unnamed hotel evidence"}
              </span>
            )}
          </div>
          <h3>
            <a href={`/places/${row.area.areaCode}/`}>{row.area.areaName}</a>
          </h3>
          <p class="lede">
            {row.area.supportedAsylum.toLocaleString()} people on asylum support at quarter end, with{" "}
            {row.area.contingencyAccommodation.toLocaleString()} in contingency accommodation.
          </p>
          <p class="tiny">
            Rate {row.area.supportedAsylumRate ?? "n/a"} per 10,000 residents. Hotels: {row.hotelSummary}.
          </p>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-anchor" id="system-logic">
    <div class="section-head">
      <div>
        <h2>Keep the system logic alongside the place layer</h2>
        <p class="lede">
          Place pages are local stock and visibility surfaces. Use the system page when the question shifts to claims,
          backlog, decisions, appeals, or returns.
        </p>
      </div>
      <a class="chip accent" href="/routes#post-decision-path">Open the full stock-flow model</a>
    </div>
    <div class="stat-strip">
      {homepageStockFlowCards.map((item) => (
        <article class="stat-tile">
          <span class="tiny">{item.label}</span>
          <strong>{item.valueSuffix ? `${item.value}${item.valueSuffix}` : item.value.toLocaleString()}</strong>
          <p class="tiny">{item.period}</p>
        </article>
      ))}
    </div>
    <div class="story-grid" style="margin-top: 1rem;">
      {systemLogicCards.map((card) => (
        <article class="story-card">
          <h3>{card.title}</h3>
          <p class="lede">{card.body}</p>
        </article>
      ))}
    </div>
  </section>

  <DataDrawer
    id="home-background"
    label="Advanced notebooks"
    title="Open the secondary pages and release diary"
    summary="Hotels, money, actors, and the advanced compare surface still exist, but they now sit behind the map-first place layer."
  >
    <section class="section">
      <div class="section-head">
        <div>
          <h2>Secondary pages</h2>
          <p class="lede">
            These are still useful, but they are no longer the first thing a reader has to decode when arriving on the site.
          </p>
        </div>
      </div>
      <div class="guide-grid">
        {advancedSurfaces.map((surface) => (
          <article class="guide-card">
            <h3>{surface.title}</h3>
            <p>{surface.body}</p>
            <p class="tiny">
              <a class="source-pill" href={surface.href}>{surface.cta}</a>
            </p>
          </article>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <div>
          <h2>Choose the page you need</h2>
          <p class="lede">These are the remaining routes once the map, region cards, and place pages are already clear.</p>
        </div>
      </div>
      <div class="guide-grid">
        {guidedPaths.map((path) => (
          <article class="guide-card">
            <div class="chip-row">
              <span class="chip accent">{path.kicker}</span>
            </div>
            <h3>{path.title}</h3>
            <p>{path.body}</p>
            <p class="tiny">
              <a class="source-pill" href={path.href}>{path.cta}</a>
            </p>
          </article>
        ))}
      </div>
    </section>

    <section class="section">
      <h2>Release diary</h2>
      <div class="story-grid">
        {releases.map((release) => (
          <article class="story-card">
            <div class="chip-row">
              <span class="chip">{release.date}</span>
            </div>
            <h3>{release.title}</h3>
            <p class="lede">{release.summary}</p>
            <p class="tiny">
              <a class="source-pill" href={release.sourceUrl}>Source</a>
            </p>
          </article>
        ))}
      </div>
    </section>
  </DataDrawer>
</BaseLayout>
