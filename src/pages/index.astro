---
import HomeSystemDeck from "../components/HomeSystemDeck.astro";
import RegionMapExplorer from "../components/RegionMapExplorer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPlaceDirectory } from "../lib/place-directory";
import { buildPlaceRegionMapViews } from "../lib/region-map-explorer";
import { getRegionPressureSummaries } from "../lib/route-analytics";
import { loadLocalRouteLatest, loadRouteDashboard } from "../lib/route-data";

const routeDashboard = loadRouteDashboard();
const localRouteLatest = loadLocalRouteLatest();
const placeDirectory = getPlaceDirectory();
const regionalPressure = getRegionPressureSummaries(localRouteLatest.areas);
const homepageRegionMapViews = buildPlaceRegionMapViews(placeDirectory, regionalPressure);
const latestQuarter = routeDashboard.nationalSystemDynamics.latestQuarter;
const regionalByTotal = [...placeDirectory.regions].sort(
  (left, right) => right.supportedAsylum - left.supportedAsylum || left.regionName.localeCompare(right.regionName)
);
const regionalByRate = [...placeDirectory.regions].sort(
  (left, right) =>
    right.supportedAsylumRate - left.supportedAsylumRate || right.supportedAsylum - left.supportedAsylum
);
const regionalByHotel = [...placeDirectory.regions].sort(
  (left, right) =>
    right.hotelLinkedPlaceCount - left.hotelLinkedPlaceCount ||
    right.namedCurrentSiteCount - left.namedCurrentSiteCount ||
    right.supportedAsylum - left.supportedAsylum
);
const leadRegion = regionalByTotal[0];
const leadHotelRegion = regionalByHotel[0];
const leadRateRegion = regionalByRate[0];
const hotelShare = latestQuarter.hotelShareOfSupportPct ?? 0;
const nationalScopeId = "national";

type HomeEntry = {
  scopeId: string;
  parentScopeId?: string;
  parentLabel?: string;
  eyebrow: string;
  title: string;
  note: string;
  ctaLabel: string;
  ctaHref: string;
  linksLabel: string;
  stats: Array<{
    label: string;
    value: string;
    context: string;
  }>;
  links: Array<{
    label: string;
    href: string;
    meta: string;
    scopeId?: string;
    actionLabel?: string;
  }>;
  visualIntro: string;
  visualGroups: Array<{
    title: string;
    bars: Array<{
      label: string;
      value: string;
      meta: string;
      widthPct: number;
      tone: "accent" | "teal" | "warm" | "slate";
    }>;
  }>;
};

function formatInteger(value: number): string {
  return value.toLocaleString();
}

function formatNumber(value: number): string {
  return new Intl.NumberFormat("en-GB", {
    minimumFractionDigits: Number.isInteger(value) ? 0 : 2,
    maximumFractionDigits: Number.isInteger(value) ? 0 : 2
  }).format(value);
}

function formatRate(value: number | null | undefined): string {
  if (value === null || value === undefined) {
    return "n/a";
  }

  return `${formatNumber(value)} per 10,000`;
}

function formatPct(value: number): string {
  return `${formatNumber(value)}%`;
}

function buildBar(
  label: string,
  value: number,
  scale: number,
  tone: "accent" | "teal" | "warm" | "slate",
  meta: string
) {
  return {
    label,
    value: Number.isInteger(value) ? formatInteger(value) : formatNumber(value),
    meta,
    widthPct: scale > 0 ? (value / scale) * 100 : 0,
    tone
  };
}

function buildAreaPath(areaCode: string): string {
  return `/places/${areaCode}/`;
}

function describeHotelSignal(row: (typeof placeDirectory.regions)[number]["areas"][number]): string {
  if (row.hotelSignal === "named") {
    return `${row.namedCurrentSiteCount} named current hotel site${row.namedCurrentSiteCount === 1 ? "" : "s"} visible`;
  }

  if (row.hotelSignal === "unnamed") {
    return `${row.unnamedSiteCount} unnamed acknowledged hotel site${row.unnamedSiteCount === 1 ? "" : "s"}`;
  }

  return "No named current hotel site visible";
}

function buildRegionPreviewRows(region: (typeof placeDirectory.regions)[number]) {
  const uniqueRows = new Map<string, (typeof region.areas)[number]>();
  const byRate = [...region.areas].sort(
    (left, right) =>
      (right.area.supportedAsylumRate ?? 0) - (left.area.supportedAsylumRate ?? 0) ||
      right.area.supportedAsylum - left.area.supportedAsylum
  );
  const hotelRows = region.areas.filter((row) => row.hotelSignal !== "none");

  for (const row of [...region.areas, ...byRate, ...hotelRows]) {
    if (!uniqueRows.has(row.area.areaCode)) {
      uniqueRows.set(row.area.areaCode, row);
    }

    if (uniqueRows.size >= 3) {
      break;
    }
  }

  return [...uniqueRows.values()];
}

function buildAreaNote(row: (typeof placeDirectory.regions)[number]["areas"][number]) {
  const area = row.area;

  if (row.hotelSignal === "named") {
    return `${area.areaName} currently has ${formatInteger(area.supportedAsylum)} people on supported asylum, with ${formatInteger(area.contingencyAccommodation)} in contingency accommodation and ${row.namedCurrentSiteCount} named current hotel site${row.namedCurrentSiteCount === 1 ? "" : "s"} visible.`;
  }

  if (row.hotelSignal === "unnamed") {
    return `${area.areaName} currently has ${formatInteger(area.supportedAsylum)} people on supported asylum, with ${formatInteger(area.contingencyAccommodation)} in contingency accommodation. The place page already carries unnamed hotel evidence, but the public chain still stops short of a named current site.`;
  }

  return `${area.areaName} currently has ${formatInteger(area.supportedAsylum)} people on supported asylum, with ${formatInteger(area.contingencyAccommodation)} in contingency accommodation. No named current hotel site is publicly visible in the place layer yet.`;
}

const priorityRegions = (() => {
  const seen = new Set<string>();
  const picks: (typeof placeDirectory.regions)[number][] = [];

  for (const candidate of [leadRegion, leadRateRegion, leadHotelRegion, ...regionalByTotal]) {
    if (!candidate || seen.has(candidate.regionName)) {
      continue;
    }

    picks.push(candidate);
    seen.add(candidate.regionName);

    if (picks.length >= 3) {
      break;
    }
  }

  return picks;
})();

const homeEntries: Record<string, HomeEntry> = {
  [nationalScopeId]: {
    scopeId: nationalScopeId,
    eyebrow: `National snapshot | ${latestQuarter.stockPeriodLabel ?? latestQuarter.quarterLabel ?? localRouteLatest.snapshotDate}`,
    title: "Britain now",
    note: `${formatInteger(latestQuarter.supportedAsylum)} people were on supported asylum at ${latestQuarter.stockPeriodLabel ?? "the latest stock point"}. Start with Britain, then narrow to one region and one local authority.`,
    ctaLabel: "Open system logic",
    ctaHref: "/routes#route-findings",
    linksLabel: "Start with these regions",
    stats: [
      {
        label: "Supported asylum",
        value: formatInteger(latestQuarter.supportedAsylum),
        context: `Stock | ${latestQuarter.stockPeriodLabel ?? "latest stock point"}`
      },
      {
        label: "Awaiting decision",
        value: formatInteger(latestQuarter.awaitingInitialDecision),
        context: "Initial-decision stock"
      },
      {
        label: "Hotel accommodation",
        value: formatInteger(latestQuarter.hotelAccommodation),
        context: `${formatPct(hotelShare)} of support`
      },
      {
        label: "Public place pages",
        value: formatInteger(placeDirectory.publicPlaceCount),
        context: `${formatInteger(placeDirectory.regions.length)} regions in the place layer`
      }
    ],
    links: priorityRegions.map((region) => ({
      label: region.regionName,
      href: region.regionPath,
      meta: `${formatInteger(region.supportedAsylum)} on support | ${formatRate(region.supportedAsylumRate)}`,
      scopeId: region.regionName,
      actionLabel: "Preview region"
    })),
    visualIntro:
      "The map gives geography. This deck keeps the current national stock and the regions worth opening next on one reading surface.",
    visualGroups: [
      {
        title: "National stock now",
        bars: [
          buildBar(
            "Supported asylum",
            latestQuarter.supportedAsylum,
            latestQuarter.supportedAsylum,
            "accent",
            latestQuarter.stockPeriodLabel ?? "Latest stock point"
          ),
          buildBar(
            "Awaiting decision",
            latestQuarter.awaitingInitialDecision,
            latestQuarter.supportedAsylum,
            "slate",
            "Initial-decision stock"
          ),
          buildBar(
            "Hotel accommodation",
            latestQuarter.hotelAccommodation,
            latestQuarter.supportedAsylum,
            "warm",
            `${formatPct(hotelShare)} of support`
          )
        ]
      },
      {
        title: "Largest regional totals",
        bars: regionalByTotal.slice(0, 4).map((region) =>
          buildBar(
            region.regionName,
            region.supportedAsylum,
            regionalByTotal[0]?.supportedAsylum ?? 1,
            "accent",
            `${formatInteger(region.publicPlaceCount)} place pages`
          )
        )
      }
    ]
  }
};

for (const region of placeDirectory.regions) {
  const previewRows = buildRegionPreviewRows(region);
  const rateRows = [...region.areas]
    .sort(
      (left, right) =>
        (right.area.supportedAsylumRate ?? 0) - (left.area.supportedAsylumRate ?? 0) ||
        right.area.supportedAsylum - left.area.supportedAsylum
    )
    .slice(0, 3);
  const accommodationAverage = Math.round(region.supportedAsylum / Math.max(region.publicPlaceCount, 1));

  homeEntries[region.regionName] = {
    scopeId: region.regionName,
    parentScopeId: nationalScopeId,
    parentLabel: "Britain",
    eyebrow: `${region.countryName} region`,
    title: region.regionName,
    note: `${formatInteger(region.supportedAsylum)} people are on supported asylum across ${formatInteger(region.publicPlaceCount)} public local pages here. Open one borough or district next.`,
    ctaLabel: `Open ${region.regionName}`,
    ctaHref: region.regionPath,
    linksLabel: "Then one town or borough page",
    stats: [
      {
        label: "Supported asylum",
        value: formatInteger(region.supportedAsylum),
        context: `${formatInteger(region.publicPlaceCount)} public place pages`
      },
      {
        label: "Regional rate",
        value: region.supportedAsylumRate === null ? "n/a" : formatNumber(region.supportedAsylumRate),
        context: "Supported asylum per 10,000 residents"
      },
      {
        label: "Contingency",
        value: formatInteger(region.contingencyAccommodation),
        context: "People in contingency accommodation"
      },
      {
        label: "Hotel visibility",
        value: formatInteger(region.hotelLinkedPlaceCount),
        context:
          region.namedCurrentSiteCount > 0
            ? `${formatInteger(region.namedCurrentSiteCount)} named current hotel sites`
            : `${formatInteger(region.unnamedOnlyPlaceCount)} unnamed-only gaps`
      }
    ],
    links: previewRows.map((row) => ({
      label: row.area.areaName,
      href: buildAreaPath(row.area.areaCode),
      meta: `${formatInteger(row.area.supportedAsylum)} on support | ${describeHotelSignal(row)}`,
      scopeId: row.area.areaCode,
      actionLabel: "Preview place"
    })),
    visualIntro:
      "Use the regional readout to decide where to narrow. Raw totals, local rates, and hotel visibility do not point to the same authority every time.",
    visualGroups: [
      {
        title: `Largest local totals in ${region.regionName}`,
        bars: region.areas.slice(0, 3).map((row) =>
          buildBar(
            row.area.areaName,
            row.area.supportedAsylum,
            region.leadArea?.area.supportedAsylum ?? 1,
            "accent",
            describeHotelSignal(row)
          )
        )
      },
      {
        title: `Sharpest rates in ${region.regionName}`,
        bars: rateRows.map((row) =>
          buildBar(
            row.area.areaName,
            row.area.supportedAsylumRate ?? 0,
            rateRows[0]?.area.supportedAsylumRate ?? 1,
            "teal",
            `${formatInteger(row.area.supportedAsylum)} on support`
          )
        )
      }
    ]
  };

  for (const row of region.areas) {
    const area = row.area;
    const localAccommodationTotal =
      area.contingencyAccommodation + area.initialAccommodation + area.dispersalAccommodation + area.subsistenceOnly;
    const regionalLead = region.leadArea?.area ?? area;
    const comparisonScale = Math.max(regionalLead.supportedAsylum, accommodationAverage, area.supportedAsylum, 1);

    homeEntries[area.areaCode] = {
      scopeId: area.areaCode,
      parentScopeId: region.regionName,
      parentLabel: region.regionName,
      eyebrow: `${region.regionName} local page`,
      title: area.areaName,
      note: buildAreaNote(row),
      ctaLabel: `Open ${area.areaName}`,
      ctaHref: buildAreaPath(area.areaCode),
      linksLabel: "Keep moving",
      stats: [
        {
          label: "Supported asylum",
          value: formatInteger(area.supportedAsylum),
          context: area.snapshotDate
        },
        {
          label: "Local rate",
          value: area.supportedAsylumRate === null ? "n/a" : formatNumber(area.supportedAsylumRate),
          context: "Supported asylum per 10,000 residents"
        },
        {
          label: "Contingency",
          value: formatInteger(area.contingencyAccommodation),
          context: "People in contingency accommodation"
        },
        {
          label: "Hotel evidence",
          value:
            row.hotelSignal === "named"
              ? `${formatInteger(row.namedCurrentSiteCount)} named`
              : row.hotelSignal === "unnamed"
                ? `${formatInteger(row.unnamedSiteCount)} unnamed`
                : "No named site",
          context: describeHotelSignal(row)
        }
      ],
      links: [
        {
          label: `Open ${area.areaName}`,
          href: buildAreaPath(area.areaCode),
          meta: "Full place page with trend, hotel, and route context"
        },
        {
          label: `Open ${region.regionName}`,
          href: region.regionPath,
          meta: "Return to the regional map and local directory"
        },
        {
          label: "Keep system logic nearby",
          href: "/routes#route-findings",
          meta: "Claims, backlog, support, decisions, appeals, and returns"
        }
      ],
      visualIntro:
        "This local page is the last narrowing step on the homepage. Use the full place page once this quick read tells you the authority is worth opening.",
      visualGroups: [
        {
          title: `Within ${region.regionName}`,
          bars: [
            buildBar(area.areaName, area.supportedAsylum, comparisonScale, "accent", "This local authority"),
            buildBar(
              regionalLead.areaName,
              regionalLead.supportedAsylum,
              comparisonScale,
              "slate",
              "Regional lead by supported asylum"
            ),
            buildBar(
              "Regional average",
              accommodationAverage,
              comparisonScale,
              "teal",
              `${formatInteger(region.publicPlaceCount)} place pages in view`
            )
          ]
        },
        {
          title: "Local accommodation mix",
          bars: [
            buildBar(
              "Contingency",
              area.contingencyAccommodation,
              localAccommodationTotal || 1,
              "warm",
              localAccommodationTotal > 0
                ? `${formatPct((area.contingencyAccommodation / localAccommodationTotal) * 100)} of the local mix`
                : "No local accommodation mix published"
            ),
            buildBar(
              "Initial",
              area.initialAccommodation,
              localAccommodationTotal || 1,
              "accent",
              "Initial accommodation"
            ),
            buildBar(
              "Dispersal",
              area.dispersalAccommodation,
              localAccommodationTotal || 1,
              "teal",
              "Dispersal accommodation"
            ),
            buildBar(
              "Subsistence only",
              area.subsistenceOnly,
              localAccommodationTotal || 1,
              "slate",
              "Support without accommodation"
            )
          ]
        }
      ]
    };
  }
}
---

<BaseLayout
  title="asylumstats | UK asylum accountability"
  description="A map-led UK asylum accountability site. Start with Britain, then open one region and one place while keeping national asylum-system logic separate."
  bodyClass="home-layout"
  mainClass="home-main"
  hideFooter={true}
>
  <section class="section section-anchor priority-section home-screen" id="read-this-first">
    <div class="home-left">
      <article class="home-map-panel" id="homepage-britain-map">
        <RegionMapExplorer
          id="homepage-region-map"
          title="Britain map"
          intro="Select a region to swap the right-hand deck from Britain to that region, then preview one local authority before opening the full page."
          views={homepageRegionMapViews}
          compact={true}
          labelMode="selected"
          interactionMode="select"
          showSummary={false}
          legendMode="overlay"
        />

        <div class="home-map-intro">
          <div class="home-map-copy">
            <span class="kicker">Place-led asylum accountability</span>
            <h1>Britain first. Then narrow.</h1>
            <p>
              Select one region on the map. The live deck on the right narrows from Britain to region to one local
              authority.
            </p>
          </div>
          <div class="chip-row home-map-meta">
            <span class="chip">{localRouteLatest.snapshotDate} local snapshot</span>
            <span class="chip teal">{placeDirectory.publicPlaceCount.toLocaleString()} public place pages</span>
            <span class="chip accent">
              {placeDirectory.hotelLinkedPlaceCount.toLocaleString()} place pages with hotel evidence
            </span>
          </div>
        </div>
      </article>
    </div>

    <aside class="home-right">
      <HomeSystemDeck entries={homeEntries} initialScopeId={nationalScopeId} targetMapId="homepage-region-map" />
    </aside>
  </section>
</BaseLayout>
