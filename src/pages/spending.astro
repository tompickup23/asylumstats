---
import BaseLayout from "../layouts/BaseLayout.astro";
import AsylumSpendLedger from "../components/AsylumSpendLedger.astro";
import PageContents from "../components/PageContents.astro";
import asylumFinance from "../data/live/asylum-finance.json";
import followMoney from "../data/live/follow-money.json";

// Only the sections that survive the starter ledger being parked. Every other entry
// pointed at an explorer, preset or profile grid built over eleven hand-curated records.
const spendingSections = [
  { id: "ho-spend-ledger", label: "Payment ledger" },
  { id: "integrity-techniques", label: "Techniques" },
  { id: "scope-rules", label: "Scope and rules" }
];
---

<BaseLayout
  image="/og/spending.png"
  title="UK asylum spending: contracts and suppliers"
  description="Public money ledger for asylum accommodation, contract scope, official tariff rows, hotel costs, and supplier exposure."
>
  <section class="page-top">
    <section class="page-head">
      <span class="kicker">Spending and contracts</span>
      <h1>Track public money, supplier exposure, and missing links.</h1>
      <p>
        Use this page to separate disclosed values, control rows, scrutiny estimates, and supplier exposure without
        collapsing unlike records into one fake total.
      </p>
    </section>

    {/*
      The live cost clock is removed, for one accuracy reason and one register reason.

      Accuracy: it accrued from £5.77M a day and told the reader "since you opened this
      page, the asylum hotel bill has cost" that much in real time. £5.77M is the 2024/25
      average (£2.1bn / 365). Hotel numbers have fallen 32% since, from 30,657 at the end
      of 2025 to 20,885 now, so the counter overstated current spend while presenting
      itself as live.

      Register: a ticking money counter is a campaign device. This site's whole
      proposition is being cited by people who do not know or care who runs it, and the
      presentation profile for it sets anger_budget to none. The clock was the single
      most campaign-coded element on the site and it sat on the money page, which is
      exactly where a sceptical reader looks for a reason to dismiss the numbers.

      The component is kept in src/components/BacklogClock.astro, so restoring it is one
      line if Tom disagrees. The daily figure itself still appears on this page and the
      homepage, sourced and with its year stated.
    */}

    <aside class="page-rail">
      {/*
        The snapshot used to count the starter ledger: eleven rows, six with values, four
        linked sites. Those are the numbers of a research stub, not of public spending,
        and printing them as the page's headline figures told a reader the Home Office
        discloses eleven things. The ledger immediately below counts 16,872 payments, so
        the rail no longer competes with it and says what the page is for instead.
      */}
      <article class="panel panel-pad">
        <span class="tiny">What this page is</span>
        <p class="rail-copy">
          The goal is not one spend total. Published payments and audited outturn are
          different measures of different things, and this page keeps them apart so the
          gap between them is visible rather than averaged away.
        </p>
        <p class="rail-copy">
          The contract, tariff and scrutiny ledger that used to sit here is held back
          until the records behind it are verified. What remains is the department's own
          payment data.
        </p>
      </article>
    </aside>
  </section>

  <PageContents title="Start here" sections={spendingSections} variant="priority" />

  <AsylumSpendLedger />

  <section id="integrity-techniques" class="section section-anchor">
    <h2>Integrity techniques</h2>
    <div class="story-grid">
      {followMoney.integrityTechniques.map((technique) => (
        <article class="story-card">
          <div class="chip-row">
            <span class="chip accent">{technique.category}</span>
          </div>
          <h3>{technique.label}</h3>
          <p class="lede">{technique.description}</p>
          <p class="tiny">{technique.origin}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="scope-rules" class="split section section-anchor">
    <div class="panel panel-pad">
      <h2>Scope and publish rules</h2>
      <div class="signal-list">
        {asylumFinance.scopeRules.map((rule) => (
          <article class="signal-card">
            <div class="chip-row">
              <span class={`chip ${rule.id === "route_specific" ? "accent" : rule.id === "local_route_relevant" ? "teal" : ""}`}>
                {rule.label}
              </span>
            </div>
            <p class="tiny">{rule.description}</p>
          </article>
        ))}
        {followMoney.publishRules.map((rule) => (
          <article class="signal-card accent">
            <span class="tiny">Publish rule</span>
            <p class="tiny">{rule}</p>
          </article>
        ))}
      </div>
    </div>

    <div class="panel panel-pad">
      <h2>Inclusion rules</h2>
      <div class="signal-list">
        {asylumFinance.inclusionTests.map((rule) => (
          <article class="signal-card">
            <span class="tiny">Inclusion test</span>
            <p class="tiny">{rule}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
