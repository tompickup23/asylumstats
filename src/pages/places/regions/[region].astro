---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import DataFreshness from "../../../components/DataFreshness.astro";
import { ROUTES_RELEASE_DATE, ROUTES_RELEASE_PAGE } from "../../../lib/data-releases";
import PlainEnglish from "../../../components/PlainEnglish.astro";
import RegionAuthorityList from "../../../components/RegionAuthorityList.astro";
import { buildAbsoluteUrl, breadcrumbListNode, regionNameInSentence, buildPublicPlaceRegionSlug } from "../../../lib/site";
import { getPlaceDirectory, type PlaceDirectoryRegion } from "../../../lib/place-directory";
import { loadLocalRouteLatest } from "../../../lib/route-data";
import { buildPlaceTitle } from "../../../lib/serp";
import { meanWhiteBritishShare } from "../../../lib/ethnic-projections";
import { regionalCostSummary, AREA_COST_SOURCES } from "../../../lib/area-cost";

const localRouteLatest = loadLocalRouteLatest();

export function getStaticPaths() {
  return getPlaceDirectory().regions.map((region) => ({
    params: { region: region.regionSlug },
    props: { region }
  }));
}

const { region } = Astro.props as { region: PlaceDirectoryRegion };

// Sort areas by asylum support (descending)
const areasSorted = [...region.areas].sort((a, b) => b.area.supportedAsylum - a.area.supportedAsylum);
const totalRegional = region.supportedAsylum;
const regionalAccommodationCostLabel = regionalCostSummary(region.areas.map(row => row.area.areaCode));

// The same regional mean /regional/ prints, from the same function, so the two cannot
// drift apart. It was an inline loop over the raw projection file on both pages.
const regionShare = meanWhiteBritishShare(region.areas.map((row) => row.area.areaCode), 2051);
const regionWbi2021 = regionShare.current;
const regionWbi2051 = regionShare.projected;

// ukdemographics.co.uk publishes a regional demographic profile for the same ten regions
// this site covers in England and Wales. It has no Scotland or Northern Ireland region,
// so those two link nowhere rather than to a 404. The slugs are identical on both sites.
const DEMOGRAPHICS_REGIONS = new Set([
  "East Midlands", "East of England", "London", "North East", "North West",
  "South East", "South West", "Wales", "West Midlands", "Yorkshire and The Humber"
]);
const demographicsRegionPath = DEMOGRAPHICS_REGIONS.has(region.regionName)
  ? `https://ukdemographics.co.uk/places/regions/${buildPublicPlaceRegionSlug(region.regionName)}/`
  : null;

const pageDescription = `${region.regionName}: ${totalRegional.toLocaleString()} asylum seekers on support across ${region.areas.length} local authorities. Rate: ${region.supportedAsylumRate?.toFixed(1)} per 10,000.`;
const crumbs = [
  { label: "Places", href: "/places/" },
  { label: "Regional", href: "/regional/" },
  { label: region.regionName }
];
---

<BaseLayout
  title={buildPlaceTitle({
    areaName: regionNameInSentence(region.regionName),
    supportedAsylum: totalRegional
  })}
  brandTitle={false}
  description={pageDescription}
  structuredData={[breadcrumbListNode(crumbs, buildAbsoluteUrl(Astro.url.pathname))]}
>
  <Breadcrumbs items={crumbs} />

  <section class="page-top">
    <section class="page-head">
      <span class="kicker">{region.countryName}</span>
      <h1>{region.regionName}</h1>
      <DataFreshness
        updated={localRouteLatest.snapshotDate ?? "2026-06-30"}
        published={ROUTES_RELEASE_DATE ?? undefined}
        source="Home Office"
        sourceUrl={ROUTES_RELEASE_PAGE ?? "https://www.gov.uk/government/statistical-data-sets/immigration-system-statistics-regional-and-local-authority-data"}
      />
    </section>
    <aside class="page-rail">
      <article class="panel panel-pad">
        <div class="stat-strip">
          <article class="stat-tile">
            <span class="tiny">On support</span>
            <strong>{totalRegional.toLocaleString()}</strong>
          </article>
          <article class="stat-tile">
            <span class="tiny">Rate /10k</span>
            <strong>{region.supportedAsylumRate?.toFixed(1) ?? "-"}</strong>
          </article>
          <article class="stat-tile">
            <span class="tiny">Areas</span>
            <strong>{region.areas.length}</strong>
          </article>
          {regionWbi2021 !== null && (
            <article class="stat-tile">
              <span class="tiny">WBI 2051</span>
              <strong>{regionWbi2051?.toFixed(0)}%</strong>
            </article>
          )}
        </div>
      </article>
    </aside>
  </section>

  <PlainEnglish
    headline={`${totalRegional.toLocaleString()} people on asylum support in ${region.regionName}`}
    body={`${region.areas.length} local authorities in this region. Rate of ${region.supportedAsylumRate?.toFixed(1) ?? "-"} per 10,000 residents.${regionWbi2021 !== null ? ` Average White British share: ${regionWbi2021.toFixed(0)}% (2021) projected to ${regionWbi2051?.toFixed(0)}% by 2051.` : ""}${regionalAccommodationCostLabel}`}
    tone={totalRegional > 10000 ? "alert" : totalRegional > 3000 ? "info" : "success"}
  />
  <p class="tiny">Sources: <a href={AREA_COST_SOURCES.counts.attachment_url}>Home Office local support table</a>,
    <a href={AREA_COST_SOURCES.rates.dispersal2026.url}>nightly rates</a> and
    <a href={AREA_COST_SOURCES.support.standard.url}>cash support rates</a>.
    The component method and its exclusions are shown on each area's page.</p>

  {demographicsRegionPath && (
    <p class="reg-sibling shell">
      The population this sits in, and how it is projected to change, is on the sister
      site: <a href={demographicsRegionPath} rel="noopener">{region.regionName} on UK
      Demographics</a>. This page counts people on asylum support; that one counts everyone.
    </p>
  )}

  <!-- AREA RANKING -->
  <section class="section shell">
    <h2 class="reg-section-title">Local authorities ranked by asylum seekers on support</h2>
    <RegionAuthorityList rows={areasSorted} />
  </section>
</BaseLayout>

<style>
  .reg-sibling {
    margin: 0 auto 1.5rem;
    max-width: 62ch;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .reg-section-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text);
    margin: 0 0 1rem;
  }
</style>
