---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import DataDrawer from "../../../components/DataDrawer.astro";
import HomeSystemDeck from "../../../components/HomeSystemDeck.astro";
import LocalEvidenceTimeline from "../../../components/LocalEvidenceTimeline.astro";
import PageContents from "../../../components/PageContents.astro";
import PageGuide from "../../../components/PageGuide.astro";
import RegionAuthorityStage from "../../../components/RegionAuthorityStage.astro";
import {
  getRegionLocalEvidenceAreaSummaries,
  getRegionLocalEvidenceLayers,
  getRegionLocalEvidenceTimeline
} from "../../../lib/local-evidence";
import { getPlaceDirectory, type PlaceDirectoryRegion } from "../../../lib/place-directory";
import { buildPlaceSubregions } from "../../../lib/place-subregions";
import { loadLocalRouteLatest } from "../../../lib/route-data";

const localRouteLatest = loadLocalRouteLatest();

export function getStaticPaths() {
  return getPlaceDirectory().regions.map((region) => ({
    params: { region: region.regionSlug },
    props: { region }
  }));
}

const { region } = Astro.props as { region: PlaceDirectoryRegion };
const featuredAreas = region.areas.slice(0, 8);
const hotelLinkedAreas = region.areas.filter((row) => row.hotelSignal !== "none");
const regionLocalEvidenceLayer = getRegionLocalEvidenceLayers().find((layer) => layer.regionName === region.regionName) ?? null;
const regionLocalEvidenceAreas = getRegionLocalEvidenceAreaSummaries(region.regionName, 6);
const regionLocalEvidenceTimeline = getRegionLocalEvidenceTimeline(region.regionName, 8);
const regionSections = [
  { id: "region-findings", label: "Map" },
  { id: "region-guide", label: "How to use" },
  { id: "region-places", label: "Place leaders" },
  ...(hotelLinkedAreas.length > 0 ? [{ id: "region-hotels", label: "Hotel visibility" }] : []),
  ...(regionLocalEvidenceLayer ? [{ id: "region-local-evidence", label: "Local sites" }] : []),
  { id: "region-data", label: "Full list" }
];
const regionGuideItems = [
  {
    eyebrow: "Start here",
    title: "Use the authority map before opening any full page",
    body: "The first screen now does the narrowing work directly. Pick one authority on the map, then decide whether it is worth opening in full.",
    href: "#region-findings",
    cta: "Use the map"
  },
  {
    eyebrow: "Then go local",
    title: "Use the deck to compare the first authorities properly",
    body: "The right-hand deck keeps support, rate, contingency, and hotel visibility together while you move between authorities.",
    href: "#region-findings",
    cta: "Use the deck"
  },
  {
    eyebrow: "Only if needed",
    title: "Use the timeline and full ledger after the main decision",
    body: "Named local evidence and the full regional ledger still exist, but they now sit behind the authority stage instead of preceding it.",
    href: regionLocalEvidenceTimeline.length > 0 ? "#region-local-evidence" : "#region-data",
    cta: regionLocalEvidenceTimeline.length > 0 ? "Open the timeline" : "Open the full list"
  }
];
const pageDescription = `${region.regionName} asylum pressure by place, with regional totals, local authority leaders, and hotel visibility carried through the place layer.`;

type RegionDeckEntry = {
  scopeId: string;
  parentScopeId?: string;
  parentLabel?: string;
  eyebrow: string;
  title: string;
  note: string;
  scopeHref?: string;
  scopeActionLabel?: string;
  linksLabel: string;
  stats: Array<{
    label: string;
    value: string;
    context: string;
  }>;
  links: Array<{
    label: string;
    href: string;
    meta: string;
    scopeId?: string;
    actionLabel?: string;
  }>;
  visualIntro: string;
  visualGroups: Array<{
    title: string;
    bars: Array<{
      label: string;
      value: string;
      meta: string;
      widthPct: number;
      tone: "accent" | "teal" | "warm" | "slate";
    }>;
  }>;
};

function formatInteger(value: number): string {
  return value.toLocaleString();
}

function formatNumber(value: number): string {
  return new Intl.NumberFormat("en-GB", {
    minimumFractionDigits: Number.isInteger(value) ? 0 : 2,
    maximumFractionDigits: Number.isInteger(value) ? 0 : 2
  }).format(value);
}

function buildBar(
  label: string,
  value: number,
  scale: number,
  tone: "accent" | "teal" | "warm" | "slate",
  meta: string
) {
  return {
    label,
    value: Number.isInteger(value) ? formatInteger(value) : formatNumber(value),
    meta,
    widthPct: scale > 0 ? (value / scale) * 100 : 0,
    tone
  };
}

function buildAreaPath(areaCode: string): string {
  return `/places/${areaCode}/`;
}

function describeHotelSignalShort(row: PlaceDirectoryRegion["areas"][number]): string {
  if (row.hotelSignal === "named") {
    return "Named site visible";
  }

  if (row.hotelSignal === "unnamed") {
    return "Unnamed hotel evidence";
  }

  return "No named site visible";
}

function buildAreaNote(row: PlaceDirectoryRegion["areas"][number]) {
  const area = row.area;

  if (row.hotelSignal === "named") {
    return `${formatInteger(area.supportedAsylum)} on support. ${formatInteger(area.contingencyAccommodation)} in contingency. ${row.namedCurrentSiteCount} named hotel site${row.namedCurrentSiteCount === 1 ? "" : "s"} visible.`;
  }

  if (row.hotelSignal === "unnamed") {
    return `${formatInteger(area.supportedAsylum)} on support. ${formatInteger(area.contingencyAccommodation)} in contingency. Hotel use is visible but unnamed.`;
  }

  return `${formatInteger(area.supportedAsylum)} on support. ${formatInteger(area.contingencyAccommodation)} in contingency. No named hotel site is public yet.`;
}

const regionStageId = `region-authority-stage-${region.regionSlug}`;
const accommodationAverage = Math.round(region.supportedAsylum / Math.max(region.publicPlaceCount, 1));
const subregions = buildPlaceSubregions(region);
const rankedSubregions = [...subregions].sort(
  (left, right) =>
    right.supportedAsylum - left.supportedAsylum ||
    (right.supportedAsylumRate ?? 0) - (left.supportedAsylumRate ?? 0) ||
    left.label.localeCompare(right.label)
);
const subregionByAreaCode = new Map(
  subregions.flatMap((subregion) => subregion.areaCodes.map((areaCode) => [areaCode, subregion] as const))
);
const regionDeckEntries: Record<string, RegionDeckEntry> = {
  [region.regionName]: {
    scopeId: region.regionName,
    eyebrow: `${region.countryName} region`,
    title: region.regionName,
    note:
      subregions.length > 0
        ? `${formatInteger(region.supportedAsylum)} on support across ${formatInteger(region.publicPlaceCount)} authorities. Start with one cluster before picking an authority.`
        : `${formatInteger(region.supportedAsylum)} on support across ${formatInteger(region.publicPlaceCount)} authorities. Pick one on the map.`,
    linksLabel: subregions.length > 0 ? "Open one subregion first" : "Open one local authority",
    stats: [
      {
        label: "Supported asylum",
        value: formatInteger(region.supportedAsylum),
        context: `${formatInteger(region.publicPlaceCount)} public place pages`
      },
      {
        label: "Regional rate",
        value: region.supportedAsylumRate === null ? "n/a" : formatNumber(region.supportedAsylumRate),
        context: "Supported asylum per 10,000 residents"
      },
      {
        label: "Contingency",
        value: formatInteger(region.contingencyAccommodation),
        context: "People in contingency accommodation"
      }
    ],
    links:
      subregions.length > 0
        ? rankedSubregions.map((subregion) => ({
            label: subregion.label,
            href: region.regionPath,
            meta: `${formatInteger(subregion.supportedAsylum)} on support · ${formatInteger(subregion.publicPlaceCount)} authorities`,
            scopeId: subregion.scopeId,
            actionLabel: "Preview subregion"
          }))
        : region.areas.map((row) => ({
            label: row.area.areaName,
            href: buildAreaPath(row.area.areaCode),
            meta: `${formatInteger(row.area.supportedAsylum)} on support · ${describeHotelSignalShort(row)}`,
            scopeId: row.area.areaCode,
            actionLabel: "Preview place"
          })),
    visualIntro:
      subregions.length > 0
        ? "Use the cluster layer first. It makes long regional maps legible before you narrow into one authority."
        : "The regional map tells you where to open next.",
    visualGroups: [
      {
        title: subregions.length > 0 ? `Largest subregional totals in ${region.regionName}` : `Largest local totals in ${region.regionName}`,
        bars:
          subregions.length > 0
            ? rankedSubregions.slice(0, 4).map((subregion) =>
                buildBar(
                  subregion.label,
                  subregion.supportedAsylum,
                  rankedSubregions[0]?.supportedAsylum ?? 1,
                  "accent",
                  `${formatInteger(subregion.publicPlaceCount)} authorities · ${subregion.hotelSignalLabel}`
                )
              )
            : region.areas.slice(0, 3).map((row) =>
                buildBar(
                  row.area.areaName,
                  row.area.supportedAsylum,
                  region.leadArea?.area.supportedAsylum ?? 1,
                  "accent",
                  row.hotelSummary
                )
              )
      }
    ]
  }
};

for (const subregion of rankedSubregions) {
  const subregionRows = region.areas
    .filter((row) => subregion.areaCodes.includes(row.area.areaCode))
    .sort(
      (left, right) =>
        right.area.supportedAsylum - left.area.supportedAsylum ||
        (right.area.supportedAsylumRate ?? 0) - (left.area.supportedAsylumRate ?? 0) ||
        left.area.areaName.localeCompare(right.area.areaName)
    );
  const comparisonScale = Math.max(
    subregion.leadArea?.area.supportedAsylum ?? 0,
    Math.round(subregion.supportedAsylum / Math.max(subregion.publicPlaceCount, 1)),
    1
  );

  regionDeckEntries[subregion.scopeId] = {
    scopeId: subregion.scopeId,
    parentScopeId: region.regionName,
    parentLabel: region.regionName,
    eyebrow: `${region.regionName} cluster`,
    title: subregion.label,
    note: `${formatInteger(subregion.supportedAsylum)} on support across ${formatInteger(subregion.publicPlaceCount)} authorities. Narrow again to one authority.`,
    linksLabel: "Open one local authority",
    stats: [
      {
        label: "Supported asylum",
        value: formatInteger(subregion.supportedAsylum),
        context: `${formatInteger(subregion.publicPlaceCount)} authorities in this cluster`
      },
      {
        label: "Cluster rate",
        value: subregion.supportedAsylumRate === null ? "n/a" : formatNumber(subregion.supportedAsylumRate),
        context: "Supported asylum per 10,000 residents"
      },
      {
        label: "Contingency",
        value: formatInteger(subregion.contingencyAccommodation),
        context: "People in contingency accommodation"
      }
    ],
    links: subregionRows.map((row) => ({
      label: row.area.areaName,
      href: buildAreaPath(row.area.areaCode),
      meta: `${formatInteger(row.area.supportedAsylum)} on support · ${describeHotelSignalShort(row)}`,
      scopeId: row.area.areaCode,
      actionLabel: "Preview place"
    })),
    visualIntro: "This cluster view shortens the geography so the next authority choice is legible.",
    visualGroups: [
      {
        title: `Largest local totals in ${subregion.label}`,
        bars: subregionRows.slice(0, 4).map((row) =>
          buildBar(
            row.area.areaName,
            row.area.supportedAsylum,
            comparisonScale,
            "accent",
            row.hotelSummary
          )
        )
      }
    ]
  };
}

for (const row of region.areas) {
  const area = row.area;
  const regionalLead = region.leadArea?.area ?? area;
  const comparisonScale = Math.max(regionalLead.supportedAsylum, accommodationAverage, area.supportedAsylum, 1);
  const parentSubregion = subregionByAreaCode.get(area.areaCode);

  regionDeckEntries[area.areaCode] = {
    scopeId: area.areaCode,
    parentScopeId: parentSubregion?.scopeId ?? region.regionName,
    parentLabel: parentSubregion?.label ?? region.regionName,
    eyebrow: `${region.regionName} local page`,
    title: area.areaName,
    note: buildAreaNote(row),
    scopeHref: buildAreaPath(area.areaCode),
    scopeActionLabel: "Open place page",
    linksLabel: "Also open",
    stats: [
      {
        label: "Supported asylum",
        value: formatInteger(area.supportedAsylum),
        context: area.snapshotDate
      },
      {
        label: "Local rate",
        value: area.supportedAsylumRate === null ? "n/a" : formatNumber(area.supportedAsylumRate),
        context: "Per 10,000"
      },
      {
        label: "Contingency",
        value: formatInteger(area.contingencyAccommodation),
        context: "In contingency"
      }
    ],
    links: [
      {
        label: `Open ${region.regionName}`,
        href: region.regionPath,
        meta: "Regional page"
      }
    ],
    visualIntro: parentSubregion
      ? `This is the last narrowing step after ${parentSubregion.label}.`
      : "This is the last narrowing step on the region page.",
    visualGroups: [
      {
        title: parentSubregion ? `Within ${parentSubregion.label}` : `Within ${region.regionName}`,
        bars: [
          buildBar(area.areaName, area.supportedAsylum, comparisonScale, "accent", "This local authority"),
          buildBar(
            regionalLead.areaName,
            regionalLead.supportedAsylum,
            comparisonScale,
            "slate",
            "Regional lead by supported asylum"
          ),
          buildBar(
            "Regional average",
            accommodationAverage,
            comparisonScale,
            "teal",
            `${formatInteger(region.publicPlaceCount)} place pages in view`
          )
        ]
      }
    ]
  };
}
---

<BaseLayout title={`${region.regionName} region | asylumstats`} description={pageDescription}>
  <section id="region-findings" class="section section-anchor priority-section home-screen region-stage-screen">
    <div class="home-left">
      <article class="home-map-panel">
        <RegionAuthorityStage id={regionStageId} region={region} snapshotDate={localRouteLatest.snapshotDate} />
      </article>
    </div>

    <aside class="home-right">
      <HomeSystemDeck
        entries={regionDeckEntries}
        initialScopeId={region.regionName}
        targetMapId={regionStageId}
        rootScopeKind="region"
        resetLabel={`Back to ${region.regionName}`}
      />
    </aside>
  </section>

  <PageContents title="Start here" sections={regionSections} variant="priority" />

  <PageGuide
    id="region-guide"
    title={`Use ${region.regionName} in three moves`}
    intro="The region page now keeps the authority map and the local readout on one screen, so you can narrow before opening any full place page."
    items={regionGuideItems}
  />

  <section id="region-places" class="section section-anchor">
    <div class="section-head">
      <div>
        <h2>Place leaders inside {region.regionName}</h2>
        <p class="lede">
          These are the first place pages to open in this region. They keep the local count, rate, contingency use,
          and hotel visibility on a single surface.
        </p>
      </div>
      <span class="chip accent">{featuredAreas.length.toLocaleString()} featured authorities</span>
    </div>
    <div class="place-grid">
      {featuredAreas.map((row) => (
        <article class="place-card">
          <div class="chip-row">
            <span class="chip teal">UK rank {row.nationalRank.toLocaleString()}</span>
            <span class="chip">{row.area.contingencyAccommodation.toLocaleString()} contingency</span>
            {row.hotelSignal !== "none" && (
              <span class:list={["chip", row.hotelSignal === "named" ? "accent" : "warm"]}>
                {row.hotelSignal === "named" ? "Named hotel evidence" : "Unnamed hotel evidence"}
              </span>
            )}
          </div>
          <h3>
            <a href={`/places/${row.area.areaCode}/`}>{row.area.areaName}</a>
          </h3>
          <p class="lede">
            {row.area.supportedAsylum.toLocaleString()} people on supported asylum at quarter end, rate{" "}
            {row.area.supportedAsylumRate ?? "n/a"} per 10,000 residents.
          </p>
          <p class="tiny">Hotels: {row.hotelSummary}.</p>
        </article>
      ))}
    </div>
  </section>

  {hotelLinkedAreas.length > 0 && (
    <section id="region-hotels" class="section section-anchor">
      <div class="section-head">
        <div>
          <h2>Where hotel evidence is already visible</h2>
          <p class="lede">
            Hotel evidence stays inside the place layer. Use these authorities when you need a regional route into named
            current sites or unnamed acknowledged hotel use.
          </p>
        </div>
        <a class="chip accent" href="/hotels/">Open the hotel notebook only if needed</a>
      </div>
      <div class="feature-grid">
        {hotelLinkedAreas.slice(0, 8).map((row) => (
          <article class="feature-card">
            <div class="chip-row">
              <span class:list={["chip", row.hotelSignal === "named" ? "accent" : "warm"]}>
                {row.hotelSignal === "named" ? "Named hotel evidence" : "Unnamed hotel evidence"}
              </span>
              <span class="chip teal">{row.area.supportedAsylum.toLocaleString()} supported asylum</span>
            </div>
            <h3>
              <a href={`/places/${row.area.areaCode}/`}>{row.area.areaName}</a>
            </h3>
            <p class="lede">{row.hotelSummary} are already visible on the public record for this authority.</p>
            <p class="tiny">
              Contingency accommodation {row.area.contingencyAccommodation.toLocaleString()} | rate{" "}
              {row.area.supportedAsylumRate ?? "n/a"} per 10,000.
            </p>
          </article>
        ))}
      </div>
    </section>
  )}

  {regionLocalEvidenceLayer && (
    <section id="region-local-evidence" class="section section-anchor">
      <div class="section-head">
        <div>
          <h2>Named local evidence over time in {region.regionName}</h2>
          <p class="lede">
            This is the lower-level local layer the site can publish honestly here: a dated timeline of named public
            hotel evidence. It is not a complete town map and it does not imply site-level coverage outside these
            evidence-backed rows.
          </p>
        </div>
        <span class="chip accent">
          {regionLocalEvidenceLayer.currentNamedSiteCount.toLocaleString()} named current site
          {regionLocalEvidenceLayer.currentNamedSiteCount === 1 ? "" : "s"}
        </span>
      </div>
      {regionLocalEvidenceAreas.length > 0 && (
        <div class="feature-grid">
          {regionLocalEvidenceAreas.map((area) => (
            <article class="feature-card">
              <div class="chip-row">
                <span class="chip accent">{area.areaName}</span>
                <span class:list={["chip", area.partiallyResolvedSiteCount > 0 ? "teal" : "warm"]}>{area.chainLabel}</span>
              </div>
              <h3>{area.currentNamedSiteCount.toLocaleString()} named current site{area.currentNamedSiteCount === 1 ? "" : "s"}</h3>
              <p class="lede">
                Latest public naming on {area.latestPublicDateLabel}. {area.supportedAsylum !== null ? `${area.supportedAsylum.toLocaleString()} people are on supported asylum there at quarter end.` : "The site evidence is public even where the local route row is not carrying a numeric anchor here."}
              </p>
              <p class="tiny">{area.siteNames.slice(0, 2).join(" | ")}</p>
              {area.placeHref && (
                <p class="tiny">
                  <a class="source-pill" href={area.placeHref}>Open {area.areaName}</a>
                </p>
              )}
            </article>
          ))}
        </div>
      )}
      <LocalEvidenceTimeline items={regionLocalEvidenceTimeline} />
    </section>
  )}

  <DataDrawer
    id="region-data"
    label="Deep data"
    title={`Open the full ${region.regionName} place list`}
    summary="Use the full regional ledger when you need every published authority in this slice, not just the first pages worth opening."
  >
    <section class="section section-anchor">
      <div class="section-head">
        <div>
          <h2>All published place pages in {region.regionName}</h2>
          <p class="lede">
            The full regional place list stays here so the main reading surface can stay selective and legible.
          </p>
        </div>
      </div>
      <div class="place-grid">
        {region.areas.map((row) => (
          <article class="place-card">
            <div class="chip-row">
              <span class="chip teal">UK rank {row.nationalRank.toLocaleString()}</span>
              <span class="chip">{row.area.contingencyAccommodation.toLocaleString()} contingency</span>
              {row.hotelSignal !== "none" && (
                <span class:list={["chip", row.hotelSignal === "named" ? "accent" : "warm"]}>
                  {row.hotelSignal === "named" ? "Named hotel evidence" : "Unnamed hotel evidence"}
                </span>
              )}
            </div>
            <h3>
              <a href={`/places/${row.area.areaCode}/`}>{row.area.areaName}</a>
            </h3>
            <p class="lede">
              {row.area.supportedAsylum.toLocaleString()} people on supported asylum at quarter end, rate{" "}
              {row.area.supportedAsylumRate ?? "n/a"} per 10,000 residents.
            </p>
            <p class="tiny">Hotels: {row.hotelSummary}.</p>
          </article>
        ))}
      </div>
    </section>
  </DataDrawer>
</BaseLayout>
