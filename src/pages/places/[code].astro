---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageContents from "../../components/PageContents.astro";
import BenchmarkStrip from "../../components/BenchmarkStrip.astro";
import TrendChart from "../../components/TrendChart.astro";
import { buildSupportedAsylumStockDescription } from "../../lib/asylum-support-logic";
import { getAreaTrendSummary } from "../../lib/area-series";
import { getAreaRegionalPrimeProviderCoverage } from "../../lib/entity-analytics";
import { getEntityProfileByReference, getEntityProfiles } from "../../lib/entities";
import { loadLocalRouteLatest } from "../../lib/route-data";
import { loadHotelEntityLedger } from "../../lib/hotel-data";
import { buildAbsoluteUrl, buildPlaceStructuredData, getPublicPlaceAreas } from "../../lib/site";
import {
  getEthnicProjection, getEthnicCompositionTimeline,
  getReligionData, getNativityData, getStochasticData,
  getShiftShareData, getDiversityIndex, getEnglishProficiency,
  getMigrationProfile, getSocioeconomicData
} from "../../lib/ethnic-projections";
import { getCrimeProfile, getCrimeRatePercentile } from "../../lib/crime-data";
import { getSendProfile, getSendGrowthPercentile } from "../../lib/send-data";
import { getAscProfile, getAscSpendPercentile } from "../../lib/asc-data";
import { computePressureScore } from "../../lib/pressure-index";
import {
  formatOrdinal,
  getDistributionStats,
  getPercentileRank
} from "../../lib/route-analytics";

const localRouteLatest = loadLocalRouteLatest();
const hotelLedger = loadHotelEntityLedger();

export function getStaticPaths() {
  return getPublicPlaceAreas().map((area) => ({
    params: { code: area.areaCode },
    props: { area }
  }));
}

const { area } = Astro.props;
const hotelSites = hotelLedger.sites.filter(
  (site) => site.areaCode === area.areaCode || site.areaName === area.areaName
);
const hotelArea = hotelLedger.areas.find(
  (a) => a.areaCode === area.areaCode || a.areaName === area.areaName
);
const currentHotelSites = hotelSites.filter((site) => site.status === "current");
const namedSiteCount = currentHotelSites.length;
const unnamedSiteCount = hotelArea?.unnamedSiteCount ?? 0;

const regionalAreas = [...localRouteLatest.areas]
  .filter((candidate) => candidate.regionName === area.regionName)
  .sort((a, b) => b.supportedAsylum - a.supportedAsylum);
const regionalRank = regionalAreas.findIndex((candidate) => candidate.areaCode === area.areaCode) + 1;
const regionalPeerRows = (() => {
  const leadingPeers = regionalAreas.slice(0, 5);
  if (leadingPeers.some((candidate) => candidate.areaCode === area.areaCode)) return leadingPeers;
  return [...leadingPeers, area];
})();

const areaRank =
  [...localRouteLatest.areas]
    .sort((a, b) => b.supportedAsylum - a.supportedAsylum)
    .findIndex((candidate) => candidate.areaCode === area.areaCode) + 1;
const contingencyRank =
  [...localRouteLatest.areas]
    .sort((a, b) => b.contingencyAccommodation - a.contingencyAccommodation)
    .findIndex((candidate) => candidate.areaCode === area.areaCode) + 1;

const pathwayBreakdown = [
  { label: "Supported asylum", value: area.supportedAsylum },
  { label: "Homes for Ukraine", value: area.homesForUkraineArrivals },
  { label: "Afghan programme", value: area.afghanProgrammePopulation },
  { label: "Resettlement cumulative", value: area.resettlementCumulativeTotal ?? 0 }
];
const maxPathwayValue = Math.max(...pathwayBreakdown.map((item) => item.value), 1);

const areaTrend = getAreaTrendSummary(area.areaCode);

const regionalPrimeProviderCoverage = getAreaRegionalPrimeProviderCoverage(
  area, getEntityProfiles(), localRouteLatest.areas, hotelLedger.areas
);

const supportedStats = getDistributionStats(localRouteLatest.areas.map((c) => c.supportedAsylum));
const supportedRateStats = getDistributionStats(localRouteLatest.areas.map((c) => c.supportedAsylumRate ?? 0));
const contingencyStats = getDistributionStats(localRouteLatest.areas.map((c) => c.contingencyAccommodation));
const supportedPercentile = getPercentileRank(localRouteLatest.areas.map((c) => c.supportedAsylum), area.supportedAsylum);
const ratePercentile = getPercentileRank(localRouteLatest.areas.map((c) => c.supportedAsylumRate ?? 0), area.supportedAsylumRate ?? 0);
const contingencySharePct = area.supportedAsylum
  ? Number(((area.contingencyAccommodation / area.supportedAsylum) * 100).toFixed(1))
  : 0;
const supportedPercentileLabel = formatOrdinal(supportedPercentile);
const ratePercentileLabel = formatOrdinal(ratePercentile);
const regionalPeerMax = Math.max(...regionalPeerRows.map((c) => c.supportedAsylum), 1);

const ethnicProjection = getEthnicProjection(area.areaCode);
const ethnicTimeline = getEthnicCompositionTimeline(area.areaCode);
const wbThreshold = ethnicProjection?.thresholds.find((t) => t.label === "White British <50%") ?? null;
const significantShift = wbThreshold && wbThreshold.year <= 2070;
const religionData = getReligionData(area.areaCode);
const nativityData = getNativityData(area.areaCode);
const stochasticData = getStochasticData(area.areaCode);
const shiftShareData = getShiftShareData(area.areaCode);
const diversityIndex = getDiversityIndex(area.areaCode);
const englishProf = getEnglishProficiency(area.areaCode);
const migrationProfile = getMigrationProfile(area.areaCode);
const socioData = getSocioeconomicData(area.areaCode);
const crimeProfile = getCrimeProfile(area.areaCode);
const crimePercentile = getCrimeRatePercentile(area.areaCode);
const sendProfile = getSendProfile(area.areaCode);
const sendPercentile = getSendGrowthPercentile(area.areaCode);
const ascProfile = getAscProfile(area.areaCode);
const ascPercentile = getAscSpendPercentile(area.areaCode);
const pressureScore = computePressureScore(
  area.areaCode,
  area.areaName,
  area.supportedAsylumRate,
  localRouteLatest.areas.map((a) => a.supportedAsylumRate ?? 0)
);

const pageDescription = `${area.areaName}: ${area.supportedAsylum.toLocaleString()} on asylum support, rank ${areaRank} nationally. Hotels, demographics, crime, SEND, social care.`;
const pageStructuredData = buildPlaceStructuredData(area, {
  canonicalUrl: buildAbsoluteUrl(Astro.url.pathname),
  description: pageDescription,
  socialImageUrl: buildAbsoluteUrl("/og-card.png"),
  snapshotDate: localRouteLatest.snapshotDate,
  areaRank,
  contingencyRank,
  namedSiteCount,
  unnamedSiteCount
});

const placeSections = [
  { id: "place-summary", label: "Summary" },
  ...(areaTrend ? [{ id: "recent-trend", label: "Trend" }] : []),
  { id: "local-numbers", label: "Local numbers" },
  { id: "hotel-evidence", label: "Hotels" },
  ...(ethnicProjection ? [{ id: "demographic-profile", label: "Demographics" }] : []),
  ...(religionData ? [{ id: "religion-profile", label: "Religion" }] : []),
  ...(nativityData ? [{ id: "nativity-profile", label: "Nativity" }] : []),
  ...(shiftShareData ? [{ id: "change-drivers", label: "Why it's changing" }] : []),
  ...(crimeProfile ? [{ id: "crime-profile", label: "Crime" }] : []),
  ...(sendProfile ? [{ id: "send-profile", label: "SEND" }] : []),
  ...(ascProfile ? [{ id: "asc-profile", label: "Social care" }] : []),
  ...(socioData?.economicActivity ? [{ id: "socioeconomic", label: "Economy & housing" }] : []),
  ...(ethnicProjection?.schoolEthnicity ? [{ id: "school-ethnicity", label: "Schools" }] : []),
  ...(ethnicProjection?.impactProjections ? [{ id: "impact-projections", label: "Service impact" }] : []),
  ...(pressureScore.availableModules >= 3 ? [{ id: "pressure-index", label: "Pressure index" }] : []),
  { id: "local-benchmarks", label: "Benchmarks" },
  { id: "regional-peers", label: "Regional peers" }
];

function getSiteEntityProfiles(site: (typeof hotelSites)[number]) {
  const matches = [
    ...site.entityLinks.map((link) => getEntityProfileByReference(link.entityName, link.companyNumber)),
    site.primeProvider ? getEntityProfileByReference(site.primeProvider.provider, null) : null
  ].filter((profile): profile is NonNullable<typeof profile> => profile !== null && profile !== undefined);
  return [...new Map(matches.map((profile) => [profile.entityId, profile])).values()];
}
---

<BaseLayout
  title={`${area.areaName} | asylumstats`}
  description={pageDescription}
  structuredData={pageStructuredData}
>
  <!-- HEADER -->
  <section class="page-top">
    <section class="page-head">
      <span class="kicker">{area.regionName}</span>
      <h1>{area.areaName}</h1>
      <p>
        {area.supportedAsylum.toLocaleString()} on asylum support. Rank {areaRank} nationally, {regionalRank} in {area.regionName}.
        Rate: {area.supportedAsylumRate ?? "n/a"} per 10,000 ({ratePercentileLabel} percentile).
        {namedSiteCount > 0 ? ` ${namedSiteCount} named hotel site${namedSiteCount > 1 ? "s" : ""}.` : ""}
        {regionalPrimeProviderCoverage ? ` Regional provider: ${regionalPrimeProviderCoverage.profile.entityName}.` : ""}
      </p>
      <div class="chip-row">
        <span class="chip accent">{localRouteLatest.snapshotDate}</span>
        <a class="chip" href={`/places/regions/${area.regionName.toLowerCase().replace(/\s+/g, "-")}/`}>
          {area.regionName} region
        </a>
        {contingencySharePct > 0 && <span class="chip">{contingencySharePct}% contingency</span>}
      </div>
    </section>

    <aside class="page-rail">
      <article class="panel panel-pad">
        <div class="stat-strip">
          <article class="stat-tile">
            <span class="tiny">UK rank</span>
            <strong>{areaRank.toLocaleString()}</strong>
          </article>
          <article class="stat-tile">
            <span class="tiny">On support</span>
            <strong>{area.supportedAsylum.toLocaleString()}</strong>
          </article>
          <article class="stat-tile">
            <span class="tiny">Rate /10k</span>
            <strong>{area.supportedAsylumRate ?? "n/a"}</strong>
          </article>
          <article class="stat-tile">
            <span class="tiny">Contingency</span>
            <strong>{area.contingencyAccommodation.toLocaleString()}</strong>
          </article>
        </div>
      </article>
    </aside>
  </section>

  <PageContents title="Sections" sections={placeSections} />

  <!-- SUMMARY -->
  <section id="place-summary" class="section section-anchor">
    <div class="section-head">
      <div>
        <h2>Summary</h2>
      </div>
    </div>
    <p class="lede">
      {area.areaName} has {area.supportedAsylum.toLocaleString()} people on asylum support at quarter end,
      ranking {areaRank.toLocaleString()} out of {localRouteLatest.areas.length} local authorities nationally.
      The rate of {area.supportedAsylumRate ?? "n/a"} per 10,000 residents places it around the {ratePercentileLabel} percentile.
      {area.contingencyAccommodation > 0
        ? ` ${area.contingencyAccommodation.toLocaleString()} are in contingency accommodation (${contingencySharePct}% of total).`
        : " No contingency accommodation recorded."}
      {namedSiteCount > 0
        ? ` ${namedSiteCount} named hotel site${namedSiteCount > 1 ? "s are" : " is"} publicly documented.`
        : unnamedSiteCount > 0
          ? ` ${unnamedSiteCount} hotel site${unnamedSiteCount > 1 ? "s" : ""} acknowledged but not publicly named.`
          : " No hotel evidence attached yet."}
      These are quarter-end stock numbers, not throughput.
    </p>
  </section>

  <!-- TREND -->
  {areaTrend && (
    <section id="recent-trend" class="split section section-anchor">
      <TrendChart
        points={areaTrend.points.map((point) => ({ label: point.label, value: point.value }))}
        title={`Supported asylum in ${area.areaName}`}
        description={buildSupportedAsylumStockDescription(areaTrend.latestPeriodLabel, areaTrend.hasIllustrativeData)}
        tone={(areaTrend.deltaFromPrevious ?? areaTrend.deltaFromFirst) > 0 ? "warm" : "teal"}
      />
      <article class="panel panel-pad">
        <h2>Trend</h2>
        <div class="metric-list">
          <div class="metric-item">
            <span class="metric-value">
              {areaTrend.deltaFromPrevious !== null
                ? `${areaTrend.deltaFromPrevious >= 0 ? "+" : ""}${areaTrend.deltaFromPrevious.toLocaleString()}`
                : "—"}
            </span>
            <span class="metric-label">Latest quarter change</span>
          </div>
          <div class="metric-item">
            <span class="metric-value">
              {areaTrend.deltaFromFirst >= 0 ? "+" : ""}{areaTrend.deltaFromFirst.toLocaleString()}
            </span>
            <span class="metric-label">Change across series</span>
          </div>
          <div class="metric-item">
            <span class="metric-value">{areaTrend.officialAnchorCount}</span>
            <span class="metric-label">Official data points</span>
          </div>
        </div>
      </article>
    </section>
  )}

  <!-- LOCAL NUMBERS -->
  <section id="local-numbers" class="section section-anchor">
    <div class="section-head">
      <div>
        <h2>Local numbers</h2>
      </div>
    </div>
    <div class="grid-2">
      <article class="feature-card accent">
        <h3>Accommodation split</h3>
        <div class="data-list">
          <div class="data-row">
            <span>Dispersal accommodation</span>
            <span class="data-row-value">{area.dispersalAccommodation.toLocaleString()}</span>
          </div>
          <div class="data-row">
            <span>Initial accommodation</span>
            <span class="data-row-value">{area.initialAccommodation.toLocaleString()}</span>
          </div>
          <div class="data-row">
            <span>Subsistence only</span>
            <span class="data-row-value">{area.subsistenceOnly.toLocaleString()}</span>
          </div>
          <div class="data-row">
            <span>Contingency accommodation</span>
            <span class="data-row-value">{area.contingencyAccommodation.toLocaleString()}</span>
          </div>
        </div>
      </article>

      <article class="feature-card">
        <h3>Pathway breakdown</h3>
        {pathwayBreakdown.map((item) => (
          <div class="metric-bar">
            <div style="min-width: 10rem;">
              <strong>{item.label}</strong>
              <div class="tiny">{item.value.toLocaleString()}</div>
            </div>
            <div class="metric-track">
              <div class="metric-fill" style={`width: ${(item.value / maxPathwayValue) * 100}%`}></div>
            </div>
          </div>
        ))}
      </article>
    </div>

    <div class="grid-2" style="margin-top: 1rem;">
      <article class="feature-card">
        <h3>Other routes</h3>
        <div class="data-list">
          <div class="data-row">
            <span>Homes for Ukraine</span>
            <span class="data-row-value">{area.homesForUkraineArrivals.toLocaleString()}</span>
          </div>
          <div class="data-row">
            <span>Afghan programme</span>
            <span class="data-row-value">{area.afghanProgrammePopulation.toLocaleString()}</span>
          </div>
          <div class="data-row">
            <span>Resettlement cumulative</span>
            <span class="data-row-value">{(area.resettlementCumulativeTotal ?? 0).toLocaleString()}</span>
          </div>
        </div>
      </article>
      <article class="feature-card">
        <h3>Population context</h3>
        <div class="data-list">
          <div class="data-row">
            <span>All pathways total</span>
            <span class="data-row-value">{area.allThreePathwaysTotal.toLocaleString()}</span>
          </div>
          <div class="data-row">
            <span>Share of local population</span>
            <span class="data-row-value">{area.shareOfPopulationPct ?? "n/a"}%</span>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- HOTEL EVIDENCE -->
  <section id="hotel-evidence" class="section section-anchor">
    <div class="section-head">
      <div>
        <h2>Hotel evidence</h2>
        <p class="lede">
          {namedSiteCount > 0
            ? `${namedSiteCount} named site${namedSiteCount > 1 ? "s" : ""} publicly documented.`
            : unnamedSiteCount > 0
              ? `${unnamedSiteCount} site${unnamedSiteCount > 1 ? "s" : ""} acknowledged but not publicly named.`
              : "No public hotel evidence attached to this area yet."}
        </p>
      </div>
    </div>
    {hotelSites.length > 0 || hotelArea ? (
      <div class="table-card">
        <table>
          <thead>
            <tr>
              <th scope="col">Site</th>
              <th scope="col">Status</th>
              <th scope="col">Evidence</th>
              <th scope="col">Last public date</th>
              <th scope="col">Entity coverage</th>
            </tr>
          </thead>
          <tbody>
            {hotelSites.map((site) => (
              (() => {
                const entityProfiles = getSiteEntityProfiles(site);
                return (
                  <tr>
                    <th scope="row">
                      <strong>{site.siteName}</strong>
                      <div class="tiny"><a class="source-pill" href={site.sourceUrl}>Evidence</a></div>
                    </th>
                    <td>{site.status}</td>
                    <td>{site.evidenceClass}</td>
                    <td>{site.lastPublicDate}</td>
                    <td>
                      <span class="chip tiny">{site.entityCoverage}</span>
                      {site.ownerName && <div class="tiny">Owner: {site.ownerName}</div>}
                      {site.operatorName && <div class="tiny">Operator: {site.operatorName}</div>}
                      {site.primeProvider && (
                        <div class="tiny">
                          Provider: {site.primeProvider.provider}
                          {getEntityProfileByReference(site.primeProvider.provider, null) && (
                            <> <a href={`/entities/${getEntityProfileByReference(site.primeProvider.provider, null)!.entityId}/`}>profile</a></>
                          )}
                        </div>
                      )}
                      {site.entityLinks.map((link) => {
                        const profile = getEntityProfileByReference(link.entityName, link.companyNumber);
                        return (
                          <div class="tiny">
                            {link.entityName} ({link.linkRole})
                            {profile && <> <a href={`/entities/${profile.entityId}/`}>profile</a></>}
                          </div>
                        );
                      })}
                    </td>
                  </tr>
                );
              })()
            ))}
            {hotelArea && hotelArea.unnamedSiteCount > 0 && (
              <tr>
                <th scope="row">
                  <strong>Unnamed sites</strong>
                  <div class="tiny"><a class="source-pill" href={hotelArea.sourceUrl}>Source</a></div>
                </th>
                <td>acknowledged</td>
                <td>area sighting</td>
                <td>{hotelArea.lastPublicDate}</td>
                <td><span class="tiny">{hotelArea.unnamedSiteCount} site{hotelArea.unnamedSiteCount > 1 ? "s" : ""} without names</span></td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    ) : (
      <p class="lede" style="opacity: 0.6;">No public hotel evidence logged for this area yet.</p>
    )}
  </section>

  <!-- DEMOGRAPHICS -->
  {ethnicProjection && ethnicTimeline && (
    <section id="demographic-profile" class="section section-anchor">
      <div class="section-head">
        <div>
          <h2>Demographics</h2>
          <p class="lede">
            Census-based ethnic composition for {area.areaName} (ONS 2011 & 2021).
            {significantShift
              ? ` If 2011-2021 rates continue, White British estimated below 50% by ~${wbThreshold!.year}. This is a trend extrapolation, not a forecast.`
              : ""}
          </p>
        </div>
      </div>
      <div class="grid-2">
        <article class="feature-card">
          <div class="chip-row">
            <span class="chip accent">Census 2021</span>
            {significantShift && <span class="chip coral">Significant shift</span>}
          </div>
          <h3>Ethnic composition</h3>
          <div class="stacked-bars">
            {ethnicTimeline.filter((t) => !t.isProjection || t.year === "2030" || t.year === "2040" || t.year === "2050").map((point) => (
              <div class="stacked-bar-row">
                <div class="stacked-bar-label">
                  <strong>{point.year}</strong>
                  {point.isProjection && <span class="chip tiny">projected</span>}
                </div>
                <div class="stacked-bar" title={`WB: ${point.groups.white_british.toFixed(1)}%, Asian: ${point.groups.asian.toFixed(1)}%, Black: ${point.groups.black.toFixed(1)}%`}>
                  <div class="bar-seg wb" style={`width: ${point.groups.white_british}%`}></div>
                  <div class="bar-seg wo" style={`width: ${point.groups.white_other}%`}></div>
                  <div class="bar-seg asian" style={`width: ${point.groups.asian}%`}></div>
                  <div class="bar-seg black" style={`width: ${point.groups.black}%`}></div>
                  <div class="bar-seg mixed" style={`width: ${point.groups.mixed}%`}></div>
                  <div class="bar-seg other" style={`width: ${point.groups.other}%`}></div>
                </div>
                <div class="stacked-bar-pct">{point.groups.white_british.toFixed(1)}% WB</div>
              </div>
            ))}
          </div>
          <div class="legend-row">
            <span class="legend-item"><span class="legend-swatch wb"></span> White British</span>
            <span class="legend-item"><span class="legend-swatch wo"></span> White Other</span>
            <span class="legend-item"><span class="legend-swatch asian"></span> Asian</span>
            <span class="legend-item"><span class="legend-swatch black"></span> Black</span>
            <span class="legend-item"><span class="legend-swatch mixed"></span> Mixed</span>
            <span class="legend-item"><span class="legend-swatch other"></span> Other</span>
          </div>
        </article>
        <article class="feature-card">
          <h3>Key metrics</h3>
          <div class="metric-list">
            <div class="metric-item">
              <span class="metric-value">{ethnicProjection.current.groups.white_british.toFixed(1)}%</span>
              <span class="metric-label">White British ({ethnicProjection.current.year})</span>
            </div>
            <div class="metric-item">
              <span class="metric-value">{ethnicProjection.baseline.groups.white_british.toFixed(1)}%</span>
              <span class="metric-label">White British ({ethnicProjection.baseline.year})</span>
            </div>
            <div class="metric-item">
              <span class="metric-value" style={`color: ${Math.abs(ethnicProjection.annualChangePp.white_british) > 0.5 ? "var(--coral)" : "var(--text-secondary)"}`}>
                {ethnicProjection.annualChangePp.white_british > 0 ? "+" : ""}{ethnicProjection.annualChangePp.white_british.toFixed(2)}pp
              </span>
              <span class="metric-label">Annual change (WB)</span>
            </div>
            {ethnicProjection.current.groups.asian > 5 && (
              <div class="metric-item">
                <span class="metric-value">{ethnicProjection.current.groups.asian.toFixed(1)}%</span>
                <span class="metric-label">Asian ({ethnicProjection.current.year})</span>
              </div>
            )}
            {wbThreshold && (
              <div class="metric-item">
                <span class="metric-value" style={`color: ${significantShift ? "var(--coral)" : "var(--text-secondary)"}`}>
                  {wbThreshold.year}
                </span>
                <span class="metric-label">Projected WB &lt;50% ({wbThreshold.confidence})</span>
              </div>
            )}
          </div>
          <details class="method-note">
            <summary class="tiny" style="cursor: pointer; opacity: 0.6;">Source & methodology</summary>
            <p class="tiny" style="margin-top: 0.4rem; opacity: 0.5;">
              ONS Census 2011 & 2021 (TS021). Linear extrapolation of decadal change rates. Not a demographic forecast.
            </p>
          </details>
        </article>
      </div>
      {ethnicProjection.thresholds.length > 0 && (
        <article class="feature-card" style="margin-top: 1rem;">
          <h3>Projected thresholds</h3>
          <p class="tiny" style="opacity: 0.6;">If 2011-2021 Census rates continue unchanged. Subject to significant uncertainty.</p>
          <div class="table-card">
            <table>
              <thead><tr><th>Milestone</th><th>Year</th><th>Confidence</th></tr></thead>
              <tbody>
                {ethnicProjection.thresholds.map((t) => (
                  <tr>
                    <td>{t.label}</td>
                    <td><strong>{t.year}</strong></td>
                    <td><span class={`chip tiny ${t.confidence === "medium" ? "coral" : ""}`}>{t.confidence}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </article>
      )}
    </section>
  )}

  <!-- CONFIDENCE BANDS (stochastic) -->
  {stochasticData?.[2051] && (
    <article class="feature-card" style="margin-top: -0.5rem; margin-bottom: 1rem; border-left: 3px solid var(--accent);">
      <div class="chip-row">
        <span class="chip accent">Monte Carlo</span>
        <span class="chip">1,000 simulations</span>
      </div>
      <h3>Projection confidence</h3>
      <div class="metric-list">
        <div class="metric-item">
          <span class="metric-value">{stochasticData[2051].wbi.median}%</span>
          <span class="metric-label">WBI 2051 (median)</span>
        </div>
        <div class="metric-item">
