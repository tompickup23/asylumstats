        <h2>Regional peers</h2>
        <p class="lede">Top {regionalPeerRows.length} in {area.regionName} by supported asylum.</p>
      </div>
    </div>
    <div class="panel panel-pad">
      {regionalPeerRows.map((peer) => (
        <div class="metric-bar">
          <div style="min-width: 11rem;">
            <strong>{peer.areaName}</strong>
            <div class="tiny">
              {peer.areaCode === area.areaCode
                ? `This area | ${peer.supportedAsylum.toLocaleString()}`
                : peer.supportedAsylum.toLocaleString()}
            </div>
          </div>
          <div class="metric-track">
            <div class="metric-fill" style={`width: ${(peer.supportedAsylum / regionalPeerMax) * 100}%`}></div>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
