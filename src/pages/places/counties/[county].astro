---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import DataFreshness from "../../../components/DataFreshness.astro";
import PlainEnglish from "../../../components/PlainEnglish.astro";
import { slugifyAreaName } from "../../../lib/site";
import { getCounties, type County } from "../../../lib/county-directory";
import { loadLocalRouteLatest } from "../../../lib/route-data";

const localRouteLatest = loadLocalRouteLatest();

export function getStaticPaths() {
  return getCounties().map((county) => ({
    params: { county: county.countySlug },
    props: { county }
  }));
}

const { county } = Astro.props as { county: County };

const maxAreaAsylum = county.areas[0]?.supportedAsylum || 1;

// Keyword first, so that a truncated title still matches the query it is for.
const pageTitle = `Asylum seekers in ${county.countyName}: ${county.supportedAsylum.toLocaleString()} on support`;

function ordinal(n: number): string {
  const rest = n % 100;
  if (rest >= 11 && rest <= 13) return `${n}th`;
  return `${n}${["th", "st", "nd", "rd"][n % 10] ?? "th"}`;
}
const rankLabel = `${ordinal(county.nationalRank)} highest of ${county.countyCount} English counties`;

const pageDescription =
  `${county.countyName}: ${county.supportedAsylum.toLocaleString()} asylum seekers on support, ` +
  `${rankLabel}. ${county.areaCount} local authorities, ` +
  `${county.supportedAsylumRate ?? "-"} per 10,000 residents.`;

// The searches these pages exist for are phrased as questions, so the page answers them
// in that form. Google restricted FAQ rich results to a narrow set of sites in 2023, so
// treat the markup as a bonus: the durable gain is the question wording on the page.
const askedAndAnswered = [
  {
    question: `How many asylum seekers are there in ${county.countyName}?`,
    answer:
      `${county.supportedAsylum.toLocaleString()} people were receiving asylum support in ` +
      `${county.countyName} as at 31 March 2026, across its ${county.areaCount} local ` +
      `authorities. That is ${county.supportedAsylumRate ?? "-"} per 10,000 residents and ` +
      `makes it the ${rankLabel} on this measure. The figure counts people on support at ` +
      `that date, which is not the same as the number waiting for a decision.`
  },
  {
    question: `How many refugees are there in ${county.countyName}?`,
    answer:
      `Two resettlement routes are published for ${county.countyName}. ` +
      `${county.afghanProgrammePopulation.toLocaleString()} people were in the Afghan ` +
      `Resettlement Programme as at 31 March 2026, which is a population counted at a point ` +
      `in time. Separately, ${county.homesForUkraineArrivals.toLocaleString()} Homes for ` +
      `Ukraine arrivals have been recorded there since the scheme opened, which is a running ` +
      `count of arrivals rather than of who lives there now. The two measure different ` +
      `things and should not be added together.`
  },
  {
    question: `Which part of ${county.countyName} has the most asylum seekers?`,
    answer:
      `${county.areas[0]?.areaName} has the most, with ` +
      `${county.areas[0]?.supportedAsylum.toLocaleString()} people on asylum support, ` +
      `followed by ${county.areas[1]?.areaName ?? "no other authority"}` +
      `${county.areas[1] ? ` with ${county.areas[1].supportedAsylum.toLocaleString()}` : ""}. ` +
      `Every authority in the county is listed on this page.`
  }
];

const pageStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: askedAndAnswered.map((row) => ({
      "@type": "Question",
      name: row.question,
      acceptedAnswer: { "@type": "Answer", text: row.answer }
    }))
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription} structuredData={pageStructuredData}>
  <Breadcrumbs items={[
    { label: "Places", href: "/places/" },
    { label: "Counties", href: "/places/counties/" },
    { label: county.countyName }
  ]} />

  <section class="page-top">
    <section class="page-head">
      <span class="kicker">County</span>
      <h1>Asylum seekers in {county.countyName}</h1>
      <DataFreshness
        updated={localRouteLatest.snapshotDate ?? "2026-03-31"}
        source="Home Office"
        sourceUrl="https://www.gov.uk/government/statistical-data-sets/immigration-system-statistics-regional-and-local-authority-data"
      />
    </section>
    <aside class="page-rail">
      <article class="panel panel-pad">
        <div class="stat-strip">
          <article class="stat-tile">
            <span class="tiny">On support</span>
            <strong>{county.supportedAsylum.toLocaleString()}</strong>
          </article>
          <article class="stat-tile">
            <span class="tiny">Rate /10k</span>
            <strong>{county.supportedAsylumRate ?? "-"}</strong>
          </article>
          <article class="stat-tile">
            <span class="tiny">Authorities</span>
            <strong>{county.areaCount}</strong>
          </article>
          <article class="stat-tile">
            <span class="tiny">Rank of {county.countyCount}</span>
            <strong>{county.nationalRank}</strong>
          </article>
        </div>
      </article>
    </aside>
  </section>

  <PlainEnglish
    headline={`${county.supportedAsylum.toLocaleString()} people were on asylum support in ${county.countyName}`}
    body={`That is the position as at 31 March 2026, counted across the ${county.areaCount} local authorities that make up ${county.countyName}. It works out at ${county.supportedAsylumRate ?? "-"} per 10,000 residents. It counts people receiving asylum support at that date, which is not the same as the number waiting for a decision, and not the number of people who passed through support over the year.`}
    tone={county.supportedAsylum > 10000 ? "alert" : county.supportedAsylum > 3000 ? "info" : "success"}
  />

  <!-- REFUGEE ROUTES, DELIBERATELY NOT ADDED TOGETHER -->
  <section class="section shell">
    <h2 class="cty-section-title">Refugees in {county.countyName}: the resettlement routes</h2>
    <p class="cty-lede">
      People who arrive through a resettlement route are refugees with status, which is a
      different thing from an asylum seeker waiting for a decision. The two are published
      as different kinds of figure and are shown separately here for that reason.
    </p>
    <div class="cty-route-grid">
      <article class="panel panel-pad">
        <span class="tiny">Afghan Resettlement Programme</span>
        <strong class="cty-route-value">{county.afghanProgrammePopulation.toLocaleString()}</strong>
        <p class="cty-route-note">
          People in the programme in {county.countyName} as at 31 March 2026. This is a
          population, counted at a point in time.
        </p>
      </article>
      <article class="panel panel-pad">
        <span class="tiny">Homes for Ukraine</span>
        <strong class="cty-route-value">{county.homesForUkraineArrivals.toLocaleString()}</strong>
        <p class="cty-route-note">
          Arrivals recorded in {county.countyName}, counted since the scheme opened. This is
          an arrivals count, not a headcount of who lives here now, and it excludes super
          sponsor arrivals.
        </p>
      </article>
    </div>
    <p class="cty-warn">
      These two figures and the asylum support figure above measure different things, so
      adding them together would not give a meaningful total.
    </p>
  </section>

  <!-- AUTHORITY RANKING -->
  <section class="section shell">
    <h2 class="cty-section-title">Local authorities in {county.countyName}, by asylum seekers on support</h2>
    <div class="cty-area-list">
      {county.areas.map((area, i) => (
        <a href={`/places/${slugifyAreaName(area.areaName)}/`} class="cty-area-row">
          <span class="cty-area-rank">{i + 1}</span>
          <div class="cty-area-info">
            <span class="cty-area-name">{area.areaName}</span>
            <span class="cty-area-bar-track">
              <span
                class="cty-area-bar-fill"
                style={`width: ${(area.supportedAsylum / maxAreaAsylum) * 100}%`}
              ></span>
            </span>
          </div>
          <span class="cty-area-count">{area.supportedAsylum.toLocaleString()}</span>
        </a>
      ))}
    </div>
    <p class="cty-area-caption">
      Click any authority for its full profile. Figures are people on asylum support at
      31 March 2026.
    </p>
  </section>

  <!-- THE QUESTIONS PEOPLE ACTUALLY ASK -->
  <section class="section shell">
    <h2 class="cty-section-title">Common questions about {county.countyName}</h2>
    {askedAndAnswered.map((row) => (
      <article class="cty-qa">
        <h3 class="cty-q">{row.question}</h3>
        <p class="cty-a">{row.answer}</p>
      </article>
    ))}
  </section>

  <!-- HOW THE COUNTY IS DEFINED -->
  <section class="section shell">
    <h2 class="cty-section-title">How this county is defined</h2>
    <p class="cty-lede">
      {county.countyName} here means the ceremonial county, the one people mean in ordinary
      speech, so it includes any unitary authority sitting inside its boundary even though
      that authority runs its own services. The narrower administrative definition counts
      only two-tier districts, and using it would leave out 24,764 of the 85,162 people on
      asylum support in England, just over 29 per cent, without saying so.
    </p>
    <p class="cty-lede">
      Three boundaries do not divide cleanly and are handled the same way on every page.
      Stockton-on-Tees straddles the historic Durham and North Yorkshire boundary and is
      counted whole within County Durham, because the published figures cannot be split.
      The Isles of Scilly are grouped with Cornwall. Inner and Outer London are shown
      together as Greater London.
    </p>
    <p class="cty-lede">
      Every figure on this page is the sum of figures published for the individual local
      authorities. Nothing is modelled or estimated. Source: Home Office, Immigration
      system statistics, regional and local authority data, released 21 May 2026, covering
      the position as at 31 March 2026.
    </p>
  </section>
</BaseLayout>

<style>
  .cty-section-title {
    font-size: 1.05rem;
    margin-bottom: 0.5rem;
  }
  .cty-lede {
    font-size: 0.9rem;
    line-height: 1.55;
    opacity: 0.85;
    margin-bottom: 0.75rem;
    max-width: 70ch;
  }
  .cty-route-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .cty-route-value {
    display: block;
    font-size: 1.6rem;
    line-height: 1.2;
    margin: 0.2rem 0 0.4rem;
  }
  .cty-route-note {
    font-size: 0.8rem;
    line-height: 1.5;
    opacity: 0.75;
    margin: 0;
  }
  .cty-warn {
    font-size: 0.8rem;
    opacity: 0.75;
    max-width: 70ch;
  }
  .cty-area-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .cty-area-row {
    display: grid;
    grid-template-columns: 2rem 1fr 4.5rem;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.5rem;
    border-radius: 6px;
    text-decoration: none;
    color: inherit;
  }
  .cty-area-row:hover {
    background: rgba(127, 127, 127, 0.12);
  }
  .cty-area-rank {
    font-size: 0.75rem;
    opacity: 0.6;
    text-align: right;
  }
  .cty-area-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .cty-area-name {
    font-size: 0.85rem;
  }
  .cty-area-bar-track {
    height: 4px;
    border-radius: 2px;
    background: rgba(127, 127, 127, 0.2);
    overflow: hidden;
  }
  .cty-area-bar-fill {
    display: block;
    height: 100%;
    background: currentColor;
    opacity: 0.55;
  }
  .cty-area-count {
    font-variant-numeric: lining-nums tabular-nums;
    text-align: right;
    font-size: 0.85rem;
  }
  .cty-qa {
    margin-bottom: 0.9rem;
    max-width: 70ch;
  }
  .cty-q {
    font-size: 0.92rem;
    margin: 0 0 0.25rem;
  }
  .cty-a {
    font-size: 0.87rem;
    line-height: 1.55;
    opacity: 0.82;
    margin: 0;
  }
  .cty-area-caption {
    font-size: 0.78rem;
    opacity: 0.7;
    margin-top: 0.6rem;
  }
</style>
