---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FindingCard from "../../components/FindingCard.astro";
import QuestionCard from "../../components/QuestionCard.astro";
import { getCollection } from "astro:content";
import { arrangeResearch } from "../../lib/research-sections";
import { getExplainers } from "../../lib/explainers";

// Latest first for freshness, then the questions people search for, then the flagship
// investigations, then everything else by topic. See src/lib/research-sections.ts.
const { latest, featured, groups } = arrangeResearch(await getCollection("findings"));
const questions = getExplainers();
---

<BaseLayout
  image="/og/findings.png"
  title="Asylum research: cost, grant rates and dispersal"
  description="The latest UK asylum figures explained, and investigations into asylum costs, contracts and the system. Every number sourced."
>
  <section class="research-head shell">
    <h1>Research</h1>
    <p>
      Articles backed by data. Findings verified against source. Scrutinise the methodology,
      check the sources, draw your own conclusions.
    </p>
  </section>

  <section class="research-section shell" id="latest" aria-labelledby="latest-title">
    <h2 id="latest-title" class="research-label">Latest</h2>
    <div class="research-grid">
      {latest.map((item) => <FindingCard finding={item} />)}
    </div>
  </section>

  <section class="research-section shell" id="questions" aria-labelledby="questions-title">
    <div class="research-label-row">
      <h2 id="questions-title" class="research-label">Questions answered</h2>
      <a href="/explained/" class="research-more">All questions &rarr;</a>
    </div>
    <div class="research-grid research-grid--questions">
      {questions.map((explainer) => <QuestionCard explainer={explainer} />)}
    </div>
  </section>

  {featured.length > 0 && (
    <section class="research-section shell" id="investigations" aria-labelledby="featured-title">
      <h2 id="featured-title" class="research-label">Investigations</h2>
      <div class="research-heroes">
        {featured.map((item) => <FindingCard finding={item} variant="hero" />)}
      </div>
    </section>
  )}

  {groups.map((group) => (
    <section class="research-section shell" id={group.id} aria-labelledby={`${group.id}-title`}>
      <h2 id={`${group.id}-title`} class="research-label">{group.label}</h2>
      <div class="research-grid">
        {group.items.map((item) => <FindingCard finding={item} />)}
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  .research-head {
    padding-top: 2.5rem;
  }
  .research-head h1 {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 600;
    margin: 0;
  }
  .research-head p {
    color: var(--text-muted);
    font-size: 0.95rem;
    max-width: 550px;
    margin: 0.5rem 0 0;
  }
  .research-section {
    margin-top: 2.5rem;
  }
  .research-section:last-of-type {
    padding-bottom: 3rem;
  }
  .research-label-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .research-label {
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin: 0 0 1rem;
  }
  .research-more {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
  }
  .research-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 1rem;
  }
  .research-grid--questions {
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
  }
  .research-heroes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(420px, 1fr));
    gap: 1rem;
  }
  @media (max-width: 640px) {
    .research-grid,
    .research-heroes {
      grid-template-columns: 1fr;
    }
  }
</style>
