---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlainEnglish from "../components/PlainEnglish.astro";
import ProportionGrid from "../components/ProportionGrid.astro";
import { SITE_URL } from "../lib/site";
import {
  loadAsylumCostReconciliation,
  loadHoAsylumEntities,
  formatGbpShort,
  formatGbpFull,
  perPersonInUk
} from "../lib/ho-spend";

const recon = loadAsylumCostReconciliation();
const entities = loadHoAsylumEntities();
const capture = recon.headline.capture!;
const topEntities = entities.entities.slice(0, 10);

// Parents only. Sub-rows are shown nested under their parent, and the NAO's own total is
// used verbatim rather than summed: see the note on that row.
const parents = recon.components.filter((c) => !c.parentId && c.componentId !== "TOTAL");
const childrenOf = (id: string) => recon.components.filter((c) => c.parentId === id);
const total = recon.components.find((c) => c.componentId === "TOTAL")!;

const title = "How much of its asylum spending does the Home Office actually publish?";
const description =
  `The Home Office spent ${formatGbpShort(recon.headline.estimatedGbp)} on asylum in ` +
  `${recon.fy}. Its published spending data accounts for ` +
  `${formatGbpShort(recon.headline.publishedGbp)} — about £${capture.perHundredPounds} in every £100.`;

const faq = [
  {
    q: "How much does the UK spend on asylum?",
    a: `The National Audit Office puts Home Office and Ministry of Justice spending on asylum at about ${formatGbpShort(recon.headline.estimatedGbp)} in ${recon.fy}. That is ${perPersonInUk(recon.headline.estimatedGbp)}.`
  },
  {
    q: "How much of that can the public see?",
    a: `About £${capture.perHundredPounds} in every £100. The Home Office publishes a record of payments over £25,000, and for ${recon.fy} those come to ${formatGbpFull(recon.headline.publishedGbp)}.`
  },
  {
    q: "Is the rest of the money missing?",
    a: "No. It is accounted for to Parliament and to auditors in totals. What is not published is a line-by-line record of it. This is about what you are allowed to see, not about money going astray."
  },
  {
    q: "Which companies get the money?",
    a: `${entities.summary.entities} suppliers appear in the published data. The largest are ${topEntities.slice(0, 3).map((e) => e.name).join(", ")}.`
  }
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "Home Office asylum spending over £25,000, 2010 to 2026",
    description:
      "Every transaction over £25,000 that the Home Office recorded against an asylum " +
      "classification, normalised from its own published transparency files.",
    url: `${SITE_URL}/what-the-home-office-publishes`,
    temporalCoverage: "2010/2026",
    license: "https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/",
    isAccessibleForFree: true,
    creator: { "@id": `${SITE_URL}/#organization` },
    variableMeasured: "Payments over £25,000 by supplier and financial year",
    distribution: [
      {
        "@type": "DataDownload",
        encodingFormat: "application/json",
        contentUrl: `${SITE_URL}/data/ho-asylum-entities.json`
      }
    ]
  }
];
---

<BaseLayout title={title} description={description} structuredData={structuredData}>
  <article class="shell publishes">
    <!-- Layer 0. The answer, in one sentence, before anything else. -->
    <header class="lede">
      <h1>{title}</h1>
      <p class="answer">
        The Home Office spent <strong>{formatGbpShort(recon.headline.estimatedGbp)}</strong> on
        asylum in {recon.fy} — {perPersonInUk(recon.headline.estimatedGbp)}. It published a
        detailed record of <strong>{formatGbpShort(recon.headline.publishedGbp)}</strong> of it.
        That is about <strong>£{capture.perHundredPounds} in every £100</strong>.
      </p>
      <p class="updated">
        Last updated <time datetime={recon.generatedAt.slice(0, 10)}>
          {new Date(recon.generatedAt).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}
        </time>
      </p>
    </header>

    <!-- Layer 1. The proportion, and the caveat BEFORE the data, not after it. -->
    <section class="section">
      <ProportionGrid
        filled={capture.perHundredPounds}
        filledLabel={`£${capture.perHundredPounds} — a published receipt exists`}
        emptyLabel={`£${100 - capture.perHundredPounds} — spent and audited, but not itemised`}
        alt={`A grid of 100 squares. ${capture.perHundredPounds} are filled, showing the £${capture.perHundredPounds} in every £100 of asylum spending that appears in published data.`}
      />

      <PlainEnglish
        tone="alert"
        headline="This is not missing money"
        body="The Home Office does account for all of it — to Parliament, and to its auditors, in totals. What it does not do is publish a line-by-line record of most of it. This page is about what you are allowed to see, not about money going astray."
      />
    </section>

    <!-- Layer 2. Where it goes. -->
    <section class="section">
      <h2>Where the money goes</h2>
      <p class="intro">
        The National Audit Office published a breakdown of what was actually spent in {recon.fy}.
        Set against it, this is how much of each part has a published record.
      </p>

      <div class="table-scroll">
        <table>
          <caption class="visually-hidden">
            Asylum spending in {recon.fy} by component, comparing the National Audit Office
            estimate with the amount appearing in published transparency data.
          </caption>
          <thead>
            <tr>
              <th scope="col">What it pays for</th>
              <th scope="col" class="num">Spent</th>
              <th scope="col" class="num">Published</th>
            </tr>
          </thead>
          <tbody>
            {parents.map((component) => (
              <>
                <tr>
                  <th scope="row">
                    {component.plainLabel}
                    <span class="sub">{component.label}</span>
                  </th>
                  <td class="num">{formatGbpShort(component.estimatedGbp)}</td>
                  <td class="num">
                    {component.publishedGbp === null ? <span class="dash">not separable</span> : formatGbpShort(component.publishedGbp)}
                  </td>
                </tr>
                {childrenOf(component.componentId).map((child) => (
                  <tr class="child">
                    <th scope="row">{child.plainLabel}</th>
                    <td class="num">{formatGbpShort(child.estimatedGbp)}</td>
                    <td class="num">
                      {child.publishedGbp === null ? <span class="dash">not separable</span> : formatGbpShort(child.publishedGbp)}
                    </td>
                  </tr>
                ))}
              </>
            ))}
            <tr class="total">
              <th scope="row">{total.plainLabel}</th>
              <td class="num">{formatGbpShort(total.estimatedGbp)}</td>
              <td class="num">{formatGbpShort(recon.headline.publishedGbp)}</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="note">
        "Not separable" means that part cannot be picked out of the published file, not that
        it is zero. Spending figures: {total.sourceTitle}. {total.note}
      </p>

      <h3>The councils</h3>
      <p>
        The Home Office paid councils about{" "}
        <strong>{formatGbpShort(recon.councilTest.estimatedGbp)}</strong> in {recon.fy} — money for
        housing people, and for looking after children who arrive alone. Searching every
        supplier name in the published file for that year finds{" "}
        <strong>{formatGbpFull(recon.councilTest.publishedGbp)}</strong>.
      </p>
      <p class="note">
        Refugee Council is a charity, not a local authority. A search that counted it would
        return {formatGbpFull(recon.councilTest.publishedIncludingRefugeeCouncilGbp)}, more than
        double the right answer.
      </p>
    </section>

    <!-- Layer 3. How we know. -->
    <section class="section">
      <h2>How we know, and how to check it</h2>
      <p>
        Every figure in the "published" column comes from the Home Office's own
        <a href={entities.sourceCollection} rel="noreferrer">spending over £25,000</a> files —
        {entities.summary.filesParsed} of {entities.summary.filesInCorpus} published files,
        covering 2010 to 2026, holding {entities.summary.transactions.toLocaleString("en-GB")}{" "}
        asylum transactions worth {formatGbpShort(entities.summary.totalGbp)} across{" "}
        {entities.summary.entities} suppliers.
      </p>
      <p>
        The Home Office tags asylum in two separate fields, and both are used here: the
        directorate that spent the money, and the code for what it bought. Using only one
        misses about a third of it.
      </p>
      <p class="note">{entities.whatThisIsNot}</p>

      <h3>Biggest suppliers, all years</h3>
      <ol class="suppliers">
        {topEntities.map((entity) => (
          <li>
            <span class="s-name">{entity.name}</span>
            <span class="s-amount">{formatGbpShort(entity.amountGbp)}</span>
          </li>
        ))}
      </ol>
      <p class="note">
        Source data is Crown copyright, published under the Open Government Licence v3.0.
        Spending totals are reproduced from {total.sourceTitle}.
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .publishes { padding-block: 2rem 4rem; max-width: 46rem; }
  .lede { margin-bottom: 2.5rem; }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 4.5vw, 2.5rem);
    line-height: 1.15;
    text-wrap: balance;
    margin: 0 0 1rem;
  }
  .answer { font-size: 1.15rem; line-height: 1.6; margin: 0 0 0.75rem; }
  .updated { font-size: 0.85rem; color: var(--text-muted); margin: 0; }
  .section { margin-bottom: 3rem; }
  h2 {
    font-family: var(--font-display);
    font-size: 1.4rem;
    margin: 0 0 0.6rem;
    text-wrap: balance;
  }
  h3 { font-family: var(--font-display); font-size: 1.1rem; margin: 2rem 0 0.5rem; }
  .intro { color: var(--text-muted); margin-bottom: 1rem; }
  .note { font-size: 0.88rem; color: var(--text-muted); line-height: 1.55; }

  .table-scroll { overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius-sm); }
  table { border-collapse: collapse; width: 100%; font-size: 0.92rem; }
  th, td { text-align: left; padding: 0.6rem 0.85rem; border-bottom: 1px solid var(--border); }
  thead th {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    background: var(--bg-subtle);
    font-weight: 600;
  }
  tbody th { font-weight: 600; }
  .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .sub { display: block; font-size: 0.76rem; font-weight: 400; color: var(--text-muted); }
  .child th { padding-left: 1.9rem; font-weight: 400; color: var(--text-muted); }
  .total th, .total td { border-top: 1px solid var(--border-strong); font-weight: 600; background: var(--bg-subtle); }
  tbody tr:last-child td, tbody tr:last-child th { border-bottom: none; }
  .dash { color: var(--text-faint); font-variant-numeric: normal; }

  .suppliers { list-style: none; margin: 0.75rem 0 1rem; padding: 0; }
  .suppliers li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  .suppliers li:last-child { border-bottom: none; }
  .s-amount { font-variant-numeric: tabular-nums; color: var(--text-muted); white-space: nowrap; }

  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
