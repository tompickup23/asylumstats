---
import BaseLayout from "../layouts/BaseLayout.astro";
import CostTable from "../components/CostTable.astro";
import CostSources from "../components/CostSources.astro";
import ShareButton from "../components/ShareButton.astro";
import { buildAreaCostDataset, AREA_COST_CSV_PATH } from "../lib/area-cost-dataset";
import { getAllAreaCosts } from "../lib/area-cost";
const description = "Compare asylum support, annualised priced subtotals and relative burden across UK local authorities. See missing costs, hotel-rate scenarios and source dates.";
---
<BaseLayout title="Asylum costs by town" description={description} image="/og/cost.png" structuredData={[buildAreaCostDataset(description)]}>
  <section class="section" id="cost-overview">
    <p class="eyebrow">Home Office accommodation and support</p>
    <h1>Asylum costs by town</h1>
    <p class="lede">Compare {getAllAreaCosts().length} local authorities by people on support, the cost of priced components and their share relative to income taxpayers.</p>
    <p>The Home Office pays for asylum support from national funds. These figures show a year at the current count and published rates. They are not spending records or local taxpayer bills. Areas with unpriced accommodation cannot be ranked by complete cost.</p>
    <div class="cost-actions">
      <a class="cta-btn" href={AREA_COST_CSV_PATH} download>Download all inputs and results as CSV</a>
      <ShareButton url="https://asylumstats.co.uk/cost/" title="Asylum costs by town" text="Compare priced components, hotel-rate scenarios and relative burden. Every figure dated and sourced." />
    </div>
    <CostSources />
    <CostTable />
  </section>
</BaseLayout>
<style>
  h1 { font-family: var(--font-display); font-size: clamp(2.2rem, 5vw, 3.4rem); line-height: 1.1; margin: .5rem 0 1rem; }
  .eyebrow { font-size: .8rem; text-transform: uppercase; letter-spacing: .08em; color: var(--text-muted); }
  .cost-actions :global(.cta-btn) { display: inline-flex; align-items: center; gap: .4rem; min-height: 44px; padding: .6rem .9rem; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); background: var(--bg-card); color: var(--text); text-decoration: none; cursor: pointer; }
  .cost-actions { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; margin: 1.5rem 0; }</style>
